+// Rhénium : attentes de WaitForCodePage depuis le démarrage (nombre, durée
+// cumulée et plus longue en millisecondes), lues par la sonde.
+extern "C" void rhenium_wx_stats(uint32_t* waits, double* total_ms,
+                                 double* max_ms) {
+  LARGE_INTEGER frequency;
+  QueryPerformanceFrequency(&frequency);
+  double ms_per_tick = 1000.0 / static_cast<double>(frequency.QuadPart);
+  *waits = wx_waits.load(std::memory_order_relaxed);
+  *total_ms = wx_wait_ticks.load(std::memory_order_relaxed) * ms_per_tick;
+  *max_ms = wx_wait_max_ticks.load(std::memory_order_relaxed) * ms_per_tick;
+}
+
+// Rhénium : pages ouvertes en RW sur faute, écritures hors portée (qui
+// plantent) et adresse de la dernière.
+extern "C" void rhenium_wx_write_stats(uint32_t* faults, uint32_t* unscoped,
+                                       uintptr_t* last_unscoped_pc) {
+  *faults = wx_write_faults.load(std::memory_order_relaxed);
+  *unscoped = wx_unscoped_writes.load(std::memory_order_relaxed);
+  *last_unscoped_pc = wx_last_unscoped_pc.load(std::memory_order_relaxed);
+}
+
+void EnterJitWriteScope() { ++jit_write_pages.depth; }
+
+void ExitJitWriteScope() {
+  JitWritePages& t = jit_write_pages;
+  if (--t.depth > 0 || t.count == 0) return;
+  AcquireSRWLockExclusive(&page_writers_lock);
+  for (uint32_t i = 0; i < t.count; ++i) {
+    uint32_t page = t.pages[i];
+    if (page_writers[page] > 0 && --page_writers[page] > 0) continue;
+    uintptr_t address = uintptr_t{page} << kCodePageShift;
+    if (!IsCodePage(address)) continue;  // libérée entre-temps
+    ULONG old_protection;
+    VirtualProtectFromApp(reinterpret_cast<void*>(address), kCodePageSize,
+                          PAGE_EXECUTE_READ, &old_protection);
+  }
+  t.count = 0;
+  ReleaseSRWLockExclusive(&page_writers_lock);
+}
