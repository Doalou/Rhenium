+// Rhénium : dossiers de l'app UWP, lus dans Windows.Storage.ApplicationData.
+bool GetAppDataFolder(bool roaming, FilePath* result) {
+  using ABI::Windows::Storage::IApplicationData;
+  using ABI::Windows::Storage::IApplicationDataStatics;
+  using ABI::Windows::Storage::IStorageFolder;
+  using ABI::Windows::Storage::IStorageItem;
+  using Microsoft::WRL::ComPtr;
+
+  ComPtr<IApplicationDataStatics> statics;
+  HRESULT hr = win::GetActivationFactory<
+      IApplicationDataStatics, RuntimeClass_Windows_Storage_ApplicationData>(
+      &statics);
+  ComPtr<IApplicationData> data;
+  if (SUCCEEDED(hr))
+    hr = statics->get_Current(&data);
+  ComPtr<IStorageFolder> folder;
+  if (SUCCEEDED(hr)) {
+    hr = roaming ? data->get_RoamingFolder(&folder)
+                 : data->get_LocalFolder(&folder);
+  }
+  ComPtr<IStorageItem> item;
+  if (SUCCEEDED(hr))
+    hr = folder.As(&item);
+  HSTRING path = nullptr;
+  if (SUCCEEDED(hr))
+    hr = item->get_Path(&path);
+  if (FAILED(hr))
+    return false;
+  win::ScopedHString scoped_path(path);
+  *result = FilePath(scoped_path.Get());
+  return true;
+}
+
+}  // namespace
+
+// Rhénium : une app UWP n'a accès ni aux dossiers du shell ni à ceux des
+// autres utilisateurs ; seuls l'exécutable, le système et ses propres
+// dossiers de données ont un sens.
+bool PathProviderWin(int key, FilePath* result) {
+  wchar_t system_buffer[MAX_PATH];
+  system_buffer[0] = 0;
+
+  switch (key) {
+    case base::FILE_EXE:
+      if (GetModuleFileName(NULL, system_buffer, MAX_PATH) == 0)
+        return false;
+      break;
+    case base::FILE_MODULE:
+      if (GetModuleFileName(CURRENT_MODULE(), system_buffer, MAX_PATH) == 0)
+        return false;
+      break;
+    case base::DIR_WINDOWS:
+      GetWindowsDirectory(system_buffer, MAX_PATH);
+      break;
+    case base::DIR_SYSTEM:
+      GetSystemDirectory(system_buffer, MAX_PATH);
+      break;
+    case base::DIR_LOCAL_APP_DATA:
+    case base::DIR_COMMON_APP_DATA:
+      return GetAppDataFolder(false, result);
+    case base::DIR_ROAMING_APP_DATA:
+      return GetAppDataFolder(true, result);
+    case base::DIR_SRC_TEST_DATA_ROOT: {
+      // Sinon PathProvider tombe sur son NOTREACHED().
+      FilePath exe_dir;
+      if (!PathService::Get(base::DIR_EXE, &exe_dir))
+        return false;
+      *result = exe_dir.DirName().DirName();
+      return true;
+    }
+    default:
+      return false;
+  }
+
+  *result = FilePath(system_buffer);
+  return true;
+}
+
