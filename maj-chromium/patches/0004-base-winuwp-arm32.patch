+
+#include "base/logging.h"
+#include "base/process/kill.h"
+
+namespace base {
+
+void RouteStdioToConsole(bool create_console_if_not_found) {}
+
+Process LaunchProcess(const CommandLine& cmdline,
+                      const LaunchOptions& options) {
+  return LaunchProcess(cmdline.GetCommandLineString(), options);
+}
+
+Process LaunchProcess(const CommandLine::StringType& cmdline,
+                      const LaunchOptions& options) {
+  LOG(ERROR) << "LaunchProcess indisponible sous UWP : " << cmdline;
+  return Process();
+}
+
+bool SetJobObjectLimitFlags(HANDLE job_object, DWORD limit_flags) {
+  return false;
+}
+
+bool GetAppOutput(const CommandLine& cl, std::string* output) {
+  return false;
+}
+
+bool GetAppOutputAndError(const CommandLine& cl, std::string* output) {
+  return false;
+}
+
+bool GetAppOutputWithExitCode(const CommandLine& cl,
+                              std::string* output,
+                              int* exit_code) {
+  return false;
+}
+
+// Rhénium : StringPieceType est devenu StringViewType en 156.
+bool GetAppOutput(CommandLine::StringViewType cl, std::string* output) {
+  return false;
+}
+
+// Rhénium : nouveau en 156 (déclaré dans launch.h pour Windows).
+bool GetAppOutputWithExitCodeAndTimeout(
+    CommandLine::StringViewType cl,
+    bool include_stderr,
+    std::string* output,
+    int* exit_code,
+    TimeDelta timeout,
+    const LaunchOptions& options,
+    FunctionRef<void(const Process&, std::string_view)> still_waiting,
+    TerminationStatus* final_status) {
+  if (final_status) {
+    *final_status = TERMINATION_STATUS_LAUNCH_FAILED;
+  }
+  return false;
+}
+
+void RaiseProcessToHighPriority() {}
+
+}  // namespace base
