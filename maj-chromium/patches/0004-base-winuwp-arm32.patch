+// Partagé entre la pompe et ses rappels en attente, qui peuvent survivre à la
+// pompe : pump est remis à nul à sa destruction (sur le thread UI, comme les
+// rappels du CoreDispatcher).
+class MessagePumpForUI::Core : public RefCountedThreadSafe<Core> {
+ public:
+  Core(ComPtr<ICoreDispatcher> dispatcher,
+       ComPtr<IThreadPoolTimerStatics> timer_statics,
+       MessagePumpForUI* pump)
+      : dispatcher(std::move(dispatcher)),
+        timer_statics(std::move(timer_statics)),
+        pump(pump) {}
+
+  // N'importe quel thread : demande HandleWork (kWork) ou HandleTimer(n) sur le
+  // thread UI.
+  HRESULT RunOnUiThread(int what) {
+    scoped_refptr<Core> self(this);
+    auto handler =
+        Callback<AgileCallback<IDispatchedHandler>>([self, what]() -> HRESULT {
+          self->Dispatch(what);
+          return S_OK;
+        });
+    if (!handler)
+      return E_OUTOFMEMORY;
+    ComPtr<IAsyncAction> action;
+    return dispatcher->RunAsync(
+        ABI::Windows::UI::Core::CoreDispatcherPriority_Normal, handler.Get(),
+        &action);
+  }
+
+  void Dispatch(int what) {
+    if (!pump)
+      return;
+    if (what == kWork) {
+      work_scheduled.store(false);
+      pump->HandleWork();
+    } else {
+      pump->HandleTimer(what);
+    }
+  }
+
+  const ComPtr<ICoreDispatcher> dispatcher;
+  const ComPtr<IThreadPoolTimerStatics> timer_statics;
+  std::atomic<bool> work_scheduled{false};
+
+  // Thread UI seulement.
+  raw_ptr<MessagePumpForUI> pump;
+  ComPtr<IThreadPoolTimer> timer;
+
+ private:
+  friend class RefCountedThreadSafe<Core>;
+  ~Core() = default;
+};
+
+MessagePumpForUI::MessagePumpForUI() {
+  ComPtr<ICoreWindowStatic> window_statics;
+  HRESULT hr = win::GetActivationFactory<
+      ICoreWindowStatic, RuntimeClass_Windows_UI_Core_CoreWindow>(
+      &window_statics);
+  ComPtr<ICoreWindow> window;
+  if (SUCCEEDED(hr))
+    hr = window_statics->GetForCurrentThread(&window);
+  if (FAILED(hr) || !window) {
+    fallback_ = std::make_unique<MessagePumpDefault>();
+    return;
+  }
+  ComPtr<ICoreDispatcher> dispatcher;
+  hr = window->get_Dispatcher(&dispatcher);
+  CHECK(SUCCEEDED(hr) && dispatcher);
+  ComPtr<IThreadPoolTimerStatics> timer_statics;
+  hr = win::GetActivationFactory<
+      IThreadPoolTimerStatics,
+      RuntimeClass_Windows_System_Threading_ThreadPoolTimer>(&timer_statics);
+  CHECK(SUCCEEDED(hr) && timer_statics);
+  core_ = MakeRefCounted<Core>(std::move(dispatcher), std::move(timer_statics),
+                               this);
+}
+
+MessagePumpForUI::~MessagePumpForUI() {
+  DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+  if (fallback_)
+    return;
+  CancelTimer();
+  core_->pump = nullptr;
+}
+
+void MessagePumpForUI::Run(Delegate* delegate) {
+  DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+  if (fallback_) {
+    fallback_->Run(delegate);
+    return;
+  }
+  RunState state;
+  run_states_.push_back(&state);
+  Delegate* const previous_delegate = delegate_;
+  delegate_ = delegate;
+
+  ScheduleWork();
+  while (!state.should_quit) {
+    const HRESULT hr = core_->dispatcher->ProcessEvents(
+        ABI::Windows::UI::Core::CoreProcessEventsOption_ProcessOneAndAllPending);
+    if (FAILED(hr)) {
+      LOG(ERROR) << "CoreDispatcher::ProcessEvents : " << std::hex << hr;
+      break;
+    }
+  }
+
+  run_states_.pop_back();
+  delegate_ = previous_delegate;
+  // La boucle extérieure (Attach ou Run) reprend son travail.
+  if (delegate_)
+    ScheduleWork();
+}
+
+void MessagePumpForUI::Quit() {
+  DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+  if (fallback_) {
+    fallback_->Quit();
+    return;
+  }
+  if (!run_states_.empty()) {
+    run_states_.back()->should_quit = true;
+    ScheduleWork();  // réveille ProcessEvents
+    return;
+  }
+  if (attached_run_loop_ && !attached_quit_) {
+    attached_quit_ = true;
+    CancelTimer();
+    attached_run_loop_->AfterRun();
+    attached_run_loop_.reset();
+  }
+}
+
+void MessagePumpForUI::Attach(Delegate* delegate) {
+  DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+  // Sans CoreWindow, personne d'autre ne fait tourner la boucle : Run() s'en
+  // charge.
+  if (fallback_)
+    return;
+  DCHECK(!attached_run_loop_);
+  delegate_ = delegate;
+  attached_quit_ = false;
+  attached_run_loop_ = std::make_unique<RunLoop>();
+  CHECK(attached_run_loop_->BeforeRun());
+  ScheduleWork();
+}
+
+void MessagePumpForUI::ScheduleWork() {
+  if (fallback_) {
+    fallback_->ScheduleWork();
+    return;
+  }
+  if (core_->work_scheduled.exchange(true))
+    return;
+  if (FAILED(core_->RunOnUiThread(kWork)))
+    core_->work_scheduled.store(false);
+}
+
+void MessagePumpForUI::ScheduleDelayedWork(
+    const Delegate::NextWorkInfo& next_work_info) {
+  DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+  if (fallback_) {
+    fallback_->ScheduleDelayedWork(next_work_info);
+    return;
+  }
+  const TimeTicks run_time = next_work_info.delayed_run_time;
+  if (run_time.is_max()) {
+    CancelTimer();
+    return;
+  }
+  if (core_->timer && run_time == timer_run_time_)
+    return;
+  CancelTimer();
+
+  const TimeDelta delay = run_time - TimeTicks::Now();
+  if (delay <= TimeDelta()) {
+    ScheduleWork();
+    return;
+  }
+  timer_run_time_ = run_time;
+  const int generation = ++timer_generation_;
+  scoped_refptr<Core> core = core_;
+  auto handler = Callback<AgileCallback<ITimerElapsedHandler>>(
+      [core, generation](IThreadPoolTimer*) -> HRESULT {
+        core->RunOnUiThread(generation);
+        return S_OK;
+      });
+  // Arrondi à la milliseconde supérieure : un réveil en avance ne ferait que
+  // reprogrammer le minuteur.
+  ABI::Windows::Foundation::TimeSpan span;
+  span.Duration = delay.InMillisecondsRoundedUp() * 10000;
+  HRESULT hr = handler ? core_->timer_statics->CreateTimer(handler.Get(), span,
+                                                           &core_->timer)
+                       : E_OUTOFMEMORY;
+  if (FAILED(hr)) {
+    LOG(ERROR) << "ThreadPoolTimer::CreateTimer : " << std::hex << hr;
+    timer_run_time_ = TimeTicks();
+    ScheduleWork();
+  }
+}
+
+void MessagePumpForUI::HandleWork() {
+  DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+  if (!delegate_)
+    return;
+  if (run_states_.empty() ? !attached_run_loop_
+                          : run_states_.back()->should_quit) {
+    return;
+  }
+
+  // Une passe de travail, puis la main revient au CoreDispatcher pour que les
+  // entrées et le rendu XAML s'intercalent.
+  Delegate::NextWorkInfo next_work_info = delegate_->DoWork();
+  if (next_work_info.is_immediate()) {
+    ScheduleWork();
+    return;
+  }
+  // Rhénium : en 156, DoIdleWork() ne renvoie plus de booléen ; le travail qu'il
+  // pose réveille la pompe par ScheduleWork() (comme sur Android).
+  delegate_->DoIdleWork();
+  delegate_->BeforeWait();
+  ScheduleDelayedWork(next_work_info);
+}
+
+void MessagePumpForUI::HandleTimer(int timer_generation) {
+  DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+  if (timer_generation != timer_generation_)
+    return;  // minuteur annulé ou remplacé entre-temps
+  core_->timer.Reset();
+  timer_run_time_ = TimeTicks();
+  HandleWork();
+}
+
+void MessagePumpForUI::CancelTimer() {
+  if (core_->timer) {
+    core_->timer->Cancel();
+    core_->timer.Reset();
+  }
+  timer_run_time_ = TimeTicks();
+  ++timer_generation_;
+}
+
+}  // namespace base
