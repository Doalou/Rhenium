+class RheniumContentRendererClient : public content::ShellContentRendererClient {
+ public:
+  RheniumContentRendererClient()
+      : content::ShellContentRendererClient(/*is_browsertest=*/false) {}
+
+  void RenderThreadStarted() override {
+    content::ShellContentRendererClient::RenderThreadStarted();
+    SetExtensionsClientOnce();
+    extensions_renderer_client_ =
+        std::make_unique<RheniumExtensionsRendererClient>();
+    extensions::ExtensionsRendererClient::Set(
+        extensions_renderer_client_.get());
+    extensions_renderer_client_->AddAPIProvider(
+        std::make_unique<extensions::CoreExtensionsRendererAPIProvider>());
+    extensions_renderer_client_->RenderThreadStarted();
+    blink::WebSecurityPolicy::RegisterURLSchemeAsExtension(
+        blink::WebString::FromAscii(extensions::kExtensionScheme));
+  }
+
+  // Comme ChromeContentRendererClient : l'injection des scripts de contenu
+  // lit l'origine la plus externe de la vue (ExtensionInjectionHost) et
+  // plantait sans cet assistant. ExtensionWebViewHelper se détruit avec la vue.
+  void WebViewCreated(blink::WebView* web_view,
+                      bool was_created_by_renderer,
+                      const url::Origin* outermost_origin) override {
+    content::ShellContentRendererClient::WebViewCreated(
+        web_view, was_created_by_renderer, outermost_origin);
+    extensions_renderer_client_->WebViewCreated(web_view, outermost_origin);
+  }
+
+  void RenderFrameCreated(content::RenderFrame* render_frame) override {
+    content::ShellContentRendererClient::RenderFrameCreated(render_frame);
+    // ExtensionFrameHelper se détruit avec le RenderFrame.
+    new extensions::ExtensionFrameHelper(render_frame, dispatcher());
+    dispatcher()->OnRenderFrameCreated(render_frame);
+  }
+
+  void RunScriptsAtDocumentStart(content::RenderFrame* render_frame) override {
+    extensions_renderer_client_->RunScriptsAtDocumentStart(render_frame);
+  }
+  void RunScriptsAtDocumentEnd(content::RenderFrame* render_frame) override {
+    extensions_renderer_client_->RunScriptsAtDocumentEnd(render_frame);
+  }
+  void RunScriptsAtDocumentIdle(content::RenderFrame* render_frame) override {
+    extensions_renderer_client_->RunScriptsAtDocumentIdle(render_frame);
+  }
+
+  void DidInitializeServiceWorkerContextOnWorkerThread(
+      blink::WebServiceWorkerContextProxy* context_proxy,
+      const GURL& service_worker_scope,
+      const GURL& script_url) override {
+    dispatcher()->DidInitializeServiceWorkerContextOnWorkerThread(
+        context_proxy, service_worker_scope, script_url);
+  }
+  void WillEvaluateServiceWorkerOnWorkerThread(
+      blink::WebServiceWorkerContextProxy* context_proxy,
+      v8::Local<v8::Context> v8_context,
+      int64_t service_worker_version_id,
+      const GURL& service_worker_scope,
+      const GURL& script_url,
+      const blink::ServiceWorkerToken& service_worker_token) override {
+    dispatcher()->WillEvaluateServiceWorkerOnWorkerThread(
+        context_proxy, v8_context, service_worker_version_id,
+        service_worker_scope, script_url, service_worker_token);
+  }
+  void DidStartServiceWorkerContextOnWorkerThread(
+      int64_t service_worker_version_id,
+      const GURL& service_worker_scope,
+      const GURL& script_url,
+      const blink::ServiceWorkerToken& service_worker_token) override {
+    dispatcher()->DidStartServiceWorkerContextOnWorkerThread(
+        service_worker_version_id, service_worker_scope, script_url,
+        service_worker_token);
+  }
+  void WillDestroyServiceWorkerContextOnWorkerThread(
+      v8::Local<v8::Context> context,
+      int64_t service_worker_version_id,
+      const GURL& service_worker_scope,
+      const GURL& script_url,
+      const blink::ServiceWorkerToken& service_worker_token) override {
+    dispatcher()->WillDestroyServiceWorkerContextOnWorkerThread(
+        context, service_worker_version_id, service_worker_scope, script_url,
+        service_worker_token);
+  }
+
+ private:
+  extensions::Dispatcher* dispatcher() {
+    return extensions_renderer_client_->dispatcher();
+  }
+
+  std::unique_ptr<RheniumExtensionsRendererClient> extensions_renderer_client_;
+};
+
+// Le schéma chrome-extension:// comme dans Chrome (ChromeContentClient) :
+// app_shell n'y autorise pas les service workers.
+class RheniumContentClient : public content::ShellContentClient {
+ public:
+  void AddAdditionalSchemes(Schemes* schemes) override {
+    content::ShellContentClient::AddAdditionalSchemes(schemes);
+    schemes->standard_schemes.push_back(extensions::kExtensionScheme);
+    schemes->extension_schemes.push_back(extensions::kExtensionScheme);
+    schemes->savable_schemes.push_back(extensions::kExtensionScheme);
+    schemes->secure_schemes.push_back(extensions::kExtensionScheme);
+    schemes->service_worker_schemes.push_back(extensions::kExtensionScheme);
+    schemes->cors_enabled_schemes.push_back(extensions::kExtensionScheme);
+    schemes->csp_bypassing_schemes.push_back(extensions::kExtensionScheme);
+  }
+};
+
+}  // namespace
+
+RheniumMainDelegate::RheniumMainDelegate()
+    : content::ShellMainDelegate(/*is_content_browsertests=*/false) {}
+
+RheniumMainDelegate::~RheniumMainDelegate() = default;
+
+// Ressources des extensions (liaisons JS, schémas, chaînes) à côté de
+// content_shell.pak.
+void RheniumMainDelegate::PreSandboxStartup() {
+  content::ShellMainDelegate::PreSandboxStartup();
+  base::FilePath pak;
+  base::PathService::Get(base::DIR_ASSETS, &pak);
+  ui::ResourceBundle::GetSharedInstance().AddDataPackFromPath(
+      pak.AppendASCII("rhenium_extensions.pak"), ui::k100Percent);
+}
+
+content::ContentClient* RheniumMainDelegate::CreateContentClient() {
+  content_client_ = std::make_unique<RheniumContentClient>();
+  return content_client_.get();
+}
+
+content::ContentBrowserClient*
+RheniumMainDelegate::CreateContentBrowserClient() {
+  browser_client_ = std::make_unique<RheniumContentBrowserClient>();
+  return browser_client_.get();
+}
+
+content::ContentRendererClient*
+RheniumMainDelegate::CreateContentRendererClient() {
+  renderer_client_ = std::make_unique<RheniumContentRendererClient>();
+  return renderer_client_.get();
+}
+
+}  // namespace rhenium
