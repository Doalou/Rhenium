new file mode 100644
index 0000000000..1062277604
--- /dev/null
+++ b/extensions/rhenium/rhenium_downloads.cc
@@ -0,0 +1,140 @@
+// Copyright 2026 Doalo
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "extensions/rhenium/rhenium_downloads.h"
+
+#include <map>
+
+#include "base/files/file_path.h"
+#include "base/logging.h"
+#include "base/memory/raw_ptr.h"
+#include "base/no_destructor.h"
+#include "base/time/time.h"
+#include "components/download/public/common/download_interrupt_reasons.h"
+#include "components/download/public/common/download_item.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/download_manager.h"
+
+namespace rhenium {
+
+namespace {
+
+constexpr base::TimeDelta kProgressInterval = base::Milliseconds(250);
+
+DownloadObserver& ShellObserver() {
+  static DownloadObserver observer;
+  return observer;
+}
+
+int StateOf(const download::DownloadItem& item) {
+  switch (item.GetState()) {
+    case download::DownloadItem::COMPLETE:
+      return kDownloadComplete;
+    case download::DownloadItem::CANCELLED:
+    case download::DownloadItem::INTERRUPTED:
+      return kDownloadFailed;
+    default:
+      return kDownloadInProgress;
+  }
+}
+
+class Watcher : public content::DownloadManager::Observer,
+                public download::DownloadItem::Observer {
+ public:
+  void Watch(content::DownloadManager* manager) {
+    manager_ = manager;
+    manager->AddObserver(this);
+  }
+
+  void Cancel(int id) {
+    if (!manager_)
+      return;
+    if (download::DownloadItem* item = manager_->GetDownload(id))
+      item->Cancel(/*user_cancel=*/true);
+  }
+
+  // content::DownloadManager::Observer
+  void OnDownloadCreated(content::DownloadManager*,
+                         download::DownloadItem* item) override {
+    item->AddObserver(this);
+    Report(item);
+  }
+
+  void ManagerGoingDown(content::DownloadManager* manager) override {
+    manager->RemoveObserver(this);
+    manager_ = nullptr;
+  }
+
+  // download::DownloadItem::Observer
+  void OnDownloadUpdated(download::DownloadItem* item) override {
+    Report(item);
+  }
+
+  void OnDownloadDestroyed(download::DownloadItem* item) override {
+    item->RemoveObserver(this);
+    reported_.erase(item->GetId());
+  }
+
+ private:
+  struct Reported {
+    int state;
+    bool named;
+    base::TimeTicks time;
+  };
+
+  // Chaque changement d'état ou de nom ; l'avancement, par intervalles.
+  void Report(download::DownloadItem* item) {
+    const int state = StateOf(*item);
+    const base::FilePath target = item->GetTargetFilePath();
+    const bool named = !target.empty();
+    const base::TimeTicks now = base::TimeTicks::Now();
+    auto it = reported_.find(item->GetId());
+    if (it != reported_.end() && it->second.state == state &&
+        it->second.named == named &&
+        (state != kDownloadInProgress ||
+         now - it->second.time < kProgressInterval)) {
+      return;
+    }
+    reported_[item->GetId()] = {state, named, now};
+    if (state == kDownloadFailed) {
+      LOG(WARNING) << "Rhenium : téléchargement interrompu, "
+                   << download::DownloadInterruptReasonToString(
+                          item->GetLastReason());
+    }
+    DownloadObserver& observer = ShellObserver();
+    if (!observer.download_changed)
+      return;
+    observer.download_changed(
+        observer.context, static_cast<int>(item->GetId()), state,
+        item->GetReceivedBytes(), item->GetTotalBytes() > 0
+                                      ? item->GetTotalBytes()
+                                      : -1,
+        target.BaseName().value().c_str(),
+        state == kDownloadComplete ? target.value().c_str() : L"");
+  }
+
+  raw_ptr<content::DownloadManager> manager_ = nullptr;
+  std::map<uint32_t, Reported> reported_;
+};
+
+Watcher& GetWatcher() {
+  static base::NoDestructor<Watcher> watcher;
+  return *watcher;
+}
+
+}  // namespace
+
+void InitDownloads(const DownloadObserver& observer) {
+  ShellObserver() = observer;
+}
+
+void WatchDownloads(content::BrowserContext* context) {
+  GetWatcher().Watch(context->GetDownloadManager());
+}
+
+void CancelDownload(int id) {
+  GetWatcher().Cancel(id);
+}
+
+}  // namespace rhenium
