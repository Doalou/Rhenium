+
+#ifndef EXTENSIONS_RHENIUM_RHENIUM_EXTENSION_MANAGER_H_
+#define EXTENSIONS_RHENIUM_RHENIUM_EXTENSION_MANAGER_H_
+
+#include <string>
+
+class GURL;
+
+namespace content {
+class BrowserContext;
+}
+
+// Rhénium : gestion des extensions pour la coquille (liste, activation,
+// suppression, pages) et installation depuis le Chrome Web Store : le .crx est
+// téléchargé comme le fait Chrome, sa preuve d'éditeur du Web Store vérifiée,
+// puis il est décompressé dans le profil (RheniumExtensionSystem). Tout sur le
+// thread UI.
+namespace rhenium {
+
+struct ExtensionObserver {
+  void* context = nullptr;
+  // Fin d'une installation : nom de l'extension, ou raison de l'échec.
+  void (*install_done)(void* context, bool ok, const wchar_t* text) = nullptr;
+};
+
+// Avant ContentMain.
+void InitExtensions(const ExtensionObserver& observer);
+// Contexte des extensions, une fois le système d'extensions prêt.
+void SetExtensionContext(content::BrowserContext* context);
+
+// Parcourt les extensions installées, celles du paquet d'abord ; les chaînes
+// valent pendant l'appel.
+void ForEachExtension(void (*visit)(void* context,
+                                    const char* id,
+                                    const wchar_t* name,
+                                    const wchar_t* version,
+                                    int enabled,
+                                    int removable,
+                                    int has_popup,
+                                    int has_options),
+                      void* context);
+bool SetExtensionEnabled(const std::string& id, bool enabled);
+// Faux pour une extension du paquet.
+bool UninstallExtension(const std::string& id);
+// Popup de l'action ou page d'options de l'extension, par-dessus l'onglet.
+bool OpenExtensionPopup(const std::string& id);
+bool OpenExtensionOptions(const std::string& id);
+
+// Identifiant de l'extension dont `url` est la page sur le Chrome Web Store,
+// sinon chaîne vide.
+std::string WebStoreExtensionId(const GURL& url);
+// Lance l'installation (résultat par install_done). Faux si une autre est en
+// cours, si l'identifiant est invalide ou si l'extension est déjà installée
+// (install_done l'a alors signalé).
+bool InstallFromWebStore(const std::string& id);
+
+}  // namespace rhenium
+
+#endif  // EXTENSIONS_RHENIUM_RHENIUM_EXTENSION_MANAGER_H_
