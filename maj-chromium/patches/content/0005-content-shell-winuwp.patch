+
+[
+  {
+    "namespace": "action",
+    "description": "Bouton d'extension de la barre de Rhénium.",
+    "functions": [
+      {
+        "name": "setIcon",
+        "type": "function",
+        "parameters": [
+          {
+            "name": "details",
+            "type": "object",
+            "properties": {
+              "imageData": {"type": "any", "optional": true},
+              "path": {"type": "any", "optional": true},
+              "tabId": {"type": "integer", "optional": true}
+            }
+          }
+        ],
+        "returns_async": {"name": "callback", "optional": true, "parameters": []}
+      },
+      {
+        "name": "setTitle",
+        "type": "function",
+        "parameters": [
+          {
+            "name": "details",
+            "type": "object",
+            "properties": {
+              "title": {"type": "string"},
+              "tabId": {"type": "integer", "optional": true}
+            }
+          }
+        ],
+        "returns_async": {"name": "callback", "optional": true, "parameters": []}
+      },
+      {
+        "name": "setBadgeText",
+        "type": "function",
+        "parameters": [
+          {
+            "name": "details",
+            "type": "object",
+            "properties": {
+              "text": {"type": "string", "optional": true},
+              "tabId": {"type": "integer", "optional": true}
+            }
+          }
+        ],
+        "returns_async": {"name": "callback", "optional": true, "parameters": []}
+      },
+      {
+        "name": "getBadgeText",
+        "type": "function",
+        "parameters": [
+          {
+            "name": "details",
+            "type": "object",
+            "properties": {
+              "tabId": {"type": "integer", "optional": true}
+            }
+          }
+        ],
+        "returns_async": {
+          "name": "callback",
+          "parameters": [{"name": "result", "type": "string"}]
+        }
+      },
+      {
+        "name": "setBadgeBackgroundColor",
+        "type": "function",
+        "parameters": [
+          {
+            "name": "details",
+            "type": "object",
+            "properties": {
+              "color": {"type": "any"},
+              "tabId": {"type": "integer", "optional": true}
+            }
+          }
+        ],
+        "returns_async": {"name": "callback", "optional": true, "parameters": []}
+      }
+    ]
+  }
+]
