+// Langue d'affichage du téléphone (i18n des extensions,
+// chrome.i18n.getUILanguage), la première de ses langues préférées.
+// Langue choisie dans les paramètres, sinon celle du téléphone.
+std::string RheniumExtensionsBrowserClient::GetApplicationLocale() {
+  const std::string chosen =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          "rhenium-language");
+  if (!chosen.empty())
+    return chosen;
+  ULONG count = 0;
+  wchar_t languages[256] = {};
+  ULONG size = std::size(languages);
+  if (GetUserPreferredUILanguages(MUI_LANGUAGE_NAME, &count, languages,
+                                  &size) &&
+      languages[0]) {
+    return base::WideToASCII(languages);
+  }
+  return "en-US";
+}
