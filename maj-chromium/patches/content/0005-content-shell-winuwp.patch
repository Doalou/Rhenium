+namespace extensions {
+
+namespace {
+
+// Pas d'invite de permissions : aucun message à afficher.
+class RheniumPermissionMessageProvider : public PermissionMessageProvider {
+ public:
+  PermissionMessages GetPermissionMessages(
+      const PermissionIDSet& permissions) const override {
+    return PermissionMessages();
+  }
+  bool IsPrivilegeIncrease(const PermissionSet& granted_permissions,
+                           const PermissionSet& requested_permissions,
+                           Manifest::Type extension_type) const override {
+    return false;
+  }
+  PermissionIDSet GetAllPermissionIDs(
+      const PermissionSet& permissions,
+      Manifest::Type extension_type) const override {
+    return PermissionIDSet();
+  }
+};
+
+constexpr APIPermissionInfo::InitInfo kRheniumPermissions[] = {
+    {mojom::APIPermissionID::kScripting, "scripting"},
+};
+
+class RheniumExtensionsAPIProvider : public ExtensionsAPIProvider {
+ public:
+  void AddAPIFeatures(FeatureProvider* provider) override {
+    AddRheniumAPIFeatures(provider);
+  }
+  void AddManifestFeatures(FeatureProvider* provider) override {}
+  void AddPermissionFeatures(FeatureProvider* provider) override {
+    AddRheniumPermissionFeatures(provider);
+  }
+  void AddBehaviorFeatures(FeatureProvider* provider) override {}
+  void AddAPIJSONSources(JSONFeatureProviderSource* json_source) override {}
+  bool IsAPISchemaGenerated(const std::string& name) override {
+    return api::RheniumGeneratedSchemas::IsGenerated(name);
+  }
+  std::string_view GetAPISchema(const std::string& name) override {
+    return api::RheniumGeneratedSchemas::Get(name);
+  }
+  void RegisterPermissions(PermissionsInfo* permissions_info) override {
+    permissions_info->RegisterPermissions(kRheniumPermissions, {});
+  }
+  // Rhénium : la page d'options (OptionsPageHandler) est enregistrée par les
+  // gestionnaires communs ; rien d'autre à ajouter.
+  void RegisterManifestHandlers(ManifestHandlerRegistry* registry) override {}
+};
+
+}  // namespace
+
+RheniumExtensionsClient::RheniumExtensionsClient()
+    : webstore_base_url_(extension_urls::kChromeWebstoreBaseURL),
+      new_webstore_base_url_(extension_urls::kNewChromeWebstoreBaseURL),
+      webstore_update_url_(extension_urls::kChromeWebstoreUpdateURL) {
+  AddAPIProvider(std::make_unique<CoreExtensionsAPIProvider>());
+  AddAPIProvider(std::make_unique<RheniumExtensionsAPIProvider>());
+}
+
+RheniumExtensionsClient::~RheniumExtensionsClient() = default;
+
+void RheniumExtensionsClient::Initialize() {}
+
+void RheniumExtensionsClient::InitializeWebStoreUrls(
+    base::CommandLine* command_line) {}
+
+const PermissionMessageProvider&
+RheniumExtensionsClient::GetPermissionMessageProvider() const {
+  static base::NoDestructor<RheniumPermissionMessageProvider> provider;
+  return *provider;
+}
+
+const std::string RheniumExtensionsClient::GetProductName() {
+  return "Rhenium";
+}
+
+void RheniumExtensionsClient::FilterHostPermissions(
+    const URLPatternSet& hosts,
+    URLPatternSet* new_hosts,
+    PermissionIDSet* permissions) const {}
+
+void RheniumExtensionsClient::SetScriptingAllowlist(
+    const ScriptingAllowlist& allowlist) {
+  scripting_allowlist_ = allowlist;
+}
+
+const ExtensionsClient::ScriptingAllowlist&
+RheniumExtensionsClient::GetScriptingAllowlist() const {
+  return scripting_allowlist_;
+}
+
+URLPatternSet RheniumExtensionsClient::GetPermittedChromeSchemeHosts(
+    const Extension* extension,
+    const APIPermissionSet& api_permissions) const {
+  return URLPatternSet();
+}
+
+bool RheniumExtensionsClient::IsScriptableURL(const GURL& url,
+                                              std::string* error) const {
+  return true;
+}
+
+const GURL& RheniumExtensionsClient::GetWebstoreBaseURL() const {
+  return webstore_base_url_;
+}
+
+const GURL& RheniumExtensionsClient::GetNewWebstoreBaseURL() const {
+  return new_webstore_base_url_;
+}
+
+const GURL& RheniumExtensionsClient::GetWebstoreUpdateURL() const {
+  return webstore_update_url_;
+}
+
+bool RheniumExtensionsClient::IsBlocklistUpdateURL(const GURL& url) const {
+  return false;
+}
+
+}  // namespace extensions
