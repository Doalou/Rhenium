+}
+
+// Rien ne recharge d'extension : runtime.reload() n'est pas pris en charge.
+void RheniumExtensionSystem::LoadExtensionForReload(
+    const ExtensionId& extension_id,
+    const base::FilePath& path) {}
+
+void RheniumExtensionSystem::LoadExtensionForReloadWithQuietFailure(
