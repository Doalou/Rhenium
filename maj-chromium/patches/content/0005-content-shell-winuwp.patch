+// found in the LICENSE file.
+
+#ifndef COMPONENTS_VIZ_SERVICE_DISPLAY_EMBEDDER_SOFTWARE_OUTPUT_DEVICE_UWP_H_
+#define COMPONENTS_VIZ_SERVICE_DISPLAY_EMBEDDER_SOFTWARE_OUTPUT_DEVICE_UWP_H_
+
+#include <d3d11.h>
+#include <dxgi1_3.h>
+#include <wrl/client.h>
+
+#include "base/time/time.h"
+#include "components/viz/service/display/software_output_device.h"
+#include "components/viz/service/viz_service_export.h"
+
+namespace viz {
+
+// Rhénium : compositing logiciel d'une app UWP. Skia dessine dans le bitmap
+// de SoftwareOutputDevice ; à la fin de chaque image, il est copié dans le
+// tampon arrière d'une swap chain D3D11 créée sur la CoreWindow
+// (ui/gfx/win/uwp_core_window.h), puis présenté.
+class VIZ_SERVICE_EXPORT SoftwareOutputDeviceUwp : public SoftwareOutputDevice {
+ public:
+  SoftwareOutputDeviceUwp();
+  SoftwareOutputDeviceUwp(const SoftwareOutputDeviceUwp&) = delete;
+  SoftwareOutputDeviceUwp& operator=(const SoftwareOutputDeviceUwp&) = delete;
+  ~SoftwareOutputDeviceUwp() override;
+
+  // SoftwareOutputDevice:
+  SkCanvas* BeginPaint(const gfx::Rect& damage_rect) override;
+  void EndPaint() override;
+
+ private:
+  bool EnsureSwapChain();
+  void Measure(base::TimeTicks paint_end, base::TimeTicks copy_end);
+
+  Microsoft::WRL::ComPtr<ID3D11Device> device_;
+  Microsoft::WRL::ComPtr<ID3D11DeviceContext> context_;
+  Microsoft::WRL::ComPtr<IDXGISwapChain1> swap_chain_;
+  gfx::Size swap_chain_size_;
+  gfx::Rect previous_damage_;
+  int fresh_buffers_ = 0;  // présentations encore à faire en entier
+  bool failed_ = false;
+
+  // Mesures écrites dans le journal toutes les kMeasuredFrames images.
+  base::TimeTicks paint_start_;
+  base::TimeTicks period_start_;
+  base::TimeDelta paint_total_;
+  base::TimeDelta copy_total_;
+  base::TimeDelta present_total_;
+  int64_t copied_pixels_ = 0;
+  int frames_ = 0;
+};
+
+}  // namespace viz
+
+#endif  // COMPONENTS_VIZ_SERVICE_DISPLAY_EMBEDDER_SOFTWARE_OUTPUT_DEVICE_UWP_H_
