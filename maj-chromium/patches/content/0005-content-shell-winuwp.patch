+
+namespace extensions {
+
+namespace action = api::action;
+namespace commands = api::commands;
+namespace windows = api::windows;
+
+namespace {
+
+windows::Window TheWindow() {
+  windows::Window window;
+  window.id = rhenium::kWindowId;
+  window.focused = true;
+  window.incognito = false;
+  window.always_on_top = false;
+  window.type = "normal";
+  window.state = "fullscreen";
+  return window;
+}
+
+// Texte du badge par extension, rendu par getBadgeText ; rien à l'écran.
+std::map<ExtensionId, std::string>& BadgeTexts() {
+  static base::NoDestructor<std::map<ExtensionId, std::string>> texts;
+  return *texts;
+}
+
+}  // namespace
+
+// Comme tabs.create : page d'extension par-dessus l'onglet, page web dans un
+// nouvel onglet.
+ExtensionFunction::ResponseAction WindowsCreateFunction::Run() {
+  auto params = windows::Create::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  std::string spec;
+  if (params->create_data && params->create_data->url) {
+    const auto& url = *params->create_data->url;
+    if (url.as_string)
+      spec = *url.as_string;
+    else if (url.as_strings && !url.as_strings->empty())
+      spec = url.as_strings->front();
+  }
+  if (!spec.empty()) {
+    const GURL url = extension()->GetResourceURL(spec);
+    if (!url.is_valid())
+      return RespondNow(Error("Invalid url: \"" + spec + "\"."));
+    const bool opened = url.SchemeIs(kExtensionScheme)
+                            ? rhenium::OpenOverlay(browser_context(), url)
+                            : rhenium::OpenTab(url);
+    if (!opened)
+      return RespondNow(Error("Rhénium : page impossible à ouvrir."));
+  }
+  return RespondNow(
+      ArgumentList(windows::Create::Results::Create(TheWindow())));
+}
+
+ExtensionFunction::ResponseAction WindowsUpdateFunction::Run() {
+  auto params = windows::Update::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  return RespondNow(
+      ArgumentList(windows::Update::Results::Create(TheWindow())));
+}
+
+ExtensionFunction::ResponseAction CommandsGetAllFunction::Run() {
+  return RespondNow(ArgumentList(
+      commands::GetAll::Results::Create(std::vector<commands::Command>())));
+}
+
+ExtensionFunction::ResponseAction ActionSetIconFunction::Run() {
+  auto params = action::SetIcon::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction ActionSetTitleFunction::Run() {
+  auto params = action::SetTitle::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction ActionSetBadgeTextFunction::Run() {
+  auto params = action::SetBadgeText::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  BadgeTexts()[extension_id()] = params->details.text.value_or(std::string());
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction ActionGetBadgeTextFunction::Run() {
+  auto params = action::GetBadgeText::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  const auto it = BadgeTexts().find(extension_id());
+  return RespondNow(ArgumentList(action::GetBadgeText::Results::Create(
+      it != BadgeTexts().end() ? it->second : std::string())));
+}
+
+ExtensionFunction::ResponseAction
+ActionSetBadgeBackgroundColorFunction::Run() {
+  auto params = action::SetBadgeBackgroundColor::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  return RespondNow(NoArguments());
+}
+
+}  // namespace extensions
