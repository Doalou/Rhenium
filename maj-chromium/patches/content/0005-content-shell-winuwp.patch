+void RheniumExtensionsBrowserClient::GetTabAndWindowIdForWebContents(
+    content::WebContents* web_contents,
+    int* tab_id,
+    int* window_id) {
+  *tab_id = rhenium::GetTabId(web_contents);
+  *window_id = *tab_id >= 0 ? rhenium::kWindowId : -1;
+}
+
+bool RheniumExtensionsBrowserClient::IsValidTabId(
+    content::BrowserContext* browser_context,
+    int tab_id,
+    bool include_incognito,
+    content::WebContents** web_contents) const {
+  content::WebContents* tab = rhenium::GetTabWebContents(tab_id);
+  if (web_contents)
+    *web_contents = tab;
+  return tab != nullptr;
+}
