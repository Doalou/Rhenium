+#include "extensions/common/extension.h"
+#include "net/base/url_util.h"
+#include "net/http/http_content_disposition.h"
+#include "net/http/http_response_headers.h"
+#include "url/gurl.h"
+
+namespace rhenium {
+
+namespace {
+
+// Clé du manifeste de j5\pdfjs.
+constexpr char kViewerId[] = "jofiphiaggcjbefdfkpajonmlakcbkng";
+constexpr char kViewerPath[] = "/web/viewer.html";
+constexpr char kUrlParam[] = "url";
+
+class PdfThrottle : public content::NavigationThrottle {
+ public:
+  explicit PdfThrottle(content::NavigationThrottleRegistry& registry)
+      : content::NavigationThrottle(registry) {}
+
+  ThrottleCheckResult WillProcessResponse() override {
+    content::NavigationHandle* handle = navigation_handle();
+    const net::HttpResponseHeaders* headers = handle->GetResponseHeaders();
+    std::string mime;
+    if (!headers || !headers->GetMimeType(&mime) ||
+        !base::EqualsCaseInsensitiveASCII(mime, "application/pdf") ||
+        handle->IsPost()) {
+      return PROCEED;
+    }
+    std::optional<std::string> disposition =
+        headers->GetNormalizedHeader("Content-Disposition");
+    if (disposition &&
+        net::HttpContentDisposition(*disposition, std::string())
+            .is_attachment()) {
+      return PROCEED;
+    }
+    content::WebContents* web_contents = handle->GetWebContents();
+    const extensions::Extension* viewer =
+        extensions::ExtensionRegistry::Get(web_contents->GetBrowserContext())
+            ->enabled_extensions()
+            .GetByID(kViewerId);
+    if (!viewer)
+      return PROCEED;
+
+    const GURL viewer_url = net::AppendQueryParameter(
+        viewer->GetResourceURL(kViewerPath), kUrlParam,
+        handle->GetURL().spec());
+    LOG(INFO) << "Rhenium : PDF ouvert dans la liseuse";
+    // Pas pendant l'annulation de cette navigation.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<content::WebContents> web_contents,
+               const GURL& url, ui::PageTransition transition) {
+              if (!web_contents)
+                return;
+              content::NavigationController::LoadURLParams params(url);
+              params.transition_type = transition;
+              web_contents->GetController().LoadURLWithParams(params);
+            },
+            web_contents->GetWeakPtr(), viewer_url,
+            handle->GetPageTransition()));
+    return CANCEL_AND_IGNORE;
+  }
+
+  const char* GetNameForLogging() override { return "RheniumPdfThrottle"; }
+};
+
+}  // namespace
+
+void MaybeAddPdfThrottle(content::NavigationThrottleRegistry& registry) {
+  content::NavigationHandle& handle = registry.GetNavigationHandle();
+  if (!handle.IsInPrimaryMainFrame() ||
+      !handle.GetURL().SchemeIsHTTPOrHTTPS()) {
+    return;
+  }
+  registry.AddThrottle(std::make_unique<PdfThrottle>(registry));
+}
+
+GURL PdfSourceUrl(const GURL& url) {
+  if (!url.SchemeIs(extensions::kExtensionScheme) ||
+      url.host() != kViewerId || url.path() != kViewerPath) {
+    return url;
+  }
+  std::string value;
+  if (!net::GetValueForKeyInQuery(url, kUrlParam, &value))
+    return url;
+  GURL source(value);
+  return source.SchemeIsHTTPOrHTTPS() ? source : url;
+}
+
+}  // namespace rhenium
