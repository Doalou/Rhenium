@@ -0,0 +1,50 @@
+# Copyright 2026 Doalo
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+# Rhénium : API de //chrome dont uBlock Origin Lite a besoin, réduites à un
+# navigateur à un seul onglet (implémentations dans ..\browser).
+
+import("//tools/json_schema_compiler/json_features.gni")
+import("//tools/json_schema_compiler/json_schema_api.gni")
+
+rhenium_api_schema_files = [
+  "action.json",
+  "commands.json",
+  "tabs.json",
+  "windows.json",
+]
+
+group("api") {
+  public_deps = [
+    ":api_features",
+    ":generated_api_json_strings",
+    ":generated_api_types",
+    ":permission_features",
+  ]
+}
+
+generated_json_strings("generated_api_json_strings") {
+  sources = rhenium_api_schema_files
+  bundle_name = "Rhenium"
+  root_namespace = "extensions::api::%(namespace)s"
+  deps = [ "//base" ]
+}
+
+generated_types("generated_api_types") {
+  sources = rhenium_api_schema_files
+  root_namespace = "extensions::api::%(namespace)s"
+  deps = [ "//base" ]
+}
+
+json_features("api_features") {
+  feature_type = "APIFeature"
+  method_name = "AddRheniumAPIFeatures"
+  sources = [ "_api_features.json" ]
+}
+
+json_features("permission_features") {
+  feature_type = "PermissionFeature"
+  method_name = "AddRheniumPermissionFeatures"
+  sources = [ "_permission_features.json" ]
+}
