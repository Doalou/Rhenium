+
+class RheniumExtensionHostDelegate : public ExtensionHostDelegate {
+ public:
+  void OnExtensionHostCreated(content::WebContents* web_contents) override {
+    RheniumExtensionWebContentsObserver::CreateForWebContents(web_contents);
+  }
+  void CreateTab(std::unique_ptr<content::WebContents> web_contents,
+                 const GURL& target_url,
+                 const ExtensionId& extension_id,
+                 WindowOpenDisposition disposition,
+                 const blink::mojom::WindowFeatures& window_features,
+                 bool user_gesture) override {}
+  void ProcessMediaAccessRequest(content::WebContents* web_contents,
+                                 const content::MediaStreamRequest& request,
+                                 content::MediaResponseCallback callback,
+                                 const Extension* extension) override {
+    // Rhénium : extensions/browser/media_capture_util.h n'existe plus dans la
+    // 156 ; pas de capture média pour les extensions (uBO Lite n'en a pas).
+    std::move(callback).Run(blink::mojom::StreamDevicesSet(),
+                            blink::mojom::MediaStreamRequestResult::NOT_SUPPORTED,
+                            nullptr);
+  }
+  bool CheckMediaAccessPermission(content::RenderFrameHost* render_frame_host,
+                                  const url::Origin& security_origin,
+                                  blink::mojom::MediaStreamType type,
+                                  const Extension* extension) override {
+    return false;
+  }
+  content::PictureInPictureResult EnterPictureInPicture(
+      content::WebContents* web_contents) override {
+    return content::PictureInPictureResult::kNotSupported;
+  }
+  void ExitPictureInPicture() override {}
+};
+
+class RheniumRuntimeAPIDelegate : public RuntimeAPIDelegate {
+ public:
+  void AddUpdateObserver(UpdateObserver* observer) override {}
+  void RemoveUpdateObserver(UpdateObserver* observer) override {}
+  void ReloadExtension(const ExtensionId& extension_id) override {}
+  bool CheckForUpdates(const ExtensionId& extension_id,
+                       UpdateCheckCallback callback) override {
+    return false;
+  }
+  void OpenURL(const GURL& uninstall_url) override {}
+  bool GetPlatformInfo(api::runtime::PlatformInfo* info) override {
+    info->os = api::runtime::PlatformOs::kWin;
+    info->arch = api::runtime::PlatformArch::kArm;
+    info->nacl_arch = api::runtime::PlatformNaclArch::kArm;
+    return true;
+  }
+  bool RestartDevice(std::string* error_message) override {
+    *error_message = "Restart is not supported.";
+    return false;
+  }
+  // La page d'options (tableau de bord de uBO Lite) remplace le popup
+  // par-dessus l'onglet. Seulement depuis une page d'extension déjà ouverte :
+  // uBO Lite la demande aussi à sa première exécution, ce qui couvrirait la
+  // page au premier lancement.
+  void OpenOptionsPage(const Extension* extension,
+                       content::BrowserContext* browser_context,
+                       base::OnceCallback<void(bool)> callback) override {
+    const GURL url = OptionsPageInfo::GetOptionsPage(extension);
+    std::move(callback).Run(url.is_valid() && rhenium::IsOverlayOpen() &&
+                            rhenium::OpenOverlay(browser_context, url));
+  }
+};
+
+// Comme app_shell : runtime.sendMessage et connect passent par
+// MessageService, qui exige un délégué (le comportement par défaut suffit,
+// sans messagerie native ni onglets d'autres profils).
+// L'expéditeur d'un message venu d'un onglet porte cet onglet (sender.tab) :
+// uBO Lite en a besoin pour son insertCSS.
+class RheniumMessagingDelegate : public MessagingDelegate {
+ public:
+  std::optional<base::DictValue> MaybeGetTabInfo(
+      content::WebContents* web_contents) override {
+    return GetTabInfo(web_contents);
+  }
+  content::WebContents* GetWebContentsByTabId(
+      content::BrowserContext* browser_context,
+      int tab_id) override {
+    return rhenium::GetTabWebContents(tab_id);
+  }
+};
+
+// chrome.management, que la 156 sollicite à chaque installation (événement
+// onInstalled) : pas d'applications ni de raccourcis, activation et
+// suppression par le gestionnaire d'extensions de Rhénium, sans dialogue.
+class RheniumManagementAPIDelegate : public ManagementAPIDelegate {
+ public:
+  bool LaunchAppFunctionDelegate(
+      const Extension* extension,
+      content::BrowserContext* context) const override {
+    return false;
+  }
+  GURL GetFullLaunchURL(const Extension* extension) const override {
+    return GURL();
+  }
+  LaunchType GetLaunchType(const ExtensionPrefs* prefs,
+                           const Extension* extension) const override {
+    return LAUNCH_TYPE_DEFAULT;
+  }
+  std::unique_ptr<InstallPromptDelegate> SetEnabledFunctionDelegate(
+      content::WebContents* web_contents,
+      content::BrowserContext* browser_context,
+      const Extension* extension,
+      base::OnceCallback<void(bool)> callback) const override {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback), true));
+    return nullptr;
+  }
+  void EnableExtension(content::BrowserContext* context,
+                       const ExtensionId& extension_id) const override {
+    rhenium::SetExtensionEnabled(extension_id, true);
+  }
+  void DisableExtension(
+      content::BrowserContext* context,
+      const Extension* source_extension,
+      const ExtensionId& extension_id,
+      disable_reason::DisableReason disable_reason) const override {
+    rhenium::SetExtensionEnabled(extension_id, false);
+  }
+  std::unique_ptr<UninstallDialogDelegate> UninstallFunctionDelegate(
+      ManagementUninstallFunctionBase* function,
+      const Extension* target_extension,
+      bool show_programmatic_uninstall_ui) const override {
+    return nullptr;
+  }
+  bool UninstallExtension(content::BrowserContext* context,
+                          const std::string& transient_extension_id,
+                          UninstallReason reason,
+                          std::u16string* error) const override {
+    if (rhenium::UninstallExtension(transient_extension_id))
+      return true;
+    *error = u"Extension du paquet de Rhénium";
+    return false;
+  }
+  bool CreateAppShortcutFunctionDelegate(
+      ManagementCreateAppShortcutFunction* function,
+      const Extension* extension,
+      std::string* error) const override {
+    *error = "Pas de raccourci dans Rhénium";
+    return false;
+  }
+  void SetLaunchType(content::BrowserContext* context,
+                     const ExtensionId& extension_id,
+                     LaunchType launch_type) const override {}
+  std::unique_ptr<AppForLinkDelegate> GenerateAppForLinkFunctionDelegate(
+      ManagementGenerateAppForLinkFunction* function,
+      content::BrowserContext* context,
+      const std::string& title,
+      const GURL& launch_url) const override {
+    return nullptr;
+  }
+  bool CanContextInstallWebApps(
+      content::BrowserContext* context) const override {
+    return false;
+  }
+  void InstallOrLaunchReplacementWebApp(
+      content::BrowserContext* context,
+      const GURL& web_app_url,
+      InstallOrLaunchWebAppCallback callback) const override {
+    std::move(callback).Run(InstallOrLaunchWebAppResult::kUnknownError);
+  }
+  GURL GetIconURL(const Extension* extension,
+                  int icon_size,
+                  ExtensionIconSet::Match match,
+                  bool grayscale) const override {
