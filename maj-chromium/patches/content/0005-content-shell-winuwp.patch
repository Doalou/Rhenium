+#if defined(WINUWP)
+namespace {
+// Rhénium : Skia agrandit une image vidéo de 640x360 à l'écran en 30 ms sur
+// le Lumia 950. libyuv (NEON) la met à la taille de l'écran en quelques
+// millisecondes, et Skia n'a plus qu'à la recopier. L'image mise à l'échelle
+// est gardée tant que la vidéo et sa place ne changent pas.
+struct ScaledVideo {
+  SkBitmap bitmap;
+  uint32_t image_id = 0;
+  SkIRect source;
+};
+
+bool DrawScaledVideo(SkCanvas* canvas,
+                     const SkImage* image,
+                     const SkRect& source_rect,
+                     const SkRect& quad_rect,
+                     const SkPaint& paint) {
+  static base::NoDestructor<ScaledVideo> cache;
+  const SkMatrix& matrix = canvas->getTotalMatrix();
+  if (!matrix.isScaleTranslate())
+    return false;
+  const SkIRect target = matrix.mapRect(quad_rect).round();
+  const SkIRect source = source_rect.round();
+  SkPixmap pixels;
+  if (target.isEmpty() || source.isEmpty() || target.width() > 4096 ||
+      target.height() > 4096 || !image->peekPixels(&pixels) ||
+      pixels.info().bytesPerPixel() != 4 ||
+      !SkIRect::MakeSize(pixels.dimensions()).contains(source)) {
+    return false;
+  }
+  SkBitmap& scaled = cache->bitmap;
+  const bool resized = scaled.width() != target.width() ||
+                       scaled.height() != target.height() ||
+                       scaled.colorType() != pixels.colorType();
+  if (resized && !scaled.tryAllocPixels(pixels.info().makeWH(
+                     target.width(), target.height()))) {
+    scaled.reset();
+    return false;
+  }
+  if (resized || cache->image_id != image->uniqueID() ||
+      cache->source != source) {
+    libyuv::ARGBScale(
+        static_cast<const uint8_t*>(pixels.addr(source.x(), source.y())),
+        static_cast<int>(pixels.rowBytes()), source.width(), source.height(),
+        static_cast<uint8_t*>(scaled.getPixels()),
+        static_cast<int>(scaled.rowBytes()), target.width(), target.height(),
+        libyuv::kFilterBilinear);
+    cache->image_id = image->uniqueID();
+    cache->source = source;
+  }
+  SkAutoCanvasRestore restore(canvas, /*doSave=*/true);
+  canvas->resetMatrix();
+  canvas->drawImage(
+      SkImages::RasterFromPixmap(scaled.pixmap(), nullptr, nullptr),
+      target.x(), target.y(), SkSamplingOptions(), &paint);
+  return true;
+}
+}  // namespace
+#endif
