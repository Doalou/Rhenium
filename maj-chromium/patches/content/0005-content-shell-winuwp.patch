+              "currentWindow": {"type": "boolean", "optional": true},
+              "lastFocusedWindow": {"type": "boolean", "optional": true},
+              "url": {
+                "choices": [
+                  {"type": "string"},
+                  {"type": "array", "items": {"type": "string"}}
