+namespace rhenium {
+
+// Onglets de Rhénium : un Shell de content_shell par onglet, tous dans la même
+// fenêtre Aura, seul l'actif visible. Les pages d'extension (popup, options)
+// s'ouvrent dans un Shell de plus, posé sur l'onglet actif, qui n'est pas un
+// onglet. Tout s'appelle sur le thread UI.
+constexpr int kWindowId = 1;
+// Au-delà, un lien qui ouvrirait un onglet s'ouvre dans le sien : chaque
+// onglet garde sa page en mémoire, dans le seul processus de l'app.
+constexpr int kMaxTabs = 8;
+
+// Rappels vers la coquille.
+struct TabObserver {
+  void* context = nullptr;
+  // Onglet ouvert, fermé ou activé.
+  void (*tabs_changed)(void* context, int count) = nullptr;
+  // Page http(s) chargée dans un onglet, puis de nouveau quand son titre
+  // arrive.
+  void (*page_visited)(void* context,
+                       const wchar_t* url,
+                       const wchar_t* title) = nullptr;
+  // Aperçu d'un onglet, BGRA, sur le thread UI.
+  void (*tab_thumbnail)(void* context,
+                        int id,
+                        const uint8_t* bgra,
+                        int width,
+                        int height,
+                        int stride) = nullptr;
+};
+
+// À appeler avant la création du premier Shell.
+void InitTabs(const TabObserver& observer);
+
+content::Shell* GetActiveShell();
+content::WebContents* GetActiveWebContents();
+content::WebContents* GetOverlayWebContents();
+
+int GetTabCount();
+content::WebContents* GetTabAt(int index);
+// Identifiant de l'onglet (pour chrome.tabs), -1 s'il n'en est pas un.
+int GetTabId(content::WebContents* web_contents);
+content::WebContents* GetTabWebContents(int id);
+bool IsTabActive(int id);
+
+// Parcourt les onglets dans l'ordre.
+void ForEachTab(void (*visit)(void* context,
+                              int id,
+                              int active,
+                              const wchar_t* title,
+                              const wchar_t* url),
+                void* context);
+
+bool CanOpenTab();
+// Nouvel onglet actif ; faux au-delà de kMaxTabs.
+bool OpenTab(const GURL& url);
+// Onglet d'une session précédente, en arrière-plan : sa page ne se charge
+// qu'à son activation. Faux au-delà de kMaxTabs.
+bool RestoreTab(const GURL& url, const std::u16string& title);
+void ActivateTab(int id);
+// Faux pour le dernier onglet, qui reste.
+bool CloseTab(int id);
+// Précédent dans l'onglet actif ; à défaut, ferme l'onglet ouvert par un lien
+// et revient à celui du lien. Faux s'il n'y a rien à faire.
+bool GoBack();
+// Mémoire critique : décharge la page de l'onglet inactif utilisé le moins
+// récemment, qui garde son historique et se recharge à son activation. Faux
+// s'il n'y en a plus.
+bool DiscardTab();
+// Demande un aperçu de l'onglet actif (rappel tab_thumbnail).
+void CaptureActiveTab();
+
+// App visible ou masquée : seuls l'onglet actif et la page d'extension
+// s'affichent.
+void SetAppVisible(bool visible);
+
+// Ouvre (ou remplace) la page d'extension par-dessus l'onglet.
+bool OpenOverlay(content::BrowserContext* context, const GURL& url);
+// Popup de l'action, ou page d'options, de la première extension qui en a
+// (celles du paquet d'abord).
+bool OpenActionPopup();
+bool OpenOptionsPage();
+void CloseOverlay();
+bool IsOverlayOpen();
+
+// Version pour ordinateur : agent utilisateur de Chrome pour Windows au lieu
+// de celui de Chrome pour Android. Réglage de l'app, qui vaut pour les
+// onglets ouverts dès leur prochain chargement, puis choix par onglet, qui
+// recharge la page.
+void SetDesktopSites(bool desktop);
+bool IsActiveTabDesktop();
+void SetActiveTabDesktop(bool desktop);
+
+// Thème des pages (prefers-color-scheme), et pages claires assombries par
+// Blink en thème sombre si `force_dark`. Appliqué tout de suite aux onglets
+// ouverts.
+void SetDarkMode(bool dark, bool force_dark);
+// Pour ContentBrowserClient::OverrideWebPreferences.
+void ApplyDarkMode(blink::web_pref::WebPreferences* prefs);
+
+}  // namespace rhenium
+
+#endif  // EXTENSIONS_RHENIUM_RHENIUM_TAB_MODEL_H_
diff --git a/extensions/rhenium/rhenium_tabs_api.cc b/extensions/rhenium/rhenium_tabs_api.cc
new file mode 100644
index 0000000000..53f5b90464
--- /dev/null
+++ b/extensions/rhenium/rhenium_tabs_api.cc
@@ -0,0 +1,192 @@
+// Copyright 2026 Doalo
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "extensions/rhenium/rhenium_tabs_api.h"
+
+#include <string>
+#include <vector>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/referrer.h"
+#include "extensions/common/constants.h"
+#include "extensions/common/url_pattern.h"
+#include "extensions/common/url_pattern_set.h"
+#include "extensions/rhenium/api/tabs.h"
+#include "extensions/rhenium/rhenium_tab_model.h"
+#include "ui/base/page_transition_types.h"
+#include "url/gurl.h"
+
+namespace extensions {
+
+namespace tabs = api::tabs;
+
+namespace {
+
+constexpr char kNoTab[] = "No tab with id: *.";
+
+tabs::Tab MakeTab(content::WebContents* web_contents, int index) {
+  const int id = rhenium::GetTabId(web_contents);
+  const bool active = rhenium::IsTabActive(id);
+  tabs::Tab tab;
+  tab.id = id;
+  tab.index = index;
+  tab.window_id = rhenium::kWindowId;
+  tab.highlighted = active;
+  tab.active = active;
+  tab.pinned = false;
+  tab.incognito = false;
+  tab.discarded = false;
+  tab.auto_discardable = false;
+  tab.url = web_contents->GetLastCommittedURL().spec();
+  tab.title = base::UTF16ToUTF8(web_contents->GetTitle());
+  tab.status = web_contents->IsLoading() ? "loading" : "complete";
+  return tab;
+}
+
+}  // namespace
+
+std::optional<base::DictValue> GetTabInfo(
+    content::WebContents* web_contents) {
+  for (int index = 0; index < rhenium::GetTabCount(); ++index) {
+    if (rhenium::GetTabAt(index) == web_contents)
+      return MakeTab(web_contents, index).ToValue();
+  }
+  return std::nullopt;
+}
+
+// Une seule fenêtre, courante et dernière focalisée.
+ExtensionFunction::ResponseAction TabsQueryFunction::Run() {
+  auto params = tabs::Query::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  const auto& query = params->query_info;
+  std::vector<tabs::Tab> result;
+  const bool other_window =
+      (query.current_window && !*query.current_window) ||
+      (query.last_focused_window && !*query.last_focused_window) ||
+      (query.window_type && *query.window_type != "normal");
+  URLPatternSet url_patterns;
+  if (query.url) {
+    std::vector<std::string> patterns;
+    if (query.url->as_string)
+      patterns.push_back(*query.url->as_string);
+    else if (query.url->as_strings)
+      patterns = *query.url->as_strings;
+    std::string error;
+    if (!url_patterns.Populate(patterns, URLPattern::SCHEME_ALL,
+                               /*allow_file_access=*/true, &error)) {
+      return RespondNow(Error(error));
+    }
+  }
+  for (int index = 0; !other_window && index < rhenium::GetTabCount();
+       ++index) {
+    content::WebContents* web_contents = rhenium::GetTabAt(index);
+    const bool active = rhenium::IsTabActive(rhenium::GetTabId(web_contents));
+    if (query.active && *query.active != active)
+      continue;
+    if (query.url &&
+        !url_patterns.MatchesURL(web_contents->GetLastCommittedURL())) {
+      continue;
+    }
+    result.push_back(MakeTab(web_contents, index));
+  }
+  return RespondNow(ArgumentList(tabs::Query::Results::Create(result)));
+}
+
+// Sans identifiant : l'onglet actif.
+ExtensionFunction::ResponseAction TabsReloadFunction::Run() {
+  auto params = tabs::Reload::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  content::WebContents* web_contents =
+      params->tab_id ? rhenium::GetTabWebContents(*params->tab_id)
+                     : rhenium::GetActiveWebContents();
+  if (!web_contents) {
+    return RespondNow(
+        Error(kNoTab, base::NumberToString(params->tab_id.value_or(-1))));
+  }
+  const bool bypass_cache = params->reload_properties &&
+                            params->reload_properties->bypass_cache.value_or(
+                                false);
+  web_contents->GetController().Reload(
+      bypass_cache ? content::ReloadType::BYPASSING_CACHE
+                   : content::ReloadType::NORMAL,
+      /*check_for_repost=*/false);
+  return RespondNow(NoArguments());
+}
+
+namespace {
+
+// Onglet actif tel que le voit chrome.tabs.
+tabs::Tab ActiveTab() {
+  content::WebContents* active = rhenium::GetActiveWebContents();
+  for (int index = 0; index < rhenium::GetTabCount(); ++index) {
+    if (rhenium::GetTabAt(index) == active)
+      return MakeTab(active, index);
+  }
+  tabs::Tab tab;
+  tab.id = -1;
+  tab.index = -1;
+  tab.window_id = rhenium::kWindowId;
+  tab.highlighted = tab.active = tab.pinned = tab.incognito = false;
+  tab.discarded = tab.auto_discardable = false;
+  return tab;
+}
+
+}  // namespace
+
+// Une page d'extension s'ouvre par-dessus l'onglet, comme son popup et ses
+// options ; une page web, dans un nouvel onglet. Pas d'onglet en arrière-plan.
+ExtensionFunction::ResponseAction TabsCreateFunction::Run() {
+  auto params = tabs::Create::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  const GURL url = params->create_properties.url
+                       ? extension()->GetResourceURL(
+                             *params->create_properties.url)
+                       : GURL("about:blank");
+  if (!url.is_valid())
+    return RespondNow(Error("Invalid url."));
+  if (url.SchemeIs(kExtensionScheme)) {
+    if (!rhenium::OpenOverlay(browser_context(), url))
+      return RespondNow(Error("Rhénium : page impossible à ouvrir."));
+    tabs::Tab tab = ActiveTab();
+    tab.id = -1;
+    tab.url = url.spec();
+    return RespondNow(ArgumentList(tabs::Create::Results::Create(tab)));
+  }
+  if (!rhenium::OpenTab(url))
+    return RespondNow(Error("Rhénium : trop d'onglets ouverts."));
+  return RespondNow(ArgumentList(tabs::Create::Results::Create(ActiveTab())));
+}
+
+// Sans identifiant : l'onglet actif.
+ExtensionFunction::ResponseAction TabsUpdateFunction::Run() {
+  auto params = tabs::Update::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  const int id = params->tab_id.value_or(
+      rhenium::GetTabId(rhenium::GetActiveWebContents()));
+  content::WebContents* web_contents = rhenium::GetTabWebContents(id);
+  if (!web_contents)
+    return RespondNow(Error(kNoTab, base::NumberToString(id)));
+  const auto& properties = params->update_properties;
+  if (properties.url) {
+    const GURL url = extension()->GetResourceURL(*properties.url);
+    if (!url.is_valid())
+      return RespondNow(Error("Invalid url: \"" + *properties.url + "\"."));
+    web_contents->GetController().LoadURL(
+        url, content::Referrer(), ui::PAGE_TRANSITION_FROM_API, std::string());
+  }
+  if (properties.active.value_or(false))
+    rhenium::ActivateTab(id);
+  for (int index = 0; index < rhenium::GetTabCount(); ++index) {
+    if (rhenium::GetTabAt(index) == web_contents) {
+      return RespondNow(ArgumentList(
+          tabs::Update::Results::Create(MakeTab(web_contents, index))));
+    }
+  }
+  return RespondNow(NoArguments());
+}
+
+}  // namespace extensions
