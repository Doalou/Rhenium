diff --git a/build/rhenium/msvc_arm32_intrinsics.h b/build/rhenium/msvc_arm32_intrinsics.h
new file mode 100644
index 0000000000..186c727c21
--- /dev/null
+++ b/build/rhenium/msvc_arm32_intrinsics.h
@@ -0,0 +1,27 @@
+// Rhénium : intrinsèques MSVC ARM qu'appelle la STL MSVC (std::countl_zero) et que clang ne
+// déclare que pour ARM64. Inclus de force (/FI) sur Windows ARM32.
+
+#ifndef BUILD_RHENIUM_MSVC_ARM32_INTRINSICS_H_
+#define BUILD_RHENIUM_MSVC_ARM32_INTRINSICS_H_
+
+#if defined(__clang__) && defined(_M_ARM)
+
+static __inline__ unsigned int __attribute__((__always_inline__))
+_CountLeadingZeros(unsigned long value) {
+  return value ? (unsigned int)__builtin_clzl(value) : 32u;
+}
+
+static __inline__ unsigned int __attribute__((__always_inline__))
+_CountLeadingZeros64(unsigned long long value) {
+  return value ? (unsigned int)__builtin_clzll(value) : 64u;
+}
+
+// Barrière de compilation de MSVC, déclarée mais pas fournie par clang pour ARM32
+// (SQLite s'en sert avec clang-cl).
+static __inline__ void __attribute__((__always_inline__)) _ReadWriteBarrier(void) {
+  __asm__ __volatile__("" ::: "memory");
+}
+
+#endif
+
+#endif  // BUILD_RHENIUM_MSVC_ARM32_INTRINSICS_H_
