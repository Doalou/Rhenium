+// Rhénium : Windows 10 Mobile (UWP, ARM32). Une app ne crée de mémoire
+// exécutable que par VirtualAllocFromApp/VirtualProtectFromApp (capability
+// codeGeneration), qui refusent toute protection écriture+exécution, et
+// VirtualAllocFromApp refuse même l'exécution seule. On alloue donc sans
+// exécution puis on bascule la protection. V8 doit tourner avec
+// --no-write-code-using-rwx (W^X), sinon ses demandes RWX échouent ici.
+constexpr DWORD kExecuteProtections = PAGE_EXECUTE | PAGE_EXECUTE_READ |
+                                      PAGE_EXECUTE_READWRITE |
+                                      PAGE_EXECUTE_WRITECOPY;
+
+// Rhénium : JIT multi-thread sans page RWX.
+// En W^X (--write-protect-code-memory), V8 passe toute la zone d'objets d'une
+// page de code (MemoryChunk de 256 Ko) en RW le temps d'y écrire, sous le
+// mutex de cette page, puis la remet en RX. Si un autre thread exécute du code
+// de cette zone pendant ce temps (le thread principal pendant que le balayeur
+// concurrent, la compilation concurrente ou une tâche du GC y écrit), il prend
+// une violation d'exécution. Le gestionnaire d'exceptions vectorisé ci-dessous
+// fait patienter ce thread jusqu'au retour de la page en exécution, puis
+// reprend l'instruction fautive. Les écrivains se sérialisent déjà par page et
+// ne bloquent jamais sous ce mutex : l'attente dure quelques microsecondes.
+// (Un double mappage RW/RX demanderait de traduire chaque écriture de V8 dans
+// ses pages de code, dispersées dans le tas : voir j1\README.md.)
+
+// Un bit par page de 4 Ko de l'espace d'adressage 32 bits (128 Ko de .bss,
+// engagés à la demande) : vrai si V8 a rendu la page exécutable.
+constexpr uintptr_t kCodePageShift = 12;
+std::atomic<uint32_t> code_pages[(uint64_t{1} << (32 - kCodePageShift)) / 32];
+
+bool IsCodePage(uintptr_t address) {
+  uintptr_t page = address >> kCodePageShift;
+  return code_pages[page / 32].load(std::memory_order_relaxed) &
+         (uint32_t{1} << (page % 32));
+}
+
+void MarkCodePages(void* address, size_t size, bool code) {
+  if (size == 0) return;
+  uintptr_t first = reinterpret_cast<uintptr_t>(address) >> kCodePageShift;
+  uintptr_t last =
+      (reinterpret_cast<uintptr_t>(address) + size - 1) >> kCodePageShift;
+  for (uintptr_t page = first; page <= last; ++page) {
+    uint32_t bit = uint32_t{1} << (page % 32);
+    if (code) {
+      code_pages[page / 32].fetch_or(bit, std::memory_order_relaxed);
+    } else {
+      code_pages[page / 32].fetch_and(~bit, std::memory_order_relaxed);
+    }
+  }
+}
+
+// Statistiques des attentes, lues par rhenium_wx_stats().
+std::atomic<uint32_t> wx_waits{0};
+std::atomic<uint64_t> wx_wait_ticks{0};
+std::atomic<uint64_t> wx_wait_max_ticks{0};
+
+LONG WINAPI WaitForCodePage(EXCEPTION_POINTERS* info) {
+  const EXCEPTION_RECORD* record = info->ExceptionRecord;
+  if (record->ExceptionCode != EXCEPTION_ACCESS_VIOLATION ||
+      record->NumberParameters < 2 ||
+      record->ExceptionInformation[0] != EXCEPTION_EXECUTE_FAULT) {
+    return EXCEPTION_CONTINUE_SEARCH;
+  }
+  uintptr_t address = record->ExceptionInformation[1];
+  if (!IsCodePage(address)) return EXCEPTION_CONTINUE_SEARCH;
+
+  LARGE_INTEGER frequency, start, now;
+  QueryPerformanceFrequency(&frequency);
+  QueryPerformanceCounter(&start);
+  for (int spin = 0;; ++spin) {
+    MEMORY_BASIC_INFORMATION region;
+    if (!VirtualQuery(reinterpret_cast<void*>(address), &region,
+                      sizeof(region)) ||
+        region.State != MEM_COMMIT || !IsCodePage(address)) {
+      return EXCEPTION_CONTINUE_SEARCH;  // page libérée : vraie faute
+    }
+    DWORD protect = region.Protect & 0xFF;
+    if (protect & kExecuteProtections) break;  // écriture finie : on reprend
+    // Une page de code n'est en RW que le temps d'une écriture de V8 ; toute
+    // autre protection signale une vraie faute.
+    if (protect != PAGE_READWRITE) return EXCEPTION_CONTINUE_SEARCH;
+    QueryPerformanceCounter(&now);
+    if (now.QuadPart - start.QuadPart > 10 * frequency.QuadPart) {
+      return EXCEPTION_CONTINUE_SEARCH;  // 10 s : écrivain bloqué, on abandonne
+    }
+    if (spin < 64) {
+      YieldProcessor();
+    } else {
+      Sleep(spin < 1024 ? 0 : 1);
+    }
+  }
+  QueryPerformanceCounter(&now);
+  uint64_t ticks = static_cast<uint64_t>(now.QuadPart - start.QuadPart);
+  wx_waits.fetch_add(1, std::memory_order_relaxed);
+  wx_wait_ticks.fetch_add(ticks, std::memory_order_relaxed);
+  uint64_t max = wx_wait_max_ticks.load(std::memory_order_relaxed);
+  while (ticks > max && !wx_wait_max_ticks.compare_exchange_weak(
+                            max, ticks, std::memory_order_relaxed)) {
+  }
+  return EXCEPTION_CONTINUE_EXECUTION;
+}
+
+void InstallCodePageWaiter() {
+  // Absente des en-têtes « app » : cherchée dans kernelbase, sans import.
+  static const bool installed = [] {
+    using AddVehFn = PVOID(WINAPI*)(ULONG, PVECTORED_EXCEPTION_HANDLER);
+    auto add = reinterpret_cast<AddVehFn>(
+        GetProcAddress(GetModuleHandleW(L"kernelbase.dll"),
+                       "AddVectoredExceptionHandler"));
+    // En tête de liste : ces fautes passagères n'ont pas à être vues ailleurs.
+    return add && add(1, &WaitForCodePage) != nullptr;
+  }();
+  USE(installed);
+}
+
+void* VirtualAllocWrapper(void* address, size_t size, DWORD flags,
+                          DWORD protect) {
+  protect &= ~PAGE_TARGETS_INVALID;  // pas de CFG dans l'app
+  if (!(protect & kExecuteProtections)) {
+    return VirtualAllocFromApp(address, size, flags, protect);
+  }
+  InstallCodePageWaiter();
+  ULONG old_protection;
+  // Pages déjà engagées (retour en RX après une écriture) : une seule bascule,
+  // sans repasser par RW.
+  if (flags == MEM_COMMIT && address != nullptr &&
+      VirtualProtectFromApp(address, size, protect, &old_protection)) {
+    MarkCodePages(address, size, true);
+    return address;
+  }
+  DWORD initial = (flags & MEM_COMMIT) ? PAGE_READWRITE : PAGE_NOACCESS;
+  void* result = VirtualAllocFromApp(address, size, flags, initial);
+  if (result == nullptr || !(flags & MEM_COMMIT)) return result;
+  if (!VirtualProtectFromApp(result, size, protect, &old_protection)) {
+    DWORD error = GetLastError();
+    if (flags & MEM_RESERVE) VirtualFree(result, 0, MEM_RELEASE);
+    SetLastError(error);
+    return nullptr;
+  }
+  MarkCodePages(result, size, true);
+  return result;
+}
+
+void ForgetCodePages(void* address, size_t size) {
+  MarkCodePages(address, size, false);
+}
