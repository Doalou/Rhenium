
# J2 (..\j2\gn\BUILD.gn, ajouté par build-content.ps1) : les bibliothèques de
# content_shell en single-process. L'exe Win32 content_shell (Crashpad, .rc)
# n'a pas cours sous UWP : l'app Rhénium (rhenium_shell) les lie.
group("rhenium_content") {
  testonly = true
  deps = [
    "//content/shell:content_shell_app",
    "//content/shell:content_shell_lib",
    "//content/shell:pak",
    "//tools/v8_context_snapshot:v8_context_snapshot",
  ]
}

# L'app UWP. Coquille XAML (..\j2\shell, compilée par MSVC avec exceptions dans
# rhenium_xaml_shell.lib par build-shell.ps1 : wWinMain, interface) autour du
# moteur (rhenium/engine_uwp.cc et l'API C rhenium_engine.h, copiés depuis
# ..\j2\app par build-content.ps1), et remplacements des imports absents de
# Windows 10 Mobile (..\j1\app\w10m_imports.cc). Empaquetée par
# ..\j2\package-shell.ps1.
executable("rhenium_shell") {
  testonly = true
  sources = [
    "rhenium/engine_uwp.cc",
    "rhenium/log_export_uwp.cc",
    "rhenium/log_export_uwp.h",
    "rhenium/rhenium_engine.h",
    "rhenium/w10m_imports.cc",
  ]
  deps = [
    "//base",
    "//content/public/app",
    "//content/public/browser",
    "//content/shell:content_shell_app",
    "//content/shell:content_shell_lib",
    "//content/shell:pak",
    "//sandbox",
    "//ui/events",
    "//ui/gfx",
    "//ui/platform_window/uwp",
    "//url",
  ]
  data_deps = [ "//content/shell:pak" ]
  defines = [ "RHENIUM_SHELL" ]
  configs -= [ "//build/config/win:console" ]
  configs += [
    "//build/config/win:windowed",
    "//build/config/win:delayloads",
    "//build/config/win:delayloads_not_for_child_dll",
  ]
  libs = [ "rhenium_xaml_shell.lib" ]
  lib_dirs = [ root_out_dir ]
  ldflags = [
    "/APPCONTAINER",
    "/STACK:0x800000",
  ]
}
