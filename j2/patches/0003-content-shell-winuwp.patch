+class COMPONENT_EXPORT(UI_BASE_IME_WIN) InputMethodUwp
+    : public InputMethodBase {
+ public:
+  explicit InputMethodUwp(ImeKeyEventDispatcher* ime_key_event_dispatcher);
+  InputMethodUwp(const InputMethodUwp&) = delete;
+  InputMethodUwp& operator=(const InputMethodUwp&) = delete;
+  ~InputMethodUwp() override;
+
+  // InputMethod:
+  ui::EventDispatchDetails DispatchKeyEvent(ui::KeyEvent* event) override;
+  void OnTextInputTypeChanged(TextInputClient* client) override;
+  void OnCaretBoundsChanged(const TextInputClient* client) override;
+  void CancelComposition(const TextInputClient* client) override;
+  bool IsCandidatePopupOpen() const override;
+  bool OnUntranslatedIMEMessage(const CHROME_MSG event,
+                                NativeEventResult* result) override;
+  void OnInputLocaleChanged() override;
+  bool IsInputLocaleCJK() const override;
+
+ protected:
+  // InputMethodBase:
+  void OnDidChangeFocusedClient(TextInputClient* focused_before,
+                                TextInputClient* focused) override;
+
+ private:
+  void CreateEditContext();
+  void UpdateFocus(bool restart);
+  HRESULT OnTextRequested(
+      ABI::Windows::UI::Text::Core::ICoreTextTextRequestedEventArgs* args);
+  HRESULT OnSelectionRequested(
+      ABI::Windows::UI::Text::Core::ICoreTextSelectionRequestedEventArgs*
+          args);
+  HRESULT OnTextUpdating(
+      ABI::Windows::UI::Text::Core::ICoreTextTextUpdatingEventArgs* args);
+  HRESULT OnSelectionUpdating(
+      ABI::Windows::UI::Text::Core::ICoreTextSelectionUpdatingEventArgs*
+          args);
+  void DispatchEnter();
+  void OnBackKeyForwarded();
+  // Modifications venues du système, appliquées au modèle tenu ici.
+  void ApplyLocalEdit(const gfx::Range& range, const std::u16string& text);
+  // Texte entier du champ, faux si Blink n'en connaît qu'une partie.
+  bool GetClientText(std::u16string* text) const;
+  void ResyncWithClient();
+
+  Microsoft::WRL::ComPtr<ABI::Windows::UI::Text::Core::ICoreTextEditContext>
+      context_;
+  Microsoft::WRL::ComPtr<ABI::Windows::UI::ViewManagement::IInputPane2>
+      input_pane_;
+  EventRegistrationToken text_requested_token_ = {};
+  EventRegistrationToken selection_requested_token_ = {};
+  EventRegistrationToken text_updating_token_ = {};
+  EventRegistrationToken selection_updating_token_ = {};
+  EventRegistrationToken focus_removed_token_ = {};
+  bool context_focused_ = false;
+  // Sélection telle que la voit le système, tenue ici : celle de Blink arrive
+  // en différé.
+  gfx::Range selection_;
+  // Texte du champ tel que le voit le système, et dernier état vu de Blink.
+  std::u16string model_text_;
+  std::u16string client_text_;
+  gfx::Range client_selection_;
+  // Modification locale récente : Blink ne l'a peut-être pas encore reflétée.
+  base::TimeTicks last_local_edit_;
+  // Entrée peut arriver par le texte (« \r ») et par la touche : une seule.
+  base::TimeTicks last_text_enter_;
+  base::TimeTicks last_key_enter_;
+  bool dispatching_text_enter_ = false;
+  // Même chose pour l'effacement.
+  base::TimeTicks last_text_delete_;
+  base::TimeTicks last_key_back_;
+  bool back_key_forwarded_ = false;
+};
+
+}  // namespace ui
+
+#endif  // UI_BASE_IME_WIN_INPUT_METHOD_UWP_H_
