+using extensions::Extension;
+
+// Un seul processus : le navigateur et le moteur de rendu partagent le client.
+extensions::RheniumExtensionsClient* GetExtensionsClient() {
+  static base::NoDestructor<extensions::RheniumExtensionsClient> client;
+  return client.get();
+}
+
+// Démarre le service worker des extensions qui en ont un. Chrome garde d'une
+// session à l'autre les scripts que les extensions enregistrent
+// (chrome.scripting) ; Rhénium non. uBlock Origin Lite les réenregistre à
+// chaque démarrage de son worker, mais n'écoute ni onStartup ni onInstalled :
+// sans ce réveil, son filtrage cosmétique manque jusqu'à ce qu'on ouvre son
+// popup.
+// Une extension installée en arrière-plan est réveillée à son activation.
+void WakeServiceWorkers(content::BrowserContext* context) {
+  auto* system = static_cast<extensions::RheniumExtensionSystem*>(
+      extensions::ExtensionSystem::Get(context));
+  for (const auto& extension :
+       extensions::ExtensionRegistry::Get(context)->enabled_extensions()) {
+    system->WakeServiceWorker(*extension);
+  }
+}
+
+std::unique_ptr<PrefService> CreateUserPrefService(
+    content::BrowserContext* context) {
+  auto store = base::MakeRefCounted<JsonPrefStore>(
+      context->GetPath().AppendASCII("extension_prefs.json"));
+  {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    store->ReadPrefs();
+  }
+  PrefServiceFactory factory;
+  factory.set_user_prefs(store);
+  auto registry = base::MakeRefCounted<user_prefs::PrefRegistrySyncable>();
+  extensions::ExtensionPrefs::RegisterProfilePrefs(registry.get());
+  extensions::PermissionsManager::RegisterProfilePrefs(registry.get());
+  extensions::AudioAPI::RegisterUserPrefs(registry.get());
+  extensions::RuntimeAPI::RegisterPrefs(registry.get());
+  std::unique_ptr<PrefService> prefs = factory.Create(registry);
+  user_prefs::UserPrefs::Set(context, prefs.get());
+  return prefs;
+}
+
+class RheniumBrowserMainParts : public content::ShellBrowserMainParts {
+ public:
+  RheniumBrowserMainParts() = default;
+  RheniumBrowserMainParts(const RheniumBrowserMainParts&) = delete;
+  RheniumBrowserMainParts& operator=(const RheniumBrowserMainParts&) = delete;
+  ~RheniumBrowserMainParts() override = default;
+
+  // Comme app_shell : préférences écrites avant l'arrêt du pool de threads,
+  // client des extensions retiré une fois les threads arrêtés.
+  void PostMainMessageLoopRun() override {
+    content::ShellBrowserMainParts::PostMainMessageLoopRun();
+    user_prefs_->CommitPendingWrite();
+    user_prefs_.reset();
+  }
+
+  void PostDestroyThreads() override {
+    extensions::ExtensionsBrowserClient::Set(nullptr);
+    extensions_browser_client_.reset();
+    content::ShellBrowserMainParts::PostDestroyThreads();
+  }
+
+ protected:
+  // Comme content_shell, avec les services d'extensions : les fabriques sont
+  // enregistrées et les préférences créées avant les services du contexte.
+  // Le contexte hors connexion n'a pas d'extensions.
+  void InitializeBrowserContexts() override {
+    extensions::ExtensionsClient::Set(GetExtensionsClient());
+    extensions_browser_client_ =
+        std::make_unique<extensions::RheniumExtensionsBrowserClient>();
+    extensions::ExtensionsBrowserClient::Set(extensions_browser_client_.get());
+    // Langue du téléphone pour les _locales des extensions (sinon « en »).
+    const std::string locale =
+        extensions_browser_client_->GetApplicationLocale();
+    extension_l10n_util::SetProcessLocale(locale);
+    extension_l10n_util::SetPreferredLocale(locale);
+    extensions::EnsureBrowserContextKeyedServiceFactoriesBuilt();
+    extensions::RheniumExtensionSystemFactory::GetInstance();
+
+    auto* context = new content::ShellBrowserContext(
+        /*off_the_record=*/false, /*delay_services_creation=*/true);
+    set_browser_context(context);
+    auto* off_the_record = new content::ShellBrowserContext(
+        /*off_the_record=*/true, /*delay_services_creation=*/true);
+    set_off_the_record_browser_context(off_the_record);
+
+    user_prefs_ = CreateUserPrefService(context);
+    extensions_browser_client_->InitWithBrowserContext(context,
+                                                       user_prefs_.get());
+    BrowserContextDependencyManager::GetInstance()
+        ->CreateBrowserContextServices(context);
+    context->GetOriginTrialsControllerDelegate();
+    off_the_record->GetOriginTrialsControllerDelegate();
+  }
+
+  // Extensions du paquet (dossier Extensions à côté de l'exécutable) et du
+  // Web Store.
+  void InitializeMessageLoopContext() override {
+    content::BrowserContext* context = browser_context();
+    // Une page masquée ne reçoit plus d'images : un défilement lancé juste
+    // avant reste actif, et ce contrôle de débogage plante l'app quand la
+    // page est fermée plus d'une minute après.
+    ui::CompositorAnimationObserver::DisableCheckActiveDuration();
+    auto* system = static_cast<extensions::RheniumExtensionSystem*>(
+        extensions::ExtensionSystem::Get(context));
+    system->InitForRegularProfile(/*extensions_enabled=*/true);
+
+    base::FilePath assets;
+    base::PathService::Get(base::DIR_ASSETS, &assets);
+    {
+      // Extensions déjà installées : chargées avant la première page, pour
+      // que leurs règles s'appliquent dès elle.
+      base::ScopedAllowBlockingForTesting allow_blocking;
+      base::FileEnumerator dirs(assets.AppendASCII("Extensions"),
+                                /*recursive=*/false,
+                                base::FileEnumerator::DIRECTORIES);
+      for (base::FilePath dir = dirs.Next(); !dir.empty(); dir = dirs.Next())
+        system->InstallBundledExtension(dir);
+      system->LoadWebStoreExtensions();
+    }
+    system->FinishInitialization();
+    SetExtensionContext(context);
+    WatchDownloads(context);
+    // Après la première page, pour ne pas la ralentir.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, base::BindOnce(&WakeServiceWorkers, base::Unretained(context)),
+        base::Seconds(5));
+
+    content::ShellBrowserMainParts::InitializeMessageLoopContext();
+  }
+
+ private:
+  std::unique_ptr<extensions::RheniumExtensionsBrowserClient>
+      extensions_browser_client_;
+  std::unique_ptr<PrefService> user_prefs_;
+};
+
+const Extension* GetExtensionForSite(content::SiteInstance* site_instance) {
+  return extensions::ExtensionRegistry::Get(site_instance->GetBrowserContext())
+      ->enabled_extensions()
+      .GetExtensionOrAppByURL(site_instance->GetSiteURL());
+}
+
+// d'après extensions::ShellContentBrowserClient d'app_shell.
+class RheniumContentBrowserClient : public content::ShellContentBrowserClient {
+ public:
+  std::unique_ptr<content::BrowserMainParts> CreateBrowserMainParts(
+      bool is_integration_test) override {
+    auto parts = std::make_unique<RheniumBrowserMainParts>();
+    set_browser_main_parts(parts.get());
+    return parts;
+  }
+
+  void RenderProcessWillLaunch(content::RenderProcessHost* host) override {
+    const int id = host->GetID();
+    content::BrowserContext* context = host->GetBrowserContext();
+    host->AddFilter(new extensions::ExtensionMessageFilter(id, context));
+    host->AddFilter(new extensions::MessagingAPIMessageFilter(id, context));
+    // Acquittements des événements livrés aux service workers : sans eux,
+    // celui de l'extension reste retenu jusqu'à l'expiration de la requête.
+    host->AddFilter(new extensions::ExtensionServiceWorkerMessageFilter(
+        id, context, host->GetStoragePartition()->GetServiceWorkerContext()));
+    host->AddFilter(new extensions::RheniumL10nMessageFilter(context));
+  }
+
+  // Un seul processus de rendu : il héberge l'extension dès qu'une de ses
+  // pages ou son service worker y tourne.
+  void SiteInstanceGotProcess(content::SiteInstance* site_instance) override {
+    if (const Extension* extension = GetExtensionForSite(site_instance)) {
+      extensions::ProcessMap::Get(site_instance->GetBrowserContext())
+          ->Insert(extension->id(), site_instance->GetProcess()->GetID());
+    }
+  }
+
+  bool IsHandledURL(const GURL& url) override {
+    return content::ShellContentBrowserClient::IsHandledURL(url) ||
+           url.SchemeIs(extensions::kExtensionScheme);
+  }
+
+  // Pas de fenêtre sans geste de l'utilisateur : ce sont surtout des
+  // publicités. Au-delà de rhenium::kMaxTabs, le lien s'ouvre dans son
+  // onglet.
+  bool CanCreateWindow(content::RenderFrameHost* opener,
+                       const GURL& opener_url,
+                       const GURL& opener_top_level_frame_url,
+                       const url::Origin& source_origin,
+                       content::mojom::WindowContainerType container_type,
+                       const GURL& target_url,
+                       const content::Referrer& referrer,
+                       const std::string& frame_name,
+                       WindowOpenDisposition disposition,
+                       const blink::mojom::WindowFeatures& features,
+                       bool user_gesture,
+                       bool opener_suppressed,
+                       bool* no_javascript_access) override {
+    if (!user_gesture) {
+      LOG(INFO) << "Rhenium : fenêtre sans geste bloquée, " << target_url;
+      return false;
+    }
+    if (rhenium::CanOpenTab())
+      return true;
+    content::WebContents* tab =
+        content::WebContents::FromRenderFrameHost(opener);
+    if (tab && target_url.is_valid() && !target_url.IsAboutBlank()) {
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              [](base::WeakPtr<content::WebContents> tab,
+                 content::OpenURLParams params) {
+                if (tab)
+                  tab->OpenURL(params);
+              },
+              tab->GetWeakPtr(),
+              content::OpenURLParams(target_url, referrer,
+                                     WindowOpenDisposition::CURRENT_TAB,
+                                     ui::PAGE_TRANSITION_LINK,
+                                     /*is_renderer_initiated=*/false)));
+    }
+    return false;
+  }
+
+  void GetAdditionalAllowedSchemesForFileSystem(
+      std::vector<std::string>* additional_allowed_schemes) override {
+    additional_allowed_schemes->push_back(extensions::kExtensionScheme);
+  }
+
+  void ExposeInterfacesToRenderer(
+      service_manager::BinderRegistry* registry,
+      blink::AssociatedInterfaceRegistry* associated_registry,
+      content::RenderProcessHost* host) override {
+    content::ShellContentBrowserClient::ExposeInterfacesToRenderer(
+        registry, associated_registry, host);
+    associated_registry->AddInterface<extensions::mojom::EventRouter>(
+        base::BindRepeating(&extensions::EventRouter::BindForRenderer,
+                            host->GetID()));
+    associated_registry->AddInterface<extensions::mojom::RendererHost>(
+        base::BindRepeating(&extensions::RendererStartupHelper::BindForRenderer,
+                            host->GetID()));
+    associated_registry->AddInterface<extensions::mojom::ServiceWorkerHost>(
+        base::BindRepeating(&extensions::ServiceWorkerHost::BindReceiver,
+                            host->GetID()));
+  }
+
+  void RegisterAssociatedInterfaceBindersForRenderFrameHost(
+      content::RenderFrameHost& render_frame_host,
+      blink::AssociatedInterfaceRegistry& associated_registry) override {
+    associated_registry.AddInterface<extensions::mojom::LocalFrameHost>(
+        base::BindRepeating(
+            [](content::RenderFrameHost* render_frame_host,
+               mojo::PendingAssociatedReceiver<extensions::mojom::LocalFrameHost>
+                   receiver) {
+              extensions::ExtensionWebContentsObserver::BindLocalFrameHost(
+                  std::move(receiver), render_frame_host);
+            },
+            &render_frame_host));
+  }
+
+  std::vector<std::unique_ptr<content::NavigationThrottle>>
+  CreateThrottlesForNavigation(
+      content::NavigationHandle* navigation_handle) override {
+    auto throttles =
+        content::ShellContentBrowserClient::CreateThrottlesForNavigation(
+            navigation_handle);
+    throttles.push_back(std::make_unique<extensions::ExtensionNavigationThrottle>(
+        navigation_handle));
+    if (auto pdf = rhenium::MaybeCreatePdfThrottle(navigation_handle))
+      throttles.push_back(std::move(pdf));
+    return throttles;
+  }
+
+  // Comme Chrome : les cookies SameSite accompagnent les requêtes d'une page
+  // d'extension, celles de la liseuse PDF par exemple.
+  bool ShouldTreatURLSchemeAsFirstPartyWhenTopLevel(
+      base::StringPiece scheme,
+      bool is_embedded_origin_secure) override {
+    return scheme == extensions::kExtensionScheme ||
+           content::ShellContentBrowserClient::
+               ShouldTreatURLSchemeAsFirstPartyWhenTopLevel(
+                   scheme, is_embedded_origin_secure);
+  }
+
+  void RegisterNonNetworkNavigationURLLoaderFactories(
+      int frame_tree_node_id,
+      ukm::SourceIdObj ukm_source_id,
+      NonNetworkURLLoaderFactoryMap* factories) override {
+    content::WebContents* web_contents =
+        content::WebContents::FromFrameTreeNodeId(frame_tree_node_id);
+    factories->emplace(extensions::kExtensionScheme,
+                       extensions::CreateExtensionNavigationURLLoaderFactory(
+                           web_contents->GetBrowserContext(), ukm_source_id,
+                           /*is_web_view_request=*/false));
+  }
+
+  void RegisterNonNetworkWorkerMainResourceURLLoaderFactories(
+      content::BrowserContext* browser_context,
+      NonNetworkURLLoaderFactoryMap* factories) override {
+    factories->emplace(
+        extensions::kExtensionScheme,
+        extensions::CreateExtensionWorkerMainResourceURLLoaderFactory(
+            browser_context));
+  }
+
+  void RegisterNonNetworkServiceWorkerUpdateURLLoaderFactories(
+      content::BrowserContext* browser_context,
+      NonNetworkURLLoaderFactoryMap* factories) override {
+    factories->emplace(
+        extensions::kExtensionScheme,
+        extensions::CreateExtensionServiceWorkerScriptURLLoaderFactory(
+            browser_context));
+  }
+
+  void RegisterNonNetworkSubresourceURLLoaderFactories(
+      int render_process_id,
+      int render_frame_id,
+      const absl::optional<url::Origin>& request_initiator_origin,
+      NonNetworkURLLoaderFactoryMap* factories) override {
+    factories->emplace(extensions::kExtensionScheme,
+                       extensions::CreateExtensionURLLoaderFactory(
+                           render_process_id, render_frame_id));
+  }
+
+  // Les requêtes passent par le proxy de webRequest, qui applique les
+  // règles declarativeNetRequest.
+  bool WillCreateURLLoaderFactory(
+      content::BrowserContext* browser_context,
+      content::RenderFrameHost* frame,
+      int render_process_id,
+      URLLoaderFactoryType type,
+      const url::Origin& request_initiator,
+      absl::optional<int64_t> navigation_id,
+      ukm::SourceIdObj ukm_source_id,
+      mojo::PendingReceiver<network::mojom::URLLoaderFactory>*
+          factory_receiver,
+      mojo::PendingRemote<network::mojom::TrustedURLLoaderHeaderClient>*
+          header_client,
+      bool* bypass_redirect_checks,
+      bool* disable_secure_dns,
+      network::mojom::URLLoaderFactoryOverridePtr* factory_override,
+      scoped_refptr<base::SequencedTaskRunner>
+          navigation_response_task_runner) override {
+    auto* web_request_api = extensions::BrowserContextKeyedAPIFactory<
+        extensions::WebRequestAPI>::Get(browser_context);
+    const bool use_proxy = web_request_api->MaybeProxyURLLoaderFactory(
+        browser_context, frame, render_process_id, type,
+        std::move(navigation_id), ukm_source_id, factory_receiver,
+        header_client, std::move(navigation_response_task_runner));
+    if (bypass_redirect_checks)
+      *bypass_redirect_checks = use_proxy;
+    return use_proxy;
+  }
+
+  void OverrideURLLoaderFactoryParams(
+      content::BrowserContext* browser_context,
+      const url::Origin& origin,
+      bool is_for_isolated_world,
+      network::mojom::URLLoaderFactoryParams* factory_params) override {
+    content::ShellContentBrowserClient::OverrideURLLoaderFactoryParams(
+        browser_context, origin, is_for_isolated_world, factory_params);
+    extensions::URLLoaderFactoryManager::OverrideURLLoaderFactoryParams(
+        browser_context, origin, is_for_isolated_world, factory_params);
+  }
+
+  void OnWebContentsCreated(content::WebContents* web_contents) override {
+    extensions::RheniumExtensionWebContentsObserver::CreateForWebContents(
+        web_contents);
+  }
+};
+
+class RheniumExtensionsRendererClient
+    : public extensions::ExtensionsRendererClient {
+ public:
+  RheniumExtensionsRendererClient()
+      : dispatcher_(std::make_unique<extensions::Dispatcher>(
+            std::make_unique<extensions::DispatcherDelegate>())) {
+    dispatcher_->OnRenderThreadStarted(content::RenderThread::Get());
+  }
+
+  bool IsIncognitoProcess() const override { return false; }
+  int GetLowestIsolatedWorldId() const override { return 1; }
+  extensions::Dispatcher* GetDispatcher() override { return dispatcher_.get(); }
+
+  // Comme ChromeExtensionsRendererClient : les API ne sont exposées qu'au
+  // service worker d'arrière-plan déclaré par l'extension.
+  bool ExtensionAPIEnabledForServiceWorkerScript(
+      const GURL& scope,
+      const GURL& script_url) const override {
+    if (!script_url.SchemeIs(extensions::kExtensionScheme))
+      return false;
+    const Extension* extension =
+        extensions::RendererExtensionRegistry::Get()->GetExtensionOrAppByURL(
+            script_url);
+    if (!extension ||
+        !extensions::BackgroundInfo::IsServiceWorkerBased(extension) ||
+        scope != extension->url()) {
+      return false;
+    }
+    return extension->GetResourceURL(
+               extensions::BackgroundInfo::GetBackgroundServiceWorkerScript(
+                   extension)) == script_url;
+  }
+
+ private:
+  std::unique_ptr<extensions::Dispatcher> dispatcher_;
+};
