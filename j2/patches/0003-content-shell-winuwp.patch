+// found in the LICENSE file.
+
+#ifndef EXTENSIONS_RHENIUM_RHENIUM_SCRIPTING_API_H_
+#define EXTENSIONS_RHENIUM_RHENIUM_SCRIPTING_API_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "absl/types/optional.h"
+#include "extensions/browser/extension_function.h"
+#include "extensions/browser/script_executor.h"
+#include "extensions/common/mojom/code_injection.mojom.h"
+
+namespace extensions {
+
+// Rhénium : chrome.scripting réduit à ce qu'appelle uBlock Origin Lite
+// (api/scripting.json), d'après chrome/browser/extensions/api/scripting. Les
+// scripts dynamiques passent par l'ExtensionUserScriptLoader de //extensions,
+// sans être conservés (pas de StateStore) : uBO Lite les réenregistre au
+// démarrage de son service worker.
+
+class ScriptingExecuteScriptFunction : public ExtensionFunction {
+ public:
+  DECLARE_EXTENSION_FUNCTION("scripting.executeScript",
+                             SCRIPTING_EXECUTESCRIPT)
+
+ private:
+  ~ScriptingExecuteScriptFunction() override;
+  ResponseAction Run() override;
+  // Fichiers lus : leur code, ou un message d'erreur.
+  void OnFilesRead(std::vector<mojom::JSSourcePtr> sources, std::string error);
+  // Respond() ou pas : le code part dans les cadres visés.
+  void Execute(std::vector<mojom::JSSourcePtr> sources);
+  void OnExecuted(std::vector<ScriptExecutor::FrameResult> results);
+
+  int tab_id_ = -1;
+  std::vector<int> frame_ids_;
+  bool all_frames_ = false;
+  bool main_world_ = false;
+  bool inject_immediately_ = false;
+  std::unique_ptr<ScriptExecutor> executor_;
+};
+
+// insertCSS et removeCSS : même injection, opération différente.
+class ScriptingCSSFunction : public ExtensionFunction {
+ protected:
+  ~ScriptingCSSFunction() override;
+  ResponseAction RunCSS(mojom::CSSInjection::Operation operation);
+
+ private:
+  void OnDone(std::vector<ScriptExecutor::FrameResult> results);
+
+  std::unique_ptr<ScriptExecutor> executor_;
+};
+
+class ScriptingInsertCSSFunction : public ScriptingCSSFunction {
+ public:
+  DECLARE_EXTENSION_FUNCTION("scripting.insertCSS", SCRIPTING_INSERTCSS)
+
+ private:
+  ~ScriptingInsertCSSFunction() override = default;
+  ResponseAction Run() override;
+};
+
+class ScriptingRemoveCSSFunction : public ScriptingCSSFunction {
+ public:
+  DECLARE_EXTENSION_FUNCTION("scripting.removeCSS", SCRIPTING_REMOVECSS)
+
+ private:
+  ~ScriptingRemoveCSSFunction() override = default;
+  ResponseAction Run() override;
+};
+
+class ScriptingRegisterContentScriptsFunction : public ExtensionFunction {
+ public:
+  DECLARE_EXTENSION_FUNCTION("scripting.registerContentScripts",
+                             SCRIPTING_REGISTERCONTENTSCRIPTS)
+
+ private:
+  ~ScriptingRegisterContentScriptsFunction() override = default;
+  ResponseAction Run() override;
+  void OnDone(const absl::optional<std::string>& error);
+};
+
+class ScriptingGetRegisteredContentScriptsFunction : public ExtensionFunction {
+ public:
+  DECLARE_EXTENSION_FUNCTION("scripting.getRegisteredContentScripts",
+                             SCRIPTING_GETREGISTEREDCONTENTSCRIPTS)
+
+ private:
+  ~ScriptingGetRegisteredContentScriptsFunction() override = default;
+  ResponseAction Run() override;
+};
+
+class ScriptingUnregisterContentScriptsFunction : public ExtensionFunction {
+ public:
+  DECLARE_EXTENSION_FUNCTION("scripting.unregisterContentScripts",
+                             SCRIPTING_UNREGISTERCONTENTSCRIPTS)
+
+ private:
+  ~ScriptingUnregisterContentScriptsFunction() override = default;
+  ResponseAction Run() override;
+  void OnDone(const absl::optional<std::string>& error);
+};
+
+}  // namespace extensions
+
+#endif  // EXTENSIONS_RHENIUM_RHENIUM_SCRIPTING_API_H_
diff --git a/extensions/rhenium/rhenium_tab_model.cc b/extensions/rhenium/rhenium_tab_model.cc
new file mode 100644
index 0000000000..be477da102
--- /dev/null
+++ b/extensions/rhenium/rhenium_tab_model.cc
@@ -0,0 +1,612 @@
+// Copyright 2026 Doalo
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "extensions/rhenium/rhenium_tab_model.h"
+
+#include <algorithm>
+#include <string>
+#include <vector>
+
+#include "base/auto_reset.h"
+#include "base/containers/contains.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/memory/raw_ptr.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/string_util_win.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+#include "components/version_info/version_info.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/render_widget_host_view.h"
+#include "content/public/browser/site_instance.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/shell/browser/shell.h"
+#include "content/shell/browser/shell_uwp_host.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/common/api/extension_action/action_info.h"
+#include "extensions/common/extension.h"
+#include "extensions/common/manifest_handlers/options_page_info.h"
+#include "extensions/rhenium/rhenium_pdf.h"
+#include "third_party/blink/public/common/user_agent/user_agent_metadata.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "ui/aura/window.h"
+#include "ui/gfx/geometry/rect.h"
+#include "url/gurl.h"
+
+namespace rhenium {
+
+namespace {
+
+// Largeur des aperçus en pixels, pour une demi-largeur d'écran nette.
+constexpr int kThumbnailWidth = 300;
+
+struct Tab {
+  int id;
+  raw_ptr<content::Shell> shell;
+  int opener_id;  // onglet du lien qui l'a ouvert, 0 sinon
+  // Onglet restauré pas encore chargé : sa page et son titre.
+  GURL pending_url;
+  std::u16string pending_title;
+  // Page déchargée faute de mémoire, rechargée à l'activation.
+  bool discarded = false;
+  base::TimeTicks last_active;
+};
+
+// Qui crée le prochain Shell.
+enum class Creator { kPage, kUser, kRestore, kOverlay, kDiscard };
+
+TabObserver g_observer;
+std::vector<Tab>& Tabs() {
+  static base::NoDestructor<std::vector<Tab>> tabs;
+  return *tabs;
+}
+int g_active_id = 0;
+int g_next_id = 1;
+Creator g_creator = Creator::kPage;
+int g_discarded_id = 0;  // onglet dont le Shell est remplacé (kDiscard)
+content::Shell* g_overlay = nullptr;
+bool g_app_visible = true;
+
+Tab* FindTab(int id) {
+  for (Tab& tab : Tabs()) {
+    if (tab.id == id)
+      return &tab;
+  }
+  return nullptr;
+}
+
+Tab* FindTab(content::WebContents* web_contents) {
+  for (Tab& tab : Tabs()) {
+    if (web_contents && tab.shell->web_contents() == web_contents)
+      return &tab;
+  }
+  return nullptr;
+}
+
+Tab* ActiveTab() {
+  return FindTab(g_active_id);
+}
+
+void NotifyTabs() {
+  if (g_observer.tabs_changed)
+    g_observer.tabs_changed(g_observer.context,
+                            static_cast<int>(Tabs().size()));
+}
+
+std::wstring Wide(const GURL& url) {
+  return base::UTF8ToWide(url.spec());
+}
+
+// Le Chrome Web Store renvoie les navigateurs mobiles vers /unsupported : il
+// reçoit l'agent utilisateur de Chrome pour Windows.
+bool IsWebStore(const GURL& url) {
+  return url.SchemeIs(url::kHttpsScheme) &&
+         (url.host_piece() == "chromewebstore.google.com" ||
+          (url.host_piece() == "chrome.google.com" &&
+           base::StartsWith(url.path_piece(), "/webstore")));
+}
+
+std::string DesktopUserAgent() {
+  return "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
+         "(KHTML, like Gecko) Chrome/" +
+         std::string(version_info::GetMajorVersionNumber()) +
+         ".0.0.0 Safari/537.36";
+}
+
+// Suit une page d'onglet pour l'historique, l'agent utilisateur du Web Store
+// et sa destruction.
+class TabWatcher : public content::WebContentsObserver {
+ public:
+  TabWatcher(content::WebContents* web_contents, int id)
+      : content::WebContentsObserver(web_contents), id_(id) {
+    web_contents->SetUserAgentOverride(
+        blink::UserAgentOverride::UserAgentOnly(DesktopUserAgent()),
+        /*override_in_new_tabs=*/false);
+  }
+
+ private:
+  void DidStartNavigation(content::NavigationHandle* handle) override {
+    if (handle->IsInPrimaryMainFrame())
+      handle->SetIsOverridingUserAgent(IsWebStore(handle->GetURL()));
+  }
+
+  void DidFinishNavigation(content::NavigationHandle* handle) override {
+    if (handle->IsInPrimaryMainFrame() && handle->HasCommitted() &&
+        !handle->IsErrorPage()) {
+      Visit(web_contents()->GetController().GetLastCommittedEntry());
+    }
+  }
+
+  void TitleWasSet(content::NavigationEntry* entry) override {
+    if (entry == web_contents()->GetController().GetLastCommittedEntry())
+      Visit(entry);
+  }
+
+  void Visit(content::NavigationEntry* entry) {
+    if (!g_observer.page_visited || !entry)
+      return;
+    const GURL url = PdfSourceUrl(entry->GetURL());
+    if (!url.SchemeIsHTTPOrHTTPS())
+      return;
+    g_observer.page_visited(g_observer.context, Wide(url).c_str(),
+                            base::AsWString(entry->GetTitle()).c_str());
+  }
+
+  // Fermé hors du modèle : arrêt du moteur. Pas l'ancienne page d'un onglet
+  // déchargé, dont le Shell est déjà remplacé.
+  void WebContentsDestroyed() override {
+    std::vector<Tab>& tabs = Tabs();
+    for (auto it = tabs.begin(); it != tabs.end(); ++it) {
+      if (it->id == id_ && it->shell->web_contents() == web_contents()) {
+        tabs.erase(it);
+        break;
+      }
+    }
+    if (g_active_id == id_)
+      g_active_id = 0;
+    delete this;
+  }
+
+  const int id_;
+};
+
+// Suit la fermeture de la page d'extension (bouton retour, window.close()).
+class OverlayWatcher : public content::WebContentsObserver {
+ public:
+  explicit OverlayWatcher(content::Shell* shell)
+      : content::WebContentsObserver(shell->web_contents()), shell_(shell) {}
+
+ private:
+  void DidFinishNavigation(content::NavigationHandle* handle) override {
+    if (handle->IsInPrimaryMainFrame()) {
+      LOG(INFO) << "Rhenium : panneau " << handle->GetURL().spec()
+                << ", erreur " << handle->GetNetErrorCode();
+    }
+  }
+
+  void DidFinishLoad(content::RenderFrameHost* frame,
+                     const GURL& url) override {
+    LOG(INFO) << "Rhenium : panneau chargé " << url.spec();
+  }
+
+  void PrimaryMainFrameRenderProcessGone(
+      base::TerminationStatus status) override {
+    LOG(ERROR) << "Rhenium : moteur du panneau perdu " << status;
+  }
+
+  void WebContentsDestroyed() override {
+    if (g_overlay == shell_)  // pas déjà détachée par CloseOverlay()
+      g_overlay = nullptr;
+    delete this;
+  }
+
+  const raw_ptr<content::Shell> shell_;
+};
+
+// Détruit plus tard : l'appel peut venir de la page elle-même
+// (window.close(), chrome.tabs), qui ne doit pas disparaître pendant qu'elle
+// s'exécute.
+void CloseLater(content::Shell* shell) {
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](content::Shell* shell) {
+                       if (base::Contains(content::Shell::windows(), shell))
+                         shell->Close();
+                     },
+                     shell));
+}
+
+void OnThumbnail(int id, const SkBitmap& bitmap) {
+  if (!FindTab(id))
+    return;
+  if (bitmap.drawsNothing() || bitmap.colorType() != kBGRA_8888_SkColorType) {
+    LOG(WARNING) << "Rhenium : pas d'aperçu pour l'onglet " << id;
+    return;
+  }
+  g_observer.tab_thumbnail(g_observer.context, id,
+                           static_cast<const uint8_t*>(bitmap.getPixels()),
+                           bitmap.width(), bitmap.height(),
+                           static_cast<int>(bitmap.rowBytes()));
+}
+
+// Aperçu carré du haut de la page.
+void Capture(const Tab& tab) {
+  if (!g_observer.tab_thumbnail)
+    return;
+  content::RenderWidgetHostView* view =
+      tab.shell->web_contents()->GetRenderWidgetHostView();
+  if (!view || !view->IsSurfaceAvailableForCopy())
+    return;
+  const gfx::Size size = view->GetViewBounds().size();
+  if (size.IsEmpty())
+    return;
+  const gfx::Rect source(size.width(), std::min(size.width(), size.height()));
+  view->CopyFromSurface(
+      source,
+      gfx::Size(kThumbnailWidth,
+                kThumbnailWidth * source.height() / source.width()),
+      base::BindOnce(&OnThumbnail, tab.id));
+}
+
+void Hide(content::Shell* shell) {
+  shell->web_contents()->GetNativeView()->Hide();
+  shell->web_contents()->WasHidden();
+}
+
+void Activate(Tab& tab) {
+  CloseOverlay();
+  if (Tab* previous = ActiveTab(); previous && previous != &tab)
+    Capture(*previous);
+  for (Tab& other : Tabs()) {
+    if (other.id != tab.id)
+      Hide(other.shell);
+  }
+  g_active_id = tab.id;
+  tab.last_active = base::TimeTicks::Now();
+  LOG(INFO) << "Rhenium : onglet " << tab.id << " actif (" << Tabs().size()
+            << " onglets)";
+  if (tab.pending_url.is_valid()) {
+    tab.shell->LoadURL(tab.pending_url);
+    tab.pending_url = GURL();
+    tab.pending_title.clear();
+  }
+  if (tab.discarded) {
+    tab.discarded = false;
+    content::NavigationController& controller =
+        tab.shell->web_contents()->GetController();
+    controller.SetNeedsReload();
+    controller.LoadIfNecessary();
+  }
+  content::WebContents* web_contents = tab.shell->web_contents();
+  web_contents->GetNativeView()->Show();
+  if (g_app_visible)
+    web_contents->WasShown();
+  web_contents->Focus();
+  content::SetUwpActiveShell(tab.shell);
+  NotifyTabs();
+}
+
+void OnShellCreated(content::Shell* shell) {
+  if (g_creator == Creator::kOverlay)
+    return;
+  // À la taille de l'onglet actif : FillLayout ne suit pas les rotations.
+  if (Tab* active = ActiveTab()) {
+    shell->web_contents()->GetNativeView()->SetBounds(
+        active->shell->web_contents()->GetNativeView()->bounds());
+  }
+  if (g_creator == Creator::kDiscard) {
+    new TabWatcher(shell->web_contents(), g_discarded_id);
+    Hide(shell);
+    return;
+  }
+  const int id = g_next_id++;
+  const int opener_id = g_creator == Creator::kPage ? g_active_id : 0;
+  LOG(INFO) << "Rhenium : onglet " << id << " ouvert"
+            << (opener_id ? " par un lien de l'onglet " : "")
+            << (opener_id ? base::NumberToString(opener_id) : "");
+  Tabs().push_back({id, shell, opener_id});
+  Tabs().back().last_active = base::TimeTicks::Now();
+  new TabWatcher(shell->web_contents(), id);
+  if (g_creator == Creator::kRestore)
+    Hide(shell);
+  else
+    Activate(Tabs().back());
+}
+
+bool OnCloseRequested(content::Shell* shell) {
+  if (shell == g_overlay) {
+    CloseOverlay();
+    return true;
+  }
+  if (Tab* tab = FindTab(shell->web_contents())) {
+    CloseTab(tab->id);  // le dernier onglet reste
+    return true;
+  }
+  return false;
+}
+
+}  // namespace
+
+void InitTabs(const TabObserver& observer) {
+  g_observer = observer;
+  content::ShellUwpTabs tabs;
+  tabs.created = &OnShellCreated;
+  tabs.close_requested = &OnCloseRequested;
+  content::SetShellUwpTabs(tabs);
+}
+
+content::Shell* GetActiveShell() {
+  Tab* tab = ActiveTab();
+  return tab ? tab->shell.get() : nullptr;
+}
+
+content::WebContents* GetActiveWebContents() {
+  content::Shell* shell = GetActiveShell();
+  return shell ? shell->web_contents() : nullptr;
+}
+
+content::WebContents* GetOverlayWebContents() {
+  return g_overlay ? g_overlay->web_contents() : nullptr;
+}
+
+int GetTabCount() {
+  return static_cast<int>(Tabs().size());
+}
+
+content::WebContents* GetTabAt(int index) {
+  return Tabs()[index].shell->web_contents();
+}
+
+int GetTabId(content::WebContents* web_contents) {
+  Tab* tab = FindTab(web_contents);
+  return tab ? tab->id : -1;
+}
+
+
+content::WebContents* GetTabWebContents(int id) {
+  Tab* tab = FindTab(id);
+  return tab ? tab->shell->web_contents() : nullptr;
+}
+
+bool IsTabActive(int id) {
+  return id == g_active_id;
+}
+
+void ForEachTab(void (*visit)(void* context,
+                              int id,
+                              int active,
+                              const wchar_t* title,
+                              const wchar_t* url),
+                void* context) {
+  for (const Tab& tab : Tabs()) {
+    content::WebContents* web_contents = tab.shell->web_contents();
+    const bool pending = tab.pending_url.is_valid();
+    visit(context, tab.id, tab.id == g_active_id ? 1 : 0,
+          base::AsWString(pending ? tab.pending_title
+                                  : web_contents->GetTitle())
+              .c_str(),
+          Wide(pending ? tab.pending_url
+                       : PdfSourceUrl(web_contents->GetVisibleURL()))
+              .c_str());
+  }
+}
+
+bool CanOpenTab() {
+  return GetTabCount() < kMaxTabs;
+}
+
+bool OpenTab(const GURL& url) {
+  content::Shell* active = GetActiveShell();
+  if (!active || !url.is_valid() || !CanOpenTab())
+    return false;
+  base::AutoReset<Creator> creator(&g_creator, Creator::kUser);
+  content::Shell::CreateNewWindow(
+      active->web_contents()->GetBrowserContext(), url, nullptr,
+      active->web_contents()->GetNativeView()->bounds().size());
+  return true;
+}
+
+bool RestoreTab(const GURL& url, const std::u16string& title) {
+  content::Shell* active = GetActiveShell();
+  if (!active || !url.is_valid() || !CanOpenTab())
+    return false;
+  content::Shell* shell = nullptr;
+  {
+    base::AutoReset<Creator> creator(&g_creator, Creator::kRestore);
+    shell = content::Shell::CreateNewWindow(
+        active->web_contents()->GetBrowserContext(), GURL(), nullptr,
+        active->web_contents()->GetNativeView()->bounds().size());
+  }
+  Tab* tab = FindTab(shell->web_contents());
+  tab->pending_url = url;
+  tab->pending_title = title;
+  NotifyTabs();
+  return true;
+}
+
+void ActivateTab(int id) {
+  Tab* tab = FindTab(id);
+  if (tab && id != g_active_id)
+    Activate(*tab);
+}
+
+bool CloseTab(int id) {
+  std::vector<Tab>& tabs = Tabs();
+  Tab* tab = FindTab(id);
+  if (!tab || tabs.size() < 2)
+    return false;
+  if (id == g_active_id) {
+    // L'onglet du lien, sinon le voisin de droite, sinon celui de gauche.
+    Tab* next = FindTab(tab->opener_id);
+    if (!next)
+      next = tab + 1 < tabs.data() + tabs.size() ? tab + 1 : tab - 1;
+    Activate(*next);  // ne touche pas au vecteur : `tab` reste valide
+  }
+  content::Shell* shell = tab->shell;
+  LOG(INFO) << "Rhenium : onglet " << id << " fermé";
+  tabs.erase(tabs.begin() + (tab - tabs.data()));
+  Hide(shell);
+  CloseLater(shell);
+  NotifyTabs();
+  return true;
+}
+
+bool GoBack() {
+  if (IsOverlayOpen()) {
+    CloseOverlay();
+    return true;
+  }
+  Tab* tab = ActiveTab();
+  if (!tab)
+    return false;
+  content::NavigationController& controller =
+      tab->shell->web_contents()->GetController();
+  if (controller.CanGoBack()) {
+    controller.GoBack();
+    return true;
+  }
+  return FindTab(tab->opener_id) && CloseTab(tab->id);
+}
+
+bool DiscardTab() {
+  Tab* oldest = nullptr;
+  for (Tab& tab : Tabs()) {
+    if (tab.id != g_active_id && !tab.discarded &&
+        !tab.pending_url.is_valid() &&
+        (!oldest || tab.last_active < oldest->last_active)) {
+      oldest = &tab;
+    }
+  }
+  if (!oldest)
+    return false;
+  content::Shell* old = oldest->shell;
+  content::Shell* fresh = nullptr;
+  {
+    base::AutoReset<Creator> creator(&g_creator, Creator::kDiscard);
+    base::AutoReset<int> discarded_id(&g_discarded_id, oldest->id);
+    fresh = content::Shell::CreateNewWindow(
+        old->web_contents()->GetBrowserContext(), GURL(), nullptr,
+        old->web_contents()->GetNativeView()->bounds().size());
+  }
+  // Historique gardé : précédent et suivant marchent après le rechargement.
+  fresh->web_contents()->GetController().CopyStateFrom(
+      &old->web_contents()->GetController(), /*needs_reload=*/false);
+  oldest->shell = fresh;
+  oldest->discarded = true;
+  LOG(INFO) << "Rhenium : onglet " << oldest->id << " déchargé";
+  Hide(old);
+  CloseLater(old);
+  return true;
+}
+
+void CaptureActiveTab() {
+  if (Tab* tab = ActiveTab())
+    Capture(*tab);
+}
+
+void SetAppVisible(bool visible) {
+  g_app_visible = visible;
+  for (const Tab& tab : Tabs()) {
+    if (!visible)
+      tab.shell->web_contents()->WasHidden();
+    else if (tab.id == g_active_id)
+      tab.shell->web_contents()->WasShown();
+  }
+  if (content::WebContents* overlay = GetOverlayWebContents()) {
+    if (visible)
+      overlay->WasShown();
+    else
+      overlay->WasHidden();
+  }
+}
+
+bool OpenOverlay(content::BrowserContext* context, const GURL& url) {
+  if (!url.is_valid())
+    return false;
+  if (g_overlay) {
+    g_overlay->LoadURL(url);
+    return true;
+  }
+  content::WebContents* active = GetActiveWebContents();
+  if (!active)
+    return false;
+  const gfx::Rect bounds = active->GetNativeView()->bounds();
+  {
+    base::AutoReset<Creator> creator(&g_creator, Creator::kOverlay);
+    // Créé dans le site de l'extension : son premier cadre l'active dans le
+    // moteur de rendu (ExtensionWebContentsObserver::RenderFrameCreated).
+    // Créé vierge puis dirigé vers chrome-extension://, il restait une page
+    // ordinaire sans chrome.tabs ni chrome.runtime tant que le service
+    // worker de l'extension n'avait pas tourné.
+    g_overlay = content::Shell::CreateNewWindow(
+        context, url, content::SiteInstance::CreateForURL(context, url),
+        bounds.size());
+  }
+  g_overlay->web_contents()->GetNativeView()->SetBounds(bounds);
+  new OverlayWatcher(g_overlay);
+  g_overlay->web_contents()->Focus();
+  return true;
+}
+
+namespace {
+
+// Page donnée par `page_url` de la première extension activée qui en a une,
+// celles du paquet (uBlock Origin Lite) avant celles du Web Store.
+bool OpenExtensionPage(GURL (*page_url)(const extensions::Extension&)) {
+  content::WebContents* active = GetActiveWebContents();
+  if (!active)
+    return false;
+  content::BrowserContext* context = active->GetBrowserContext();
+  for (const bool bundled : {true, false}) {
+    for (const auto& extension :
+         extensions::ExtensionRegistry::Get(context)->enabled_extensions()) {
+      if ((extension->location() !=
+           extensions::mojom::ManifestLocation::kInternal) != bundled) {
+        continue;
+      }
+      const GURL url = page_url(*extension);
+      if (url.is_valid())
+        return OpenOverlay(context, url);
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+bool OpenActionPopup() {
+  return OpenExtensionPage([](const extensions::Extension& extension) {
+    const extensions::ActionInfo* action =
+        extensions::ActionInfo::GetExtensionActionInfo(&extension);
+    return action ? action->default_popup_url : GURL();
+  });
+}
+
+bool OpenOptionsPage() {
+  return OpenExtensionPage([](const extensions::Extension& extension) {
+    return extensions::OptionsPageInfo::GetOptionsPage(&extension);
+  });
+}
+
+// Détachée tout de suite, détruite ensuite (CloseLater).
+void CloseOverlay() {
+  if (!g_overlay)
+    return;
+  content::Shell* closing = g_overlay;
+  g_overlay = nullptr;
+  CloseLater(closing);
+}
+
+bool IsOverlayOpen() {
+  return g_overlay != nullptr;
+}
+
+}  // namespace rhenium
