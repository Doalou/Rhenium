+// Copyright 2026 Doalo
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef UI_PLATFORM_WINDOW_UWP_UWP_WINDOW_H_
+#define UI_PLATFORM_WINDOW_UWP_UWP_WINDOW_H_
+
+#include <windows.ui.core.h>
+#include <wrl/client.h>
+
+#include "base/containers/flat_set.h"
+#include "ui/events/types/event_type.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/sequential_id_generator.h"
+#include "ui/platform_window/stub/stub_window.h"
+
+namespace ui {
+
+// Rhénium : fenêtre de plateforme d'une app UWP. Elle occupe toute la
+// CoreWindow du thread UI, quelle que soit la taille demandée, et la donne au
+// compositeur comme widget (voir ui/gfx/win/uwp_core_window.h et
+// components/viz/service/display_embedder/software_output_device_uwp.h).
+// Les pointeurs de la CoreWindow deviennent des événements tactiles (toucher,
+// stylet) ou souris. Titre, curseur, capture et activation restent ceux de
+// StubWindow. En mode hébergé, sa taille suit la zone de contenu de la coquille.
+class UwpWindow : public StubWindow {
+ public:
+  explicit UwpWindow(PlatformWindowDelegate* delegate);
+  UwpWindow(const UwpWindow&) = delete;
+  UwpWindow& operator=(const UwpWindow&) = delete;
+  ~UwpWindow() override;
+
+ private:
+  // PlatformWindow:
+  void SetBoundsInPixels(const gfx::Rect& bounds) override;
+  gfx::Rect GetBoundsInPixels() const override;
+  void SetBoundsInDIP(const gfx::Rect& bounds) override;
+  gfx::Rect GetBoundsInDIP() const override;
+
+  void SubscribePointerEvents();
+  HRESULT OnPointer(EventType touch_type,
+                    ABI::Windows::UI::Core::IPointerEventArgs* args);
+  friend void DispatchHostedPointer(EventType, uint32_t, float, float, bool);
+  friend void ResizeHostedWindow();
+  void UpdateBounds();
+  void OnPointerAt(EventType touch_type,
+                   uint32_t id,
+                   float x_dip,
+                   float y_dip,
+                   bool is_mouse);
+  void CancelTouches();
+  HRESULT OnKey(EventType type, ABI::Windows::UI::Core::IKeyEventArgs* args);
+
+  gfx::Rect bounds_;
+  float scale_ = 1.0f;
+  Microsoft::WRL::ComPtr<ABI::Windows::UI::Core::ICoreWindow> core_window_;
+  EventRegistrationToken pressed_token_ = {};
+  EventRegistrationToken moved_token_ = {};
+  EventRegistrationToken released_token_ = {};
+  EventRegistrationToken capture_lost_token_ = {};
+  EventRegistrationToken key_down_token_ = {};
+  EventRegistrationToken key_up_token_ = {};
+  base::flat_set<uint32_t> active_touches_;
+  // Les identifiants de pointeur de Windows (648…) deviennent des numéros de
+  // toucher de 0 à 31, la limite de Chromium.
+  SequentialIDGenerator touch_ids_{0};
+  bool mouse_pressed_ = false;
+};
+
+// Mode hébergé (coquille XAML, ui/gfx/win/uwp_core_window.h) : les pointeurs
+// du SwapChainPanel arrivent par la coquille, en DIP, et les touches de la
+// CoreWindow ne vont à la page que si elle a le clavier.
+void DispatchHostedPointer(EventType touch_type,
+                           uint32_t id,
+                           float x_dip,
+                           float y_dip,
+                           bool is_mouse);
+void SetHostedWebFocus(bool focused);
+// La zone de contenu a changé de taille (gfx::uwp::UpdateHostedSize).
+void ResizeHostedWindow();
+
+}  // namespace ui
+
+#endif  // UI_PLATFORM_WINDOW_UWP_UWP_WINDOW_H_
