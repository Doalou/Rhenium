+// Copyright 2026 Doalo
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef UI_GFX_WIN_UWP_CORE_WINDOW_H_
+#define UI_GFX_WIN_UWP_CORE_WINDOW_H_
+
+#include <unknwn.h>
+#include <wrl/client.h>
+
+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/gfx_export.h"
+
+namespace gfx::uwp {
+
+// Rhénium : la CoreWindow de l'app UWP tient lieu de HWND. Lue sur le thread
+// UI (celui de la CoreWindow), elle est gardée pour la sortie du compositeur,
+// qui tourne sur un autre thread.
+
+// Taille de la CoreWindow en pixels et facteur d'échelle de l'écran. À appeler
+// sur le thread UI ; garde aussi la CoreWindow. Faux sans CoreWindow.
+GFX_EXPORT bool GetCoreWindowMetrics(gfx::Size* pixel_size, float* scale);
+
+// CoreWindow gardée par GetCoreWindowMetrics (nulle avant), utilisable depuis
+// tout thread.
+GFX_EXPORT Microsoft::WRL::ComPtr<IUnknown> GetCoreWindow();
+
+// Mode hébergé : une coquille XAML affiche le moteur dans un SwapChainPanel.
+// La zone de contenu remplace alors la CoreWindow dans GetCoreWindowMetrics,
+// et la swap chain du compositeur est créée pour la composition puis confiée
+// à la coquille par |attacher| (appelé depuis le thread du compositeur).
+using SwapChainAttacher = void (*)(void* context, IUnknown* swap_chain);
+GFX_EXPORT void SetHostedContentArea(const gfx::Size& pixel_size,
+                                     float scale,
+                                     SwapChainAttacher attacher,
+                                     void* context);
+// Nouvelle taille de la zone de contenu (rotation, clavier, boutons du
+// téléphone), à la même échelle.
+GFX_EXPORT void UpdateHostedSize(const gfx::Size& pixel_size);
+GFX_EXPORT bool IsHosted();
+GFX_EXPORT float GetHostedScale();
+GFX_EXPORT void AttachSwapChain(IUnknown* swap_chain);
+
+}  // namespace gfx::uwp
+
+#endif  // UI_GFX_WIN_UWP_CORE_WINDOW_H_
