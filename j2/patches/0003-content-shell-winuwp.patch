@@ -0,0 +1,106 @@
+// Copyright 2026 Doalo
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef EXTENSIONS_RHENIUM_RHENIUM_TAB_MODEL_H_
+#define EXTENSIONS_RHENIUM_RHENIUM_TAB_MODEL_H_
+
+#include <stdint.h>
+
+#include <string>
+
+class GURL;
+
+namespace content {
+class BrowserContext;
+class Shell;
+class WebContents;
+}  // namespace content
+
+namespace rhenium {
+
+// Onglets de Rhénium : un Shell de content_shell par onglet, tous dans la même
+// fenêtre Aura, seul l'actif visible. Les pages d'extension (popup, options)
+// s'ouvrent dans un Shell de plus, posé sur l'onglet actif, qui n'est pas un
+// onglet. Tout s'appelle sur le thread UI.
+constexpr int kWindowId = 1;
+// Au-delà, un lien qui ouvrirait un onglet s'ouvre dans le sien : chaque
+// onglet garde sa page en mémoire, dans le seul processus de l'app.
+constexpr int kMaxTabs = 8;
+
+// Rappels vers la coquille.
+struct TabObserver {
+  void* context = nullptr;
+  // Onglet ouvert, fermé ou activé.
+  void (*tabs_changed)(void* context, int count) = nullptr;
+  // Page http(s) chargée dans un onglet, puis de nouveau quand son titre
+  // arrive.
+  void (*page_visited)(void* context,
+                       const wchar_t* url,
+                       const wchar_t* title) = nullptr;
+  // Aperçu d'un onglet, BGRA, sur le thread UI.
+  void (*tab_thumbnail)(void* context,
+                        int id,
+                        const uint8_t* bgra,
+                        int width,
+                        int height,
+                        int stride) = nullptr;
+};
+
+// À appeler avant la création du premier Shell.
+void InitTabs(const TabObserver& observer);
+
+content::Shell* GetActiveShell();
+content::WebContents* GetActiveWebContents();
+content::WebContents* GetOverlayWebContents();
+
+int GetTabCount();
+content::WebContents* GetTabAt(int index);
+// Identifiant de l'onglet (pour chrome.tabs), -1 s'il n'en est pas un.
+int GetTabId(content::WebContents* web_contents);
+content::WebContents* GetTabWebContents(int id);
+bool IsTabActive(int id);
+
+// Parcourt les onglets dans l'ordre.
+void ForEachTab(void (*visit)(void* context,
+                              int id,
+                              int active,
+                              const wchar_t* title,
+                              const wchar_t* url),
+                void* context);
+
+bool CanOpenTab();
+// Nouvel onglet actif ; faux au-delà de kMaxTabs.
+bool OpenTab(const GURL& url);
+// Onglet d'une session précédente, en arrière-plan : sa page ne se charge
+// qu'à son activation. Faux au-delà de kMaxTabs.
+bool RestoreTab(const GURL& url, const std::u16string& title);
+void ActivateTab(int id);
+// Faux pour le dernier onglet, qui reste.
+bool CloseTab(int id);
+// Précédent dans l'onglet actif ; à défaut, ferme l'onglet ouvert par un lien
+// et revient à celui du lien. Faux s'il n'y a rien à faire.
+bool GoBack();
+// Mémoire critique : décharge la page de l'onglet inactif utilisé le moins
+// récemment, qui garde son historique et se recharge à son activation. Faux
+// s'il n'y en a plus.
+bool DiscardTab();
+// Demande un aperçu de l'onglet actif (rappel tab_thumbnail).
+void CaptureActiveTab();
+
+// App visible ou masquée : seuls l'onglet actif et la page d'extension
+// s'affichent.
+void SetAppVisible(bool visible);
+
+// Ouvre (ou remplace) la page d'extension par-dessus l'onglet.
+bool OpenOverlay(content::BrowserContext* context, const GURL& url);
+// Popup de l'action, ou page d'options, de la première extension qui en a
+// (celles du paquet d'abord).
+bool OpenActionPopup();
+bool OpenOptionsPage();
+void CloseOverlay();
+bool IsOverlayOpen();
+
+}  // namespace rhenium
+
+#endif  // EXTENSIONS_RHENIUM_RHENIUM_TAB_MODEL_H_
