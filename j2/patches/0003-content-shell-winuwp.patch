+// Comme app_shell : runtime.sendMessage et connect passent par
+// MessageService, qui exige un délégué (le comportement par défaut suffit,
+// sans messagerie native ni onglets d'autres profils).
+// L'expéditeur d'un message venu d'un onglet porte cet onglet (sender.tab) :
+// uBO Lite en a besoin pour son insertCSS.
+class RheniumMessagingDelegate : public MessagingDelegate {
+ public:
