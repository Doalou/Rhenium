+void RheniumExtensionsBrowserClient::BroadcastEventToRenderers(
+    events::HistogramValue histogram_value,
+    const std::string& event_name,
+    base::Value::List args,
+    bool dispatch_to_off_the_record_profiles) {
+  if (!content::BrowserThread::CurrentlyOn(content::BrowserThread::UI)) {
+    content::GetUIThreadTaskRunner({})->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            &RheniumExtensionsBrowserClient::BroadcastEventToRenderers,
+            base::Unretained(this), histogram_value, event_name,
+            std::move(args), dispatch_to_off_the_record_profiles));
+    return;
+  }
+  EventRouter::Get(browser_context_)
+      ->BroadcastEvent(std::make_unique<Event>(histogram_value, event_name,
+                                               std::move(args)));
