+namespace extensions {
+
+class AppSorting;
+struct PreparedExtension;
+class QuotaService;
+class ServiceWorkerManager;
+class StateStore;
+class UserScriptManager;
+
+// Rhénium : système d'extensions d'après ShellExtensionSystem d'app_shell.
+// Les extensions intégrées au paquet (lecture seule) sont recopiées dans le
+// profil, où le DNR écrit ses règles indexées, puis chargées décompressées.
+// Celles du Chrome Web Store (rhenium_extension_manager.h) sont décompressées
+// dans le profil, sous leur identifiant.
+class RheniumExtensionSystem : public ExtensionSystem,
+                               public ExtensionRegistrar::Delegate {
+ public:
+  explicit RheniumExtensionSystem(content::BrowserContext* browser_context);
+  RheniumExtensionSystem(const RheniumExtensionSystem&) = delete;
+  RheniumExtensionSystem& operator=(const RheniumExtensionSystem&) = delete;
+  ~RheniumExtensionSystem() override;
+
+  // Dossier des extensions dans le profil : Extensions\<nom du paquet> pour
+  // celles du paquet, Extensions\<identifiant> pour celles du Web Store.
+  base::FilePath InstallDir() const;
+
+  // Active l'extension `packaged_dir` déjà installée dans le profil. Sinon,
+  // la recopie et indexe ses règles DNR en arrière-plan, puis l'active.
+  void InstallBundledExtension(const base::FilePath& packaged_dir);
+
+  // Démarre le service worker de l'extension, s'il y en a un.
+  void WakeServiceWorker(const Extension& extension);
+
+  // Charge les extensions du Web Store déjà installées (au lancement).
+  void LoadWebStoreExtensions();
+
+  // Extension du Web Store vérifiée, décompressée et dont les règles DNR
+  // sont indexées : enregistrée dans les préférences, puis activée.
+  void AddWebStoreExtension(
+      scoped_refptr<Extension> extension,
+      const declarative_net_request::RulesetInstallPrefs& ruleset_prefs);
+
+  // Faux pour une extension du paquet, qui reviendrait au lancement suivant.
+  bool UninstallExtension(const ExtensionId& extension_id);
+  void SetExtensionEnabled(const ExtensionId& extension_id, bool enabled);
+
+  // Signale que le chargement initial est fini.
+  void FinishInitialization();
+
+  // KeyedService :
+  void Shutdown() override;
+
+  // ExtensionSystem :
+  void InitForRegularProfile(bool extensions_enabled) override;
+  ExtensionService* extension_service() override;
+  ManagementPolicy* management_policy() override;
+  ServiceWorkerManager* service_worker_manager() override;
+  UserScriptManager* user_script_manager() override;
+  StateStore* state_store() override;
+  StateStore* rules_store() override;
+  StateStore* dynamic_user_scripts_store() override;
+  scoped_refptr<value_store::ValueStoreFactory> store_factory() override;
+  QuotaService* quota_service() override;
+  AppSorting* app_sorting() override;
+  const base::OneShotEvent& ready() const override;
+  bool is_ready() const override;
+  ContentVerifier* content_verifier() override;
+  std::unique_ptr<ExtensionSet> GetDependentExtensions(
+      const Extension* extension) override;
+  void InstallUpdate(const std::string& extension_id,
+                     const std::string& public_key,
+                     const base::FilePath& temp_dir,
+                     bool install_immediately,
+                     InstallUpdateCallback install_update_callback) override;
+  void PerformActionBasedOnOmahaAttributes(
+      const std::string& extension_id,
+      const base::Value::Dict& attributes) override;
+  bool FinishDelayedInstallationIfReady(const std::string& extension_id,
+                                        bool install_immediately) override;
+
+  // ExtensionRegistrar::Delegate :
+  void PreAddExtension(const Extension* extension,
+                       const Extension* old_extension) override;
+  void PostActivateExtension(scoped_refptr<const Extension> extension) override;
+  void PostDeactivateExtension(
+      scoped_refptr<const Extension> extension) override;
+  void LoadExtensionForReload(
+      const ExtensionId& extension_id,
+      const base::FilePath& path,
+      ExtensionRegistrar::LoadErrorBehavior load_error_behavior) override;
+  bool CanEnableExtension(const Extension* extension) override;
+  bool CanDisableExtension(const Extension* extension) override;
+  bool ShouldBlockExtension(const Extension* extension) override;
+
+ private:
+  void OnBundledExtensionPrepared(PreparedExtension prepared);
+  void AddBundledExtension(
+      scoped_refptr<Extension> extension,
+      const declarative_net_request::RulesetInstallPrefs* ruleset_prefs);
+  void OnServiceWorkerUnregistered(
+      scoped_refptr<Extension> extension,
+      absl::optional<declarative_net_request::RulesetInstallPrefs>
+          ruleset_prefs,
+      bool success);
+  // Enregistre l'installation dans les préférences si les règles DNR viennent
+  // d'être indexées (`ruleset_prefs`), puis active l'extension.
+  void Activate(
+      scoped_refptr<Extension> extension,
+      const declarative_net_request::RulesetInstallPrefs* ruleset_prefs);
+  // Efface une fois les réglages (storage.local) d'une extension du paquet
+  // datée de 2025 ou plus : voir le .cc.
+  void ResetStorageOnce(const Extension& extension);
+
+  raw_ptr<content::BrowserContext> browser_context_;
+  scoped_refptr<value_store::ValueStoreFactory> store_factory_;
+  std::unique_ptr<ServiceWorkerManager> service_worker_manager_;
+  std::unique_ptr<QuotaService> quota_service_;
+  std::unique_ptr<AppSorting> app_sorting_;
+  std::unique_ptr<UserScriptManager> user_script_manager_;
+  std::unique_ptr<ExtensionRegistrar> extension_registrar_;
+  ManagementPolicy management_policy_;
+  base::OneShotEvent ready_;
+  base::WeakPtrFactory<RheniumExtensionSystem> weak_factory_{this};
+};
+
+class RheniumExtensionSystemFactory : public ExtensionSystemProvider {
+ public:
+  static RheniumExtensionSystemFactory* GetInstance();
+
+  RheniumExtensionSystemFactory(const RheniumExtensionSystemFactory&) = delete;
+  RheniumExtensionSystemFactory& operator=(
+      const RheniumExtensionSystemFactory&) = delete;
+
+  // ExtensionSystemProvider :
+  ExtensionSystem* GetForBrowserContext(
+      content::BrowserContext* context) override;
+
+ private:
+  friend struct base::DefaultSingletonTraits<RheniumExtensionSystemFactory>;
+
+  RheniumExtensionSystemFactory();
+  ~RheniumExtensionSystemFactory() override;
+
+  // BrowserContextKeyedServiceFactory :
+  KeyedService* BuildServiceInstanceFor(
+      content::BrowserContext* context) const override;
+  content::BrowserContext* GetBrowserContextToUse(
+      content::BrowserContext* context) const override;
+  bool ServiceIsCreatedWithBrowserContext() const override;
+};
+
+}  // namespace extensions
+
+#endif  // EXTENSIONS_RHENIUM_RHENIUM_EXTENSION_SYSTEM_H_
