+namespace extensions {
+
+namespace permissions_api = api::permissions;
+
+namespace {
+
+std::unique_ptr<const PermissionSet> Unpack(
+    const Extension& extension,
+    const permissions_api::Permissions& input,
+    std::string* error) {
+  APIPermissionSet apis;
+  if (input.permissions) {
+    for (const std::string& name : *input.permissions) {
+      const APIPermissionInfo* info =
+          PermissionsInfo::GetInstance()->GetByName(name);
+      if (!info) {
+        *error = "'" + name + "' is not a recognized permission.";
+        return nullptr;
+      }
+      apis.insert(info->id());
+    }
+  }
+  URLPatternSet origins;
+  if (input.origins) {
+    for (const std::string& origin : *input.origins) {
+      URLPattern pattern(Extension::kValidHostPermissionSchemes);
+      if (pattern.Parse(origin) != URLPattern::ParseResult::kSuccess) {
+        *error = "Invalid value for origin pattern " + origin;
+        return nullptr;
+      }
+      pattern.SetPath("/*");
+      // Comme PermissionsParser pour le manifeste : chrome:// est retiré des
+      // motifs (<all_urls> compris), et file:// sans accès aux fichiers,
+      // sinon la demande ne correspond jamais aux permissions facultatives
+      // déclarées.
+      int valid_schemes = pattern.valid_schemes() & ~URLPattern::SCHEME_CHROMEUI;
+      if (!(extension.creation_flags() & Extension::ALLOW_FILE_ACCESS))
+        valid_schemes &= ~URLPattern::SCHEME_FILE;
+      pattern.SetValidSchemes(valid_schemes);
+      origins.AddPattern(pattern);
+    }
+  }
+  return std::make_unique<PermissionSet>(std::move(apis),
+                                         ManifestPermissionSet(),
+                                         std::move(origins), URLPatternSet());
+}
+
+permissions_api::Permissions Pack(const PermissionSet& set) {
+  permissions_api::Permissions output;
+  output.permissions.emplace();
+  for (auto it = set.apis().begin(); it != set.apis().end(); ++it)
+    output.permissions->push_back(it->name());
+  output.origins.emplace();
+  for (const URLPattern& pattern : set.effective_hosts())
+    output.origins->push_back(pattern.GetAsString());
+  return output;
+}
+
+// Comme PermissionsUpdater de //chrome : nouvelles permissions actives,
+// accès réseau (CORS), moteur de rendu, puis onAdded / onRemoved.
+void SetActivePermissions(content::BrowserContext* context,
+                          const Extension& extension,
+                          std::unique_ptr<const PermissionSet> active,
+                          const PermissionSet& changed,
+                          bool added) {
+  const PermissionsData* data = extension.permissions_data();
+  data->SetPermissions(std::move(active),
+                       data->withheld_permissions().Clone());
+
+  NetworkPermissionsUpdater::UpdateExtension(
+      *context, extension,
+      NetworkPermissionsUpdater::ContextSet::kAllRelatedContexts,
+      base::DoNothing());
+
+  PermissionsManager::Get(context)->NotifyExtensionPermissionsUpdated(
+      extension, changed,
+      added ? PermissionsManager::UpdateReason::kAdded
+            : PermissionsManager::UpdateReason::kRemoved);
+
+  for (content::RenderProcessHost::iterator it(
+           content::RenderProcessHost::AllHostsIterator());
+       !it.IsAtEnd(); it.Advance()) {
+    content::RenderProcessHost* host = it.GetCurrentValue();
+    if (!host->IsInitializedAndNotDead() ||
+        host->GetBrowserContext() != context) {
+      continue;
+    }
+    mojom::Renderer* renderer =
+        RendererStartupHelperFactory::GetForBrowserContext(context)
+            ->GetRenderer(host);
+    if (renderer) {
+      renderer->UpdatePermissions(
+          extension.id(), std::move(*data->active_permissions().Clone()),
+          std::move(*data->withheld_permissions().Clone()),
+          data->policy_blocked_hosts(), data->policy_allowed_hosts(),
+          data->UsesDefaultPolicyHostRestrictions());
+    }
+  }
+
+  EventRouter* router = EventRouter::Get(context);
+  if (!router)
+    return;
+  const permissions_api::Permissions packed = Pack(changed);
+  auto event =
+      added ? std::make_unique<Event>(events::PERMISSIONS_ON_ADDED,
+                                      permissions_api::OnAdded::kEventName,
+                                      permissions_api::OnAdded::Create(packed),
+                                      context)
+            : std::make_unique<Event>(
+                  events::PERMISSIONS_ON_REMOVED,
+                  permissions_api::OnRemoved::kEventName,
+                  permissions_api::OnRemoved::Create(packed), context);
+  router->DispatchEventToExtension(extension.id(), std::move(event));
+}
+
+}  // namespace
+
+void ApplyRuntimeGrantedPermissions(content::BrowserContext* context,
+                                    const Extension& extension) {
+  std::unique_ptr<PermissionSet> granted =
+      ExtensionPrefs::Get(context)->GetRuntimeGrantedPermissions(
+          extension.id());
+  if (!granted || granted->IsEmpty())
+    return;
+  std::unique_ptr<const PermissionSet> optional_granted =
+      PermissionSet::CreateIntersection(
+          *granted, PermissionsParser::GetOptionalPermissions(&extension));
+  const PermissionsData* data = extension.permissions_data();
+  data->SetPermissions(
+      PermissionSet::CreateUnion(data->active_permissions(), *optional_granted),
+      data->withheld_permissions().Clone());
+}
+
+ExtensionFunction::ResponseAction PermissionsContainsFunction::Run() {
+  auto params = permissions_api::Contains::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  std::string error;
+  std::unique_ptr<const PermissionSet> requested =
+      Unpack(*extension(), params->permissions, &error);
+  if (!requested)
+    return RespondNow(Error(error));
+  const bool has = extension()->permissions_data()->active_permissions().Contains(
+      *requested);
+  return RespondNow(WithArguments(has));
+}
+
+ExtensionFunction::ResponseAction PermissionsGetAllFunction::Run() {
+  const permissions_api::Permissions packed =
+      Pack(extension()->permissions_data()->active_permissions());
+  return RespondNow(
+      ArgumentList(permissions_api::GetAll::Results::Create(packed)));
+}
+
+ExtensionFunction::ResponseAction PermissionsRequestFunction::Run() {
+  auto params = permissions_api::Request::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  std::string error;
+  std::unique_ptr<const PermissionSet> requested =
+      Unpack(*extension(), params->permissions, &error);
+  if (!requested)
+    return RespondNow(Error(error));
+
+  const PermissionSet& active =
+      extension()->permissions_data()->active_permissions();
+  std::unique_ptr<const PermissionSet> to_add =
+      PermissionSet::CreateDifference(*requested, active);
+  if (to_add->IsEmpty())
+    return RespondNow(WithArguments(true));
+  if (!PermissionsParser::GetOptionalPermissions(extension()).Contains(
+          *to_add)) {
+    return RespondNow(
+        Error("Only permissions specified in the manifest may be requested."));
+  }
+
+  ExtensionPrefs* prefs = ExtensionPrefs::Get(browser_context());
+  prefs->AddRuntimeGrantedPermissions(extension_id(), *to_add);
+  prefs->AddGrantedPermissions(extension_id(), *to_add);
+  SetActivePermissions(browser_context(), *extension(),
+                       PermissionSet::CreateUnion(active, *to_add), *to_add,
+                       /*added=*/true);
+  return RespondNow(WithArguments(true));
+}
+
+ExtensionFunction::ResponseAction PermissionsRemoveFunction::Run() {
+  auto params = permissions_api::Remove::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  std::string error;
+  std::unique_ptr<const PermissionSet> requested =
+      Unpack(*extension(), params->permissions, &error);
+  if (!requested)
+    return RespondNow(Error(error));
+
+  const PermissionSet& required =
+      PermissionsParser::GetRequiredPermissions(extension());
+  std::unique_ptr<const PermissionSet> required_asked =
+      PermissionSet::CreateIntersection(*requested, required);
+  if (!required_asked->IsEmpty())
+    return RespondNow(Error("You cannot remove required permissions."));
+
+  const PermissionSet& active =
+      extension()->permissions_data()->active_permissions();
+  std::unique_ptr<const PermissionSet> to_remove =
+      PermissionSet::CreateIntersection(*requested, active);
+  if (to_remove->IsEmpty())
+    return RespondNow(WithArguments(true));
+
+  ExtensionPrefs* prefs = ExtensionPrefs::Get(browser_context());
+  prefs->RemoveRuntimeGrantedPermissions(extension_id(), *to_remove);
+  prefs->RemoveGrantedPermissions(extension_id(), *to_remove);
+  SetActivePermissions(browser_context(), *extension(),
+                       PermissionSet::CreateDifference(active, *to_remove),
+                       *to_remove, /*added=*/false);
+  return RespondNow(WithArguments(true));
+}
+
+}  // namespace extensions
