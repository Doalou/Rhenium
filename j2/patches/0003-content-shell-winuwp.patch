+// (chrome/common/extensions/api/scripting.idl) : scripts de contenu
+// dynamiques, executeScript, insertCSS et removeCSS, ce qu'appelle uBlock
+// Origin Lite en modes optimal et complet. Scripts non conservés d'une
+// session à l'autre : l'extension les réenregistre au démarrage de son
+// service worker.
+
+[
+  {
+    "namespace": "scripting",
+    "description": "Scripts de contenu dynamiques et insertion de CSS.",
+    "types": [
+      {
+        "id": "StyleOrigin",
+        "type": "string",
+        "enum": ["AUTHOR", "USER"]
+      },
+      {
+        "id": "ExecutionWorld",
+        "type": "string",
+        "enum": ["ISOLATED", "MAIN"]
+      },
+      {
+        "id": "RunAt",
+        "type": "string",
+        "enum": ["document_start", "document_end", "document_idle"]
+      },
+      {
+        "id": "InjectionTarget",
+        "type": "object",
+        "properties": {
+          "tabId": {"type": "integer"},
+          "frameIds": {"type": "array", "items": {"type": "integer"}, "optional": true},
+          "allFrames": {"type": "boolean", "optional": true}
+        }
+      },
+      {
+        "id": "CSSInjection",
+        "type": "object",
+        "properties": {
+          "target": {"$ref": "InjectionTarget"},
+          "css": {"type": "string", "optional": true},
+          "files": {"type": "array", "items": {"type": "string"}, "optional": true},
+          "origin": {"$ref": "StyleOrigin", "optional": true}
+        }
+      },
+      {
+        "id": "RegisteredContentScript",
+        "type": "object",
+        "properties": {
+          "id": {"type": "string"},
+          "matches": {"type": "array", "items": {"type": "string"}, "optional": true},
+          "excludeMatches": {"type": "array", "items": {"type": "string"}, "optional": true},
+          "css": {"type": "array", "items": {"type": "string"}, "optional": true},
+          "js": {"type": "array", "items": {"type": "string"}, "optional": true},
+          "allFrames": {"type": "boolean", "optional": true},
+          "matchOriginAsFallback": {"type": "boolean", "optional": true},
+          "runAt": {"$ref": "RunAt", "optional": true},
+          "persistAcrossSessions": {"type": "boolean", "optional": true},
+          "world": {"$ref": "ExecutionWorld", "optional": true}
+        }
+      },
+      {
+        "id": "ScriptInjection",
+        "type": "object",
+        "properties": {
+          "func": {"type": "function", "serializableFunction": true, "optional": true, "parameters": []},
+          "args": {"type": "array", "items": {"type": "any"}, "optional": true},
+          "files": {"type": "array", "items": {"type": "string"}, "optional": true},
+          "target": {"$ref": "InjectionTarget"},
+          "world": {"$ref": "ExecutionWorld", "optional": true},
+          "injectImmediately": {"type": "boolean", "optional": true}
+        }
+      },
+      {
+        "id": "InjectionResult",
+        "type": "object",
+        "properties": {
+          "result": {"type": "any", "optional": true},
+          "frameId": {"type": "integer"}
+        }
+      },
+      {
+        "id": "ContentScriptFilter",
+        "type": "object",
+        "properties": {
+          "ids": {"type": "array", "items": {"type": "string"}, "optional": true}
+        }
+      }
+    ],
+    "functions": [
+      {
+        "name": "executeScript",
+        "type": "function",
+        "parameters": [{"name": "injection", "$ref": "ScriptInjection"}],
+        "returns_async": {
+          "name": "callback",
+          "optional": true,
+          "parameters": [
+            {"name": "results", "type": "array", "items": {"$ref": "InjectionResult"}}
+          ]
+        }
+      },
+      {
+        "name": "insertCSS",
+        "type": "function",
+        "parameters": [{"name": "injection", "$ref": "CSSInjection"}],
+        "returns_async": {"name": "callback", "optional": true, "parameters": []}
+      },
+      {
+        "name": "removeCSS",
+        "type": "function",
+        "parameters": [{"name": "injection", "$ref": "CSSInjection"}],
+        "returns_async": {"name": "callback", "optional": true, "parameters": []}
+      },
+      {
+        "name": "registerContentScripts",
+        "type": "function",
+        "parameters": [
+          {"name": "scripts", "type": "array", "items": {"$ref": "RegisteredContentScript"}}
+        ],
+        "returns_async": {"name": "callback", "optional": true, "parameters": []}
+      },
+      {
+        "name": "getRegisteredContentScripts",
+        "type": "function",
+        "parameters": [
+          {"name": "filter", "$ref": "ContentScriptFilter", "optional": true}
+        ],
+        "returns_async": {
+          "name": "callback",
+          "parameters": [
+            {"name": "scripts", "type": "array", "items": {"$ref": "RegisteredContentScript"}}
+          ]
+        }
+      },
+      {
+        "name": "unregisterContentScripts",
+        "type": "function",
+        "parameters": [
+          {"name": "filter", "$ref": "ContentScriptFilter", "optional": true}
+        ],
+        "returns_async": {"name": "callback", "optional": true, "parameters": []}
+      }
+    ]
+  }
+]
