+    "//ui/platform_window/stub",
+  ]
+}
diff --git a/ui/platform_window/uwp/uwp_window.cc b/ui/platform_window/uwp/uwp_window.cc
new file mode 100644
index 0000000000..fe7770bd29
--- /dev/null
+++ b/ui/platform_window/uwp/uwp_window.cc
@@ -0,0 +1,293 @@
+// Copyright 2026 Doalo
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/platform_window/uwp/uwp_window.h"
+
+#include <windows.devices.input.h>
+#include <windows.foundation.h>
+#include <windows.system.h>
+#include <windows.ui.input.h>
+#include <wrl/event.h>
+
+#include "base/logging.h"
+#include "base/time/time.h"
+#include "ui/events/event.h"
+#include "ui/events/event_constants.h"
+#include "ui/events/keycodes/dom/dom_code.h"
+#include "ui/events/keycodes/dom/dom_key.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+#include "ui/gfx/win/uwp_core_window.h"
+#include "ui/platform_window/platform_window_delegate.h"
+
+namespace ui {
+
+namespace {
+
+using ABI::Windows::Devices::Input::IPointerDevice;
+using ABI::Windows::Devices::Input::PointerDeviceType;
+using ABI::Windows::Devices::Input::PointerDeviceType_Mouse;
+using ABI::Windows::Devices::Input::PointerDeviceType_Touch;
+using ABI::Windows::Foundation::ITypedEventHandler;
+using ABI::Windows::Foundation::Point;
+using ABI::Windows::UI::Core::CoreWindow;
+using ABI::Windows::UI::Core::ICoreWindow;
+using ABI::Windows::UI::Core::IPointerEventArgs;
+using ABI::Windows::UI::Core::PointerEventArgs;
+using ABI::Windows::UI::Input::IPointerPoint;
+using Microsoft::WRL::Callback;
+
+using PointerHandler = ITypedEventHandler<CoreWindow*, PointerEventArgs*>;
+using ABI::Windows::System::VirtualKey;
+using ABI::Windows::UI::Core::IKeyEventArgs;
+using ABI::Windows::UI::Core::KeyEventArgs;
+using KeyHandler = ITypedEventHandler<CoreWindow*, KeyEventArgs*>;
+
+// Touches transmises telles quelles ; les caractères passent par le
+// CoreTextEditContext (ui/base/ime/win/input_method_uwp.h). Code et DomKey
+// donnés ici : les déduire passerait par la disposition du clavier de user32.
+struct SpecialKey {
+  KeyboardCode key_code;
+  DomCode code;
+  DomKey key;
+};
+
+const SpecialKey* FindSpecialKey(VirtualKey virtual_key) {
+  static const SpecialKey kKeys[] = {
+      {VKEY_RETURN, DomCode::ENTER, DomKey::ENTER},
+      {VKEY_BACK, DomCode::BACKSPACE, DomKey::BACKSPACE},
+      {VKEY_TAB, DomCode::TAB, DomKey::TAB},
+      {VKEY_ESCAPE, DomCode::ESCAPE, DomKey::ESCAPE},
+      {VKEY_LEFT, DomCode::ARROW_LEFT, DomKey::ARROW_LEFT},
+      {VKEY_RIGHT, DomCode::ARROW_RIGHT, DomKey::ARROW_RIGHT},
+      {VKEY_UP, DomCode::ARROW_UP, DomKey::ARROW_UP},
+      {VKEY_DOWN, DomCode::ARROW_DOWN, DomKey::ARROW_DOWN},
+      {VKEY_DELETE, DomCode::DEL, DomKey::DEL},
+      {VKEY_HOME, DomCode::HOME, DomKey::HOME},
+      {VKEY_END, DomCode::END, DomKey::END},
+      {VKEY_PRIOR, DomCode::PAGE_UP, DomKey::PAGE_UP},
+      {VKEY_NEXT, DomCode::PAGE_DOWN, DomKey::PAGE_DOWN},
+  };
+  for (const SpecialKey& key : kKeys) {
+    if (static_cast<int>(key.key_code) == static_cast<int>(virtual_key))
+      return &key;
+  }
+  return nullptr;
+}
+
+UwpWindow* g_hosted_window = nullptr;
+bool g_web_focus = true;
+
+}  // namespace
+
+void DispatchHostedPointer(EventType touch_type,
+                           uint32_t id,
+                           float x_dip,
+                           float y_dip,
+                           bool is_mouse) {
+  if (!g_hosted_window)
+    return;
+  if (touch_type == ET_TOUCH_CANCELLED)
+    g_hosted_window->CancelTouches();
+  else
+    g_hosted_window->OnPointerAt(touch_type, id, x_dip, y_dip, is_mouse);
+}
+
+void SetHostedWebFocus(bool focused) {
+  g_web_focus = focused;
+}
+
+void ResizeHostedWindow() {
+  if (g_hosted_window)
+    g_hosted_window->UpdateBounds();
+}
+
+UwpWindow::UwpWindow(PlatformWindowDelegate* delegate)
+    : StubWindow(delegate, /*use_default_accelerated_widget=*/false) {
+  gfx::Size pixel_size;
+  if (!gfx::uwp::GetCoreWindowMetrics(&pixel_size, &scale_))
+    LOG(ERROR) << "UwpWindow : pas de CoreWindow sur ce thread";
+  bounds_ = gfx::Rect(pixel_size);
+  LOG(INFO) << "UwpWindow : " << pixel_size.ToString() << " pixels, échelle "
+            << scale_;
+  if (gfx::uwp::IsHosted())
+    g_hosted_window = this;
+  SubscribePointerEvents();
+  // Le widget n'est jamais traité comme un HWND par la sortie UWP du
+  // compositeur ; il doit seulement être non nul.
+  delegate->OnAcceleratedWidgetAvailable(
+      reinterpret_cast<gfx::AcceleratedWidget>(
+          gfx::uwp::GetCoreWindow().Get()));
+}
+
+UwpWindow::~UwpWindow() {
+  if (g_hosted_window == this)
+    g_hosted_window = nullptr;
+  if (!core_window_)
+    return;
+  core_window_->remove_PointerPressed(pressed_token_);
+  core_window_->remove_PointerMoved(moved_token_);
+  core_window_->remove_PointerReleased(released_token_);
+  core_window_->remove_PointerCaptureLost(capture_lost_token_);
+  core_window_->remove_KeyDown(key_down_token_);
+  core_window_->remove_KeyUp(key_up_token_);
+}
+
+void UwpWindow::UpdateBounds() {
+  gfx::Size pixel_size;
+  if (!gfx::uwp::GetCoreWindowMetrics(&pixel_size, &scale_) ||
+      pixel_size == bounds_.size()) {
+    return;
+  }
+  bounds_ = gfx::Rect(pixel_size);
+  LOG(INFO) << "UwpWindow : " << pixel_size.ToString() << " pixels";
+  delegate()->OnBoundsChanged({/*origin_changed=*/false});
+}
+
+void UwpWindow::SetBoundsInPixels(const gfx::Rect& bounds) {
+  bounds_ = gfx::Rect(bounds_.size());
+  delegate()->OnBoundsChanged({/*origin_changed=*/false});
+}
+
+gfx::Rect UwpWindow::GetBoundsInPixels() const {
+  return bounds_;
+}
+
+void UwpWindow::SetBoundsInDIP(const gfx::Rect& bounds) {
+  SetBoundsInPixels(bounds_);
+}
+
+gfx::Rect UwpWindow::GetBoundsInDIP() const {
+  return const_cast<UwpWindow*>(this)->delegate()->ConvertRectToDIP(bounds_);
+}
+
+void UwpWindow::SubscribePointerEvents() {
+  Microsoft::WRL::ComPtr<IUnknown> window = gfx::uwp::GetCoreWindow();
+  if (!window || FAILED(window.As(&core_window_)))
+    return;
+  core_window_->add_KeyDown(
+      Callback<KeyHandler>([this](ICoreWindow*, IKeyEventArgs* args) {
+        return OnKey(ET_KEY_PRESSED, args);
+      }).Get(),
+      &key_down_token_);
+  core_window_->add_KeyUp(
+      Callback<KeyHandler>([this](ICoreWindow*, IKeyEventArgs* args) {
+        return OnKey(ET_KEY_RELEASED, args);
+      }).Get(),
+      &key_up_token_);
+  if (gfx::uwp::IsHosted())
+    return;  // pointeurs reçus par la coquille
+  core_window_->add_PointerPressed(
+      Callback<PointerHandler>([this](ICoreWindow*, IPointerEventArgs* args) {
+        return OnPointer(ET_TOUCH_PRESSED, args);
+      }).Get(),
+      &pressed_token_);
+  core_window_->add_PointerMoved(
+      Callback<PointerHandler>([this](ICoreWindow*, IPointerEventArgs* args) {
+        return OnPointer(ET_TOUCH_MOVED, args);
+      }).Get(),
+      &moved_token_);
+  core_window_->add_PointerReleased(
+      Callback<PointerHandler>([this](ICoreWindow*, IPointerEventArgs* args) {
+        return OnPointer(ET_TOUCH_RELEASED, args);
+      }).Get(),
+      &released_token_);
+  core_window_->add_PointerCaptureLost(
+      Callback<PointerHandler>([this](ICoreWindow*, IPointerEventArgs*) {
+        CancelTouches();
+        return S_OK;
+      }).Get(),
+      &capture_lost_token_);
+}
+
+HRESULT UwpWindow::OnKey(EventType type, IKeyEventArgs* args) {
+  VirtualKey virtual_key = {};
+  if (FAILED(args->get_VirtualKey(&virtual_key)))
+    return S_OK;
+  const SpecialKey* key = FindSpecialKey(virtual_key);
+  if (!key || (gfx::uwp::IsHosted() && !g_web_focus))
+    return S_OK;
+  KeyEvent event(type, key->key_code, key->code, EF_NONE, key->key,
+                 base::TimeTicks::Now());
+  delegate()->DispatchEvent(&event);
+  return S_OK;
+}
+
+HRESULT UwpWindow::OnPointer(EventType touch_type, IPointerEventArgs* args) {
+  Microsoft::WRL::ComPtr<IPointerPoint> point;
+  if (FAILED(args->get_CurrentPoint(&point)))
+    return S_OK;
+  Point position = {};
+  UINT32 id = 0;
+  point->get_Position(&position);
+  point->get_PointerId(&id);
+  PointerDeviceType device_type = PointerDeviceType_Touch;
+  Microsoft::WRL::ComPtr<IPointerDevice> device;
+  if (SUCCEEDED(point->get_PointerDevice(&device)) && device)
+    device->get_PointerDeviceType(&device_type);
+  OnPointerAt(touch_type, id, position.X, position.Y,
+              device_type == PointerDeviceType_Mouse);
+  return S_OK;
+}
+
+void UwpWindow::OnPointerAt(EventType touch_type,
+                            uint32_t id,
+                            float x_dip,
+                            float y_dip,
+                            bool is_mouse) {
+  // Position en DIP ; Aura attend des pixels.
+  const gfx::PointF location(x_dip * scale_, y_dip * scale_);
+  const base::TimeTicks now = base::TimeTicks::Now();
+
+  if (is_mouse) {
+    EventType type = ET_MOUSE_MOVED;
+    int changed = 0;
+    if (touch_type == ET_TOUCH_PRESSED) {
+      type = ET_MOUSE_PRESSED;
+      changed = EF_LEFT_MOUSE_BUTTON;
+      mouse_pressed_ = true;
+    } else if (touch_type == ET_TOUCH_RELEASED) {
+      type = ET_MOUSE_RELEASED;
+      changed = EF_LEFT_MOUSE_BUTTON;
+      mouse_pressed_ = false;
+    } else if (mouse_pressed_) {
+      type = ET_MOUSE_DRAGGED;
+    }
+    const int flags =
+        (mouse_pressed_ || changed) ? EF_LEFT_MOUSE_BUTTON : EF_NONE;
+    MouseEvent event(type, location, location, now, flags, changed);
+    delegate()->DispatchEvent(&event);
+    return;
+  }
+
+  // Toucher et stylet. Un déplacement sans appui (survol du stylet) est
+  // ignoré.
+  if (touch_type == ET_TOUCH_PRESSED) {
+    active_touches_.insert(id);
+  } else if (!active_touches_.contains(id)) {
+    return;
+  }
+  const auto touch_id = static_cast<PointerId>(touch_ids_.GetGeneratedID(id));
+  if (touch_type == ET_TOUCH_RELEASED) {
+    active_touches_.erase(id);
+    touch_ids_.ReleaseNumber(id);
+  }
+  TouchEvent event(touch_type, location, location, now,
+                   PointerDetails(EventPointerType::kTouch, touch_id));
+  delegate()->DispatchEvent(&event);
+}
+
+void UwpWindow::CancelTouches() {
+  const base::TimeTicks now = base::TimeTicks::Now();
+  for (uint32_t id : active_touches_) {
+    const auto touch_id = static_cast<PointerId>(touch_ids_.GetGeneratedID(id));
+    touch_ids_.ReleaseNumber(id);
+    TouchEvent event(ET_TOUCH_CANCELLED, gfx::PointF(), gfx::PointF(), now,
+                     PointerDetails(EventPointerType::kTouch, touch_id));
+    delegate()->DispatchEvent(&event);
+  }
+  active_touches_.clear();
+  mouse_pressed_ = false;
+}
+
+}  // namespace ui
