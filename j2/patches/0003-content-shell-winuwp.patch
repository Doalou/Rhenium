new file mode 100644
index 0000000000..f1312bbab3
--- /dev/null
+++ b/ui/base/ime/win/input_method_uwp.cc
@@ -0,0 +1,454 @@
+// Copyright 2026 Doalo
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/base/ime/win/input_method_uwp.h"
+
+#include <wrl/event.h>
+#include <wrl/wrappers/corewrappers.h>
+
+#include <algorithm>
+#include <string>
+
+#include "base/logging.h"
+#include "base/strings/string_util.h"
+#include "base/strings/string_util_win.h"
+#include "base/win/core_winrt_util.h"
+#include "base/win/scoped_hstring.h"
+#include "ui/base/ime/text_input_client.h"
+#include "ui/events/event.h"
+#include "ui/events/keycodes/dom/dom_code.h"
+#include "ui/events/keycodes/dom/dom_key.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+
+namespace ui {
+
+namespace {
+
+namespace text_core = ABI::Windows::UI::Text::Core;
+using ABI::Windows::Foundation::ITypedEventHandler;
+using ABI::Windows::UI::ViewManagement::IInputPane;
+using ABI::Windows::UI::ViewManagement::IInputPaneStatics;
+using Microsoft::WRL::Callback;
+using Microsoft::WRL::ComPtr;
+using Microsoft::WRL::Wrappers::HStringReference;
+
+constexpr base::TimeDelta kKeyDedup = base::Milliseconds(300);
+constexpr base::TimeDelta kEditSettle = base::Milliseconds(500);
+
+text_core::CoreTextInputScope ToInputScope(TextInputType type) {
+  switch (type) {
+    case TEXT_INPUT_TYPE_PASSWORD:
+      return text_core::CoreTextInputScope_Password;
+    case TEXT_INPUT_TYPE_SEARCH:
+      return text_core::CoreTextInputScope_Search;
+    case TEXT_INPUT_TYPE_EMAIL:
+      return text_core::CoreTextInputScope_EmailAddress;
+    case TEXT_INPUT_TYPE_NUMBER:
+      return text_core::CoreTextInputScope_Number;
+    case TEXT_INPUT_TYPE_TELEPHONE:
+      return text_core::CoreTextInputScope_TelephoneNumber;
+    case TEXT_INPUT_TYPE_URL:
+      return text_core::CoreTextInputScope_Url;
+    default:
+      return text_core::CoreTextInputScope_Text;
+  }
+}
+
+text_core::CoreTextRange ToCoreRange(const gfx::Range& range) {
+  return {static_cast<INT32>(range.GetMin()),
+          static_cast<INT32>(range.GetMax())};
+}
+
+gfx::Range FromCoreRange(const text_core::CoreTextRange& range) {
+  return gfx::Range(static_cast<uint32_t>(range.StartCaretPosition),
+                    static_cast<uint32_t>(range.EndCaretPosition));
+}
+
+}  // namespace
+
+InputMethodUwp::InputMethodUwp(ImeKeyEventDispatcher* ime_key_event_dispatcher)
+    : InputMethodBase(ime_key_event_dispatcher) {
+  CreateEditContext();
+}
+
+InputMethodUwp::~InputMethodUwp() {
+  if (!context_)
+    return;
+  if (context_focused_)
+    context_->NotifyFocusLeave();
+  context_->remove_TextRequested(text_requested_token_);
+  context_->remove_SelectionRequested(selection_requested_token_);
+  context_->remove_TextUpdating(text_updating_token_);
+  context_->remove_SelectionUpdating(selection_updating_token_);
+  context_->remove_FocusRemoved(focus_removed_token_);
+}
+
+void InputMethodUwp::CreateEditContext() {
+  ComPtr<text_core::ICoreTextServicesManagerStatics> statics;
+  ComPtr<text_core::ICoreTextServicesManager> manager;
+  HRESULT hr = base::win::RoGetActivationFactory(
+      HStringReference(
+          RuntimeClass_Windows_UI_Text_Core_CoreTextServicesManager)
+          .Get(),
+      IID_PPV_ARGS(&statics));
+  if (SUCCEEDED(hr))
+    hr = statics->GetForCurrentView(&manager);
+  if (SUCCEEDED(hr))
+    hr = manager->CreateEditContext(&context_);
+  if (FAILED(hr)) {
+    LOG(ERROR) << "CoreTextEditContext : " << std::hex << hr;
+    context_.Reset();
+    return;
+  }
+  // Le clavier est affiché et masqué ici, au gré du champ focalisé.
+  context_->put_InputPaneDisplayPolicy(
+      text_core::CoreTextInputPaneDisplayPolicy_Manual);
+
+  context_->add_TextRequested(
+      Callback<ITypedEventHandler<text_core::CoreTextEditContext*,
+                                  text_core::CoreTextTextRequestedEventArgs*>>(
+          [this](text_core::ICoreTextEditContext*,
+                 text_core::ICoreTextTextRequestedEventArgs* args) {
+            return OnTextRequested(args);
+          })
+          .Get(),
+      &text_requested_token_);
+  context_->add_SelectionRequested(
+      Callback<ITypedEventHandler<
+          text_core::CoreTextEditContext*,
+          text_core::CoreTextSelectionRequestedEventArgs*>>(
+          [this](text_core::ICoreTextEditContext*,
+                 text_core::ICoreTextSelectionRequestedEventArgs* args) {
+            return OnSelectionRequested(args);
+          })
+          .Get(),
+      &selection_requested_token_);
+  context_->add_TextUpdating(
+      Callback<ITypedEventHandler<text_core::CoreTextEditContext*,
+                                  text_core::CoreTextTextUpdatingEventArgs*>>(
+          [this](text_core::ICoreTextEditContext*,
+                 text_core::ICoreTextTextUpdatingEventArgs* args) {
+            return OnTextUpdating(args);
+          })
+          .Get(),
+      &text_updating_token_);
+  context_->add_SelectionUpdating(
+      Callback<ITypedEventHandler<
+          text_core::CoreTextEditContext*,
+          text_core::CoreTextSelectionUpdatingEventArgs*>>(
+          [this](text_core::ICoreTextEditContext*,
+                 text_core::ICoreTextSelectionUpdatingEventArgs* args) {
+            return OnSelectionUpdating(args);
+          })
+          .Get(),
+      &selection_updating_token_);
+  context_->add_FocusRemoved(
+      Callback<ITypedEventHandler<text_core::CoreTextEditContext*,
+                                  IInspectable*>>(
+          [this](text_core::ICoreTextEditContext*, IInspectable*) {
+            context_focused_ = false;
+            return S_OK;
+          })
+          .Get(),
+      &focus_removed_token_);
+
+  ComPtr<IInputPaneStatics> pane_statics;
+  ComPtr<IInputPane> pane;
+  hr = base::win::RoGetActivationFactory(
+      HStringReference(RuntimeClass_Windows_UI_ViewManagement_InputPane).Get(),
+      IID_PPV_ARGS(&pane_statics));
+  if (SUCCEEDED(hr))
+    hr = pane_statics->GetForCurrentView(&pane);
+  if (SUCCEEDED(hr))
+    pane.As(&input_pane_);
+}
+
+void InputMethodUwp::UpdateFocus(bool restart) {
+  if (!context_)
+    return;
+  const bool wants_keyboard =
+      GetTextInputClient() && GetTextInputType() != TEXT_INPUT_TYPE_NONE;
+  boolean done = false;
+  if (!wants_keyboard) {
+    if (context_focused_) {
+      context_->NotifyFocusLeave();
+      context_focused_ = false;
+      if (input_pane_)
+        input_pane_->TryHide(&done);
+    }
+    return;
+  }
+  // Même champ, même type : le clavier reste tel quel.
+  if (context_focused_ && !restart && GetTextInputType() == focused_type_)
+    return;
+  if (context_focused_)
+    context_->NotifyFocusLeave();
+  gfx::Range selection;
+  selection_ = GetTextInputClient()->GetEditableSelectionRange(&selection)
+                   ? selection
+                   : gfx::Range(0);
+  client_selection_ = selection_;
+  if (!GetClientText(&model_text_))
+    model_text_.clear();
+  client_text_ = model_text_;
+  focused_type_ = GetTextInputType();
+  context_->put_InputScope(ToInputScope(focused_type_));
+  context_->NotifyFocusEnter();
+  context_focused_ = true;
+  if (input_pane_)
+    input_pane_->TryShow(&done);
+}
+
+// Toucher d'un champ déjà focalisé dont le clavier a été fermé : Blink
+// redemande le clavier.
+void InputMethodUwp::SetVirtualKeyboardVisibilityIfEnabled(bool should_show) {
+  InputMethodBase::SetVirtualKeyboardVisibilityIfEnabled(should_show);
+  boolean done = false;
+  if (should_show && context_focused_ && input_pane_)
+    input_pane_->TryShow(&done);
+}
+
+ui::EventDispatchDetails InputMethodUwp::DispatchKeyEvent(ui::KeyEvent* event) {
+  DCHECK(event->type() == ET_KEY_PRESSED || event->type() == ET_KEY_RELEASED);
+  if (context_focused_) {
+    // L'effacement et Entrée peuvent arriver par la touche et par le texte du
+    // CoreTextEditContext : une seule des deux voies est appliquée.
+    if (event->key_code() == VKEY_BACK) {
+      const base::TimeTicks now = base::TimeTicks::Now();
+      if (event->type() == ET_KEY_PRESSED) {
+        back_key_forwarded_ = now - last_text_delete_ >= kKeyDedup;
+        if (back_key_forwarded_) {
+          last_key_back_ = now;
+          OnBackKeyForwarded();
+        }
+      }
+      if (!back_key_forwarded_) {
+        event->StopPropagation();
+        return ui::EventDispatchDetails();
+      }
+    }
+    if (event->key_code() == VKEY_RETURN && event->type() == ET_KEY_PRESSED &&
+        !dispatching_text_enter_) {
+      const base::TimeTicks now = base::TimeTicks::Now();
+      if (now - last_text_enter_ < kKeyDedup) {
+        event->StopPropagation();
+        return ui::EventDispatchDetails();
+      }
+      last_key_enter_ = now;
+    }
+  }
+
+  ui::EventDispatchDetails details = DispatchKeyEventPostIME(event);
+  if (!event->stopped_propagation() && !details.dispatcher_destroyed &&
+      event->type() == ET_KEY_PRESSED && GetTextInputClient()) {
+    const uint16_t ch = event->GetCharacter();
+    if (ch) {
+      GetTextInputClient()->InsertChar(*event);
+      event->StopPropagation();
+    }
+  }
+  return details;
+}
+
+void InputMethodUwp::OnBackKeyForwarded() {
+  // Blink efface lui-même : le modèle de texte du système doit suivre.
+  if (!context_)
+    return;
+  gfx::Range removed = selection_;
+  if (removed.is_empty()) {
+    if (removed.start() == 0)
+      return;
+    removed = gfx::Range(removed.start() - 1, removed.start());
+  }
+  const gfx::Range caret(removed.GetMin());
+  context_->NotifyTextChanged(ToCoreRange(removed), 0, ToCoreRange(caret));
+  ApplyLocalEdit(removed, std::u16string());
+  selection_ = caret;
+}
+
+void InputMethodUwp::ApplyLocalEdit(const gfx::Range& range,
+                                    const std::u16string& text) {
+  last_local_edit_ = base::TimeTicks::Now();
+  const size_t start = std::min<size_t>(range.GetMin(), model_text_.size());
+  const size_t end = std::min<size_t>(range.GetMax(), model_text_.size());
+  model_text_.replace(start, end - start, text);
+}
+
+bool InputMethodUwp::GetClientText(std::u16string* text) const {
+  TextInputClient* client = GetTextInputClient();
+  gfx::Range range;
+  if (!client || !client->GetTextRange(&range) || range.GetMin() != 0)
+    return false;
+  return client->GetTextFromRange(range, text);
+}
+
+void InputMethodUwp::ResyncWithClient() {
+  TextInputClient* client = GetTextInputClient();
+  if (!context_ || !context_focused_ || !client ||
+      base::TimeTicks::Now() - last_local_edit_ < kEditSettle) {
+    return;
+  }
+  gfx::Range selection;
+  if (!client->GetEditableSelectionRange(&selection))
+    return;
+  std::u16string text;
+  if (GetClientText(&text) && text != client_text_) {
+    client_text_ = text;
+    if (text != model_text_) {
+      context_->NotifyTextChanged(
+          ToCoreRange(gfx::Range(0, model_text_.size())),
+          static_cast<INT32>(text.size()), ToCoreRange(selection));
+      model_text_ = text;
+      selection_ = client_selection_ = selection;
+      return;
+    }
+  }
+  if (selection != client_selection_) {
+    client_selection_ = selection;
+    if (selection != selection_) {
+      selection_ = selection;
+      context_->NotifySelectionChanged(ToCoreRange(selection));
+    }
+  }
+}
+
+void InputMethodUwp::DispatchEnter() {
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (now - last_key_enter_ < kKeyDedup)
+    return;
+  last_text_enter_ = now;
+  dispatching_text_enter_ = true;
+  KeyEvent press(ET_KEY_PRESSED, VKEY_RETURN, DomCode::ENTER, EF_NONE,
+                 DomKey::ENTER, now);
+  DispatchKeyEvent(&press);
+  KeyEvent release(ET_KEY_RELEASED, VKEY_RETURN, DomCode::ENTER, EF_NONE,
+                   DomKey::ENTER, now);
+  DispatchKeyEvent(&release);
+  dispatching_text_enter_ = false;
+}
+
+void InputMethodUwp::OnTextInputTypeChanged(TextInputClient* client) {
+  InputMethodBase::OnTextInputTypeChanged(client);
+  if (IsTextInputClientFocused(client))
+    UpdateFocus(/*restart=*/false);
+}
+
+void InputMethodUwp::OnDidChangeFocusedClient(TextInputClient* focused_before,
+                                              TextInputClient* focused) {
+  UpdateFocus(/*restart=*/true);
+}
+
+void InputMethodUwp::OnCaretBoundsChanged(const TextInputClient* client) {
+  NotifyTextInputCaretBoundsChanged(client);
+  if (IsTextInputClientFocused(client))
+    ResyncWithClient();
+}
+
+void InputMethodUwp::CancelComposition(const TextInputClient* client) {}
+
+bool InputMethodUwp::IsCandidatePopupOpen() const {
+  return false;
+}
+
+// Pas de messages de fenêtre sous UWP.
+bool InputMethodUwp::OnUntranslatedIMEMessage(const CHROME_MSG event,
+                                              NativeEventResult* result) {
+  return false;
+}
+
+void InputMethodUwp::OnInputLocaleChanged() {}
+
+bool InputMethodUwp::IsInputLocaleCJK() const {
+  return false;
+}
+
+HRESULT InputMethodUwp::OnTextRequested(
+    text_core::ICoreTextTextRequestedEventArgs* args) {
+  ComPtr<text_core::ICoreTextTextRequest> request;
+  if (FAILED(args->get_Request(&request)))
+    return S_OK;
+  text_core::CoreTextRange requested = {};
+  request->get_Range(&requested);
+  std::u16string text;
+  gfx::Range known;
+  TextInputClient* client = GetTextInputClient();
+  if (client && client->GetTextRange(&known)) {
+    gfx::Range range = FromCoreRange(requested).Intersect(known);
+    if (!range.IsValid() || !client->GetTextFromRange(range, &text))
+      text.clear();
+  }
+  base::win::ScopedHString hstring =
+      base::win::ScopedHString::Create(base::AsWStringPiece(text));
+  request->put_Text(hstring.get());
+  return S_OK;
+}
+
+HRESULT InputMethodUwp::OnSelectionRequested(
+    text_core::ICoreTextSelectionRequestedEventArgs* args) {
+  ComPtr<text_core::ICoreTextSelectionRequest> request;
+  if (SUCCEEDED(args->get_Request(&request)))
+    request->put_Selection(ToCoreRange(selection_));
+  return S_OK;
+}
+
+HRESULT InputMethodUwp::OnTextUpdating(
+    text_core::ICoreTextTextUpdatingEventArgs* args) {
+  text_core::CoreTextRange core_range = {};
+  text_core::CoreTextRange core_selection = {};
+  HSTRING hstring = nullptr;
+  args->get_Range(&core_range);
+  args->get_Text(&hstring);
+  args->get_NewSelection(&core_selection);
+  base::win::ScopedHString scoped(hstring);
+  args->put_Result(text_core::CoreTextTextUpdatingResult_Succeeded);
+
+  TextInputClient* client = GetTextInputClient();
+  if (!client)
+    return S_OK;
+
+  std::u16string text(base::AsStringPiece16(scoped.Get()));
+  const bool enter = text.find_first_of(u"\r\n") != std::u16string::npos;
+  base::RemoveChars(text, u"\r\n", &text);
+
+  const gfx::Range range = FromCoreRange(core_range);
+  if (text.empty() && !range.is_empty()) {
+    // Effacement. InsertText ignore un texte vide : on passe par
+    // ExtendSelectionAndDelete, sur le même canal que la sélection.
+    const base::TimeTicks now = base::TimeTicks::Now();
+    if (now - last_key_back_ >= kKeyDedup) {
+      last_text_delete_ = now;
+      if (selection_.is_empty() && range.GetMax() == selection_.start()) {
+        client->ExtendSelectionAndDelete(range.length(), 0);
+      } else {
+        client->SetEditableSelectionRange(range);
+        client->ExtendSelectionAndDelete(0, 0);
+      }
+      ApplyLocalEdit(range, text);
+    }
+  } else if (!text.empty()) {
+    if (range != selection_)
+      client->SetEditableSelectionRange(range);
+    client->InsertText(
+        text, TextInputClient::InsertTextCursorBehavior::kMoveCursorAfterText);
+    ApplyLocalEdit(range, text);
+  }
+  selection_ = FromCoreRange(core_selection);
+  if (enter)
+    DispatchEnter();
+  return S_OK;
+}
+
+HRESULT InputMethodUwp::OnSelectionUpdating(
+    text_core::ICoreTextSelectionUpdatingEventArgs* args) {
+  text_core::CoreTextRange core_selection = {};
+  args->get_Selection(&core_selection);
+  args->put_Result(text_core::CoreTextSelectionUpdatingResult_Succeeded);
+  selection_ = FromCoreRange(core_selection);
+  last_local_edit_ = base::TimeTicks::Now();
+  if (TextInputClient* client = GetTextInputClient())
+    client->SetEditableSelectionRange(selection_);
+  return S_OK;
+}
+
+}  // namespace ui
