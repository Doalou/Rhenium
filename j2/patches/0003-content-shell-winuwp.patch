+#include "third_party/blink/public/common/storage_key/storage_key.h"
+
+namespace extensions {
+
+namespace {
+
+namespace dnr = declarative_net_request;
+
+std::string ReadManifestVersion(const base::FilePath& dir) {
+  std::string text;
+  if (!base::ReadFileToString(dir.AppendASCII("manifest.json"), &text))
+    return std::string();
+  absl::optional<base::Value> manifest = base::JSONReader::Read(text);
+  if (!manifest || !manifest->is_dict())
+    return std::string();
+  const std::string* version = manifest->GetDict().FindString("version");
+  return version ? *version : std::string();
+}
+
+scoped_refptr<Extension> LoadUnpacked(const base::FilePath& dir) {
+  std::string error;
+  scoped_refptr<Extension> extension = file_util::LoadExtension(
+      dir, mojom::ManifestLocation::kUnpacked,
+      Extension::FOLLOW_SYMLINKS_ANYWHERE, &error);
+  if (!extension) {
+    LOG(ERROR) << "Rhenium : extension " << dir.AsUTF8Unsafe()
+               << " illisible : " << error;
+    return nullptr;
+  }
+  for (const auto& warning : extension->install_warnings())
+    LOG(WARNING) << "Rhenium : " << extension->name() << " : "
+                 << warning.message;
+  return extension;
+}
+
+// Les règles statiques activées par le manifest ont-elles leur somme de
+// contrôle dans les préférences (installation déjà faite) ?
+bool HasRulesetChecksums(ExtensionPrefs* prefs, const Extension& extension) {
+  if (!prefs->GetInstalledExtensionInfo(extension.id()))
+    return false;
+  for (const auto& ruleset : dnr::DNRManifestData::GetRulesets(extension)) {
+    if (!ruleset.enabled)
+      continue;
+    int checksum = 0;
+    if (!prefs->GetDNRStaticRulesetChecksum(extension.id(), ruleset.id,
+                                            &checksum)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// Comme UnpackedInstaller de //chrome : règles statiques indexées à
+// l'installation, sommes de contrôle dans les préférences (sans elles,
+// RulesMonitorService ignore les règles). Les règles désactivées seront
+// indexées quand l'extension les activera.
+bool IndexRulesets(const Extension& extension,
+                   dnr::RulesetInstallPrefs* ruleset_prefs) {
+  dnr::InstallIndexHelper::Result result =
+      dnr::InstallIndexHelper::IndexStaticRulesetsUnsafe(
+          extension,
+          dnr::FileBackedRulesetSource::RulesetFilter::kIncludeManifestEnabled,
+          dnr::RulesetSource::kRaiseWarningOnLargeRegexRules);
+  if (result.error) {
+    LOG(ERROR) << "Rhenium : règles DNR de " << extension.name() << " : "
+               << *result.error;
+    return false;
+  }
+  LOG(INFO) << "Rhenium : " << result.ruleset_install_prefs.size()
+            << " ensembles de règles indexés pour " << extension.name();
+  *ruleset_prefs = std::move(result.ruleset_install_prefs);
+  return true;
+}
+
+}  // namespace
+
+struct PreparedExtension {
+  scoped_refptr<Extension> extension;
+  dnr::RulesetInstallPrefs ruleset_prefs;
+};
+
+namespace {
+
+// Hors du thread UI : recopie au besoin, lecture et indexation.
+PreparedExtension PrepareBundledExtension(const base::FilePath& packaged_dir,
+                                          const base::FilePath& dir,
+                                          const std::string& version) {
+  PreparedExtension result;
+  if (ReadManifestVersion(dir) != version) {
+    LOG(INFO) << "Rhenium : copie de " << packaged_dir.AsUTF8Unsafe() << " ("
+              << version << ")";
+    // Copie dans un dossier temporaire puis renommage : une app tuée pendant
+    // la copie ne laisse pas une extension incomplète à la bonne version.
+    const base::FilePath partial = dir.AddExtensionASCII("partial");
+    base::DeletePathRecursively(partial);
+    base::DeletePathRecursively(dir);
+    if (!base::CreateDirectory(dir.DirName()) ||
+        !base::CopyDirectory(packaged_dir, partial, /*recursive=*/true) ||
+        !base::Move(partial, dir)) {
+      LOG(ERROR) << "Rhenium : copie impossible vers " << dir.AsUTF8Unsafe();
+      base::DeletePathRecursively(partial);
+      return result;
+    }
+  }
+  scoped_refptr<Extension> extension = LoadUnpacked(dir);
+  if (extension && IndexRulesets(*extension, &result.ruleset_prefs))
+    result.extension = std::move(extension);
+  else
+    base::DeletePathRecursively(dir);  // recopiée au prochain lancement
+  return result;
+}
+
+}  // namespace
+
+RheniumExtensionSystem::RheniumExtensionSystem(
+    content::BrowserContext* browser_context)
+    : browser_context_(browser_context),
+      store_factory_(base::MakeRefCounted<value_store::ValueStoreFactoryImpl>(
+          browser_context->GetPath())) {}
+
+RheniumExtensionSystem::~RheniumExtensionSystem() = default;
+
+base::FilePath RheniumExtensionSystem::InstallDir() const {
+  return browser_context_->GetPath().AppendASCII("Extensions");
+}
+
+void RheniumExtensionSystem::InstallBundledExtension(
+    const base::FilePath& packaged_dir) {
+  const std::string packaged_version = ReadManifestVersion(packaged_dir);
+  if (packaged_version.empty()) {
+    LOG(ERROR) << "Rhenium : pas d'extension dans "
+               << packaged_dir.AsUTF8Unsafe();
+    return;
+  }
+  const base::FilePath dir = InstallDir().Append(packaged_dir.BaseName());
+  if (ReadManifestVersion(dir) == packaged_version) {
+    scoped_refptr<Extension> extension = LoadUnpacked(dir);
+    if (extension &&
+        HasRulesetChecksums(ExtensionPrefs::Get(browser_context_),
+                            *extension)) {
+      AddBundledExtension(std::move(extension), nullptr);
+      return;
+    }
+  }
+  // Première installation ou mise à jour : la copie (plus de 30 Mo pour
+  // uBlock Origin Lite) et l'indexation prennent plus de dix secondes sur un
+  // Lumia. Sur le thread UI, elles retiendraient l'écran de démarrage et le
+  // système tuerait l'app. Les premières pages s'ouvrent donc sans filtrage.
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&PrepareBundledExtension, packaged_dir, dir,
+                     packaged_version),
+      base::BindOnce(&RheniumExtensionSystem::OnBundledExtensionPrepared,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void RheniumExtensionSystem::OnBundledExtensionPrepared(
+    PreparedExtension prepared) {
+  if (!prepared.extension)
+    return;
+  base::ScopedAllowBlockingForTesting allow_blocking;  // ResetStorageOnce
+  scoped_refptr<const Extension> extension = prepared.extension;
+  AddBundledExtension(std::move(prepared.extension), &prepared.ruleset_prefs);
+  WakeServiceWorker(*extension);
+}
+
+// Service worker enregistré pour une autre version de l'extension.
+constexpr PrefMap kServiceWorkerVersionPref = {
+    "rhenium_service_worker_version", PrefType::kString,
+    PrefScope::kExtensionSpecific};
+
+void RheniumExtensionSystem::AddBundledExtension(
+    scoped_refptr<Extension> extension,
+    const dnr::RulesetInstallPrefs* ruleset_prefs) {
+  ResetStorageOnce(*extension);
+  // Chrome désenregistre le service worker en déchargeant l'ancienne version.
+  // Ici, elle n'est jamais chargée : sans cela, le service worker garde les
+  // scripts de l'ancienne version.
+  std::string registered;
+  ExtensionPrefs::Get(browser_context_)
+      ->ReadPrefAsString(extension->id(), kServiceWorkerVersionPref,
+                         &registered);
+  if (BackgroundInfo::IsServiceWorkerBased(extension.get()) &&
+      registered != extension->VersionString()) {
+    absl::optional<dnr::RulesetInstallPrefs> prefs_copy;
+    if (ruleset_prefs)
+      prefs_copy = *ruleset_prefs;
+    browser_context_->GetDefaultStoragePartition()
+        ->GetServiceWorkerContext()
+        ->UnregisterServiceWorker(
+            extension->url(),
+            blink::StorageKey::CreateFirstParty(extension->origin()),
+            base::BindOnce(&RheniumExtensionSystem::OnServiceWorkerUnregistered,
+                           weak_factory_.GetWeakPtr(), extension,
+                           std::move(prefs_copy)));
+    return;
+  }
+  Activate(extension, ruleset_prefs);
+  LOG(INFO) << "Rhenium : extension " << extension->name() << " "
+            << extension->VersionString() << " chargée";
+}
+
+void RheniumExtensionSystem::OnServiceWorkerUnregistered(
+    scoped_refptr<Extension> extension,
+    absl::optional<dnr::RulesetInstallPrefs> ruleset_prefs,
+    bool success) {
+  // Échec aussi quand rien n'était enregistré : première installation.
+  LOG(INFO) << "Rhenium : service worker de " << extension->name()
+            << " désenregistré " << success;
+  ExtensionPrefs::Get(browser_context_)
+      ->SetStringPref(extension->id(), kServiceWorkerVersionPref,
+                      extension->VersionString());
+  Activate(extension, ruleset_prefs ? &*ruleset_prefs : nullptr);
+  LOG(INFO) << "Rhenium : extension " << extension->name() << " "
+            << extension->VersionString() << " chargée";
+  WakeServiceWorker(*extension);
+}
+
+void RheniumExtensionSystem::WakeServiceWorker(const Extension& extension) {
+  if (!BackgroundInfo::IsServiceWorkerBased(&extension) ||
+      !ExtensionRegistry::Get(browser_context_)
+           ->enabled_extensions()
+           .Contains(extension.id())) {
+    return;
+  }
+  LazyContextId context_id(browser_context_, &extension);
+  context_id.GetTaskQueue()->AddPendingTask(context_id, base::DoNothing());
+}
+
+// uBlock Origin Lite de 2024 activait l'ensemble de règles « default »,
+// disparu depuis. Une version de 2025 ou plus reprend ses réglages tels
+// quels, ne garde que la liste régionale et désactive ses listes principales.
+// Les réglages sont donc effacés une fois, comme pour une installation neuve.
+// Une seconde fois (clé de 2026) : le service worker de 2024 restait en place
+// et les avait réécrits.
+// Appelé avant l'activation de l'extension, donc avant tout accès à son
+// stockage.
+void RheniumExtensionSystem::ResetStorageOnce(const Extension& extension) {
+  static constexpr PrefMap kStorageResetPref = {
+      "rhenium_storage_reset_2026", PrefType::kBool,
+      PrefScope::kExtensionSpecific};
+  ExtensionPrefs* prefs = ExtensionPrefs::Get(browser_context_);
+  bool done = false;
+  if (extension.version() < base::Version("2025") ||
+      (prefs->ReadPrefAsBoolean(extension.id(), kStorageResetPref, &done) &&
+       done)) {
+    return;
+  }
+  base::DeletePathRecursively(browser_context_->GetPath()
+                                  .Append(kLocalExtensionSettingsDirectoryName)
+                                  .AppendASCII(extension.id()));
+  prefs->SetBooleanPref(extension.id(), kStorageResetPref, true);
+  ExtensionsBrowserClient::Get()
+      ->GetPrefServiceForContext(browser_context_)
+      ->CommitPendingWrite();
+  LOG(INFO) << "Rhenium : réglages de " << extension.name() << " effacés";
+}
+
+void RheniumExtensionSystem::LoadWebStoreExtensions() {
+  base::FileEnumerator dirs(InstallDir(), /*recursive=*/false,
+                            base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath dir = dirs.Next(); !dir.empty(); dir = dirs.Next()) {
+    const std::string id = dir.BaseName().AsUTF8Unsafe();
+    if (!crx_file::id_util::IdIsValid(id))
+      continue;  // extension du paquet, ou installation interrompue
+    std::string error;
+    scoped_refptr<Extension> extension = file_util::LoadExtension(
+        dir, id, mojom::ManifestLocation::kInternal, Extension::FROM_WEBSTORE,
+        &error);
+    if (!extension) {
+      LOG(ERROR) << "Rhenium : extension " << id << " illisible : " << error;
+      continue;
+    }
+    // Règles indexées à l'installation, sauf si l'app a été tuée avant
+    // l'écriture des préférences.
+    dnr::RulesetInstallPrefs ruleset_prefs;
+    const bool index =
+        !HasRulesetChecksums(ExtensionPrefs::Get(browser_context_), *extension);
+    if (index && !IndexRulesets(*extension, &ruleset_prefs))
+      continue;
+    Activate(extension, index ? &ruleset_prefs : nullptr);
+    LOG(INFO) << "Rhenium : extension " << extension->name() << " "
+              << extension->VersionString() << " chargée (Web Store)";
+  }
+}
+
+void RheniumExtensionSystem::AddWebStoreExtension(
+    scoped_refptr<Extension> extension,
+    const dnr::RulesetInstallPrefs& ruleset_prefs) {
+  ExtensionPrefs::Get(browser_context_)
+      ->OnExtensionInstalled(extension.get(), Extension::ENABLED,
+                             syncer::StringOrdinal(),
+                             kInstallFlagInstallImmediately, std::string(),
+                             ruleset_prefs);
+  ExtensionsBrowserClient::Get()
+      ->GetPrefServiceForContext(browser_context_)
+      ->CommitPendingWrite();
+  extension_registrar_->AddExtension(extension);
+}
+
+bool RheniumExtensionSystem::UninstallExtension(
+    const ExtensionId& extension_id) {
+  ExtensionRegistry* registry = ExtensionRegistry::Get(browser_context_);
+  scoped_refptr<const Extension> extension =
+      registry->GetInstalledExtension(extension_id);
+  if (!extension || extension->location() != mojom::ManifestLocation::kInternal)
+    return false;
+  extension_registrar_->RemoveExtension(extension_id,
+                                        UnloadedExtensionReason::UNINSTALL);
+  registry->TriggerOnUninstalled(extension.get(),
+                                 UNINSTALL_REASON_USER_INITIATED);
+  ExtensionPrefs::Get(browser_context_)
+      ->OnExtensionUninstalled(extension_id, extension->location(),
+                               /*external_uninstall=*/false);
+  ExtensionsBrowserClient::Get()
+      ->GetPrefServiceForContext(browser_context_)
+      ->CommitPendingWrite();
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::GetDeletePathRecursivelyCallback(extension->path()));
+  return true;
+}
+
+void RheniumExtensionSystem::SetExtensionEnabled(
+    const ExtensionId& extension_id,
+    bool enabled) {
+  if (enabled) {
+    extension_registrar_->EnableExtension(extension_id);
+  } else {
+    extension_registrar_->DisableExtension(
+        extension_id, disable_reason::DISABLE_USER_ACTION);
+  }
+  ExtensionsBrowserClient::Get()
+      ->GetPrefServiceForContext(browser_context_)
+      ->CommitPendingWrite();
+}
+
+void RheniumExtensionSystem::Activate(
+    scoped_refptr<Extension> extension,
+    const dnr::RulesetInstallPrefs* ruleset_prefs) {
+  if (ruleset_prefs) {
+    ExtensionPrefs* prefs = ExtensionPrefs::Get(browser_context_);
+    // Garde l'état activé ou désactivé choisi par l'utilisateur.
+    prefs->OnExtensionInstalled(
+        extension.get(),
+        prefs->IsExtensionDisabled(extension->id()) ? Extension::DISABLED
+                                                    : Extension::ENABLED,
+        syncer::StringOrdinal(), kInstallFlagInstallImmediately, std::string(),
+        *ruleset_prefs);
+    // Écrites tout de suite : un arrêt brutal ne doit pas forcer une nouvelle
+    // indexation au lancement suivant.
+    ExtensionsBrowserClient::Get()
+        ->GetPrefServiceForContext(browser_context_)
+        ->CommitPendingWrite();
+  }
+  ApplyRuntimeGrantedPermissions(browser_context_, *extension);
+  extension_registrar_->AddExtension(extension);
+}
+
+void RheniumExtensionSystem::FinishInitialization() {
+  ready_.Signal();
+}
+
+void RheniumExtensionSystem::Shutdown() {
+  if (extension_registrar_)
+    extension_registrar_->Shutdown();
+}
+
+void RheniumExtensionSystem::InitForRegularProfile(bool extensions_enabled) {
+  service_worker_manager_ =
+      std::make_unique<ServiceWorkerManager>(browser_context_);
+  quota_service_ = std::make_unique<QuotaService>();
+  app_sorting_ = std::make_unique<NullAppSorting>();
+  user_script_manager_ = std::make_unique<UserScriptManager>(browser_context_);
+  extension_registrar_ =
+      std::make_unique<ExtensionRegistrar>(browser_context_, this);
+}
