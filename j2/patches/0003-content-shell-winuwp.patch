+// found in the LICENSE file.
+
+#include "components/viz/service/display_embedder/software_output_device_uwp.h"
+
+#include <iterator>
+
+#include "base/logging.h"
+#include "third_party/skia/include/core/SkPixmap.h"
+#include "third_party/skia/include/core/SkSurface.h"
+#include "ui/gfx/win/uwp_core_window.h"
+
+namespace viz {
+
+using Microsoft::WRL::ComPtr;
+
+SoftwareOutputDeviceUwp::SoftwareOutputDeviceUwp() = default;
+
+SoftwareOutputDeviceUwp::~SoftwareOutputDeviceUwp() = default;
+
+bool SoftwareOutputDeviceUwp::EnsureSwapChain() {
+  if (failed_)
+    return false;
+  if (!device_) {
+    const D3D_FEATURE_LEVEL levels[] = {
+        D3D_FEATURE_LEVEL_11_1, D3D_FEATURE_LEVEL_11_0, D3D_FEATURE_LEVEL_10_1,
+        D3D_FEATURE_LEVEL_10_0, D3D_FEATURE_LEVEL_9_3,  D3D_FEATURE_LEVEL_9_1};
+    HRESULT hr = E_FAIL;
+    for (D3D_DRIVER_TYPE type : {D3D_DRIVER_TYPE_HARDWARE, D3D_DRIVER_TYPE_WARP}) {
+      hr = D3D11CreateDevice(nullptr, type, nullptr,
+                             D3D11_CREATE_DEVICE_BGRA_SUPPORT, levels,
+                             std::size(levels), D3D11_SDK_VERSION, &device_,
+                             nullptr, &context_);
+      if (SUCCEEDED(hr))
+        break;
+    }
+    if (FAILED(hr)) {
+      LOG(ERROR) << "D3D11CreateDevice : " << std::hex << hr;
+      failed_ = true;
+      return false;
+    }
+  }
+
+  if (swap_chain_ && swap_chain_size_ == viewport_pixel_size_)
+    return true;
+
+  if (swap_chain_) {
+    HRESULT hr = swap_chain_->ResizeBuffers(
+        0, viewport_pixel_size_.width(), viewport_pixel_size_.height(),
+        DXGI_FORMAT_UNKNOWN, 0);
+    if (FAILED(hr)) {
+      LOG(ERROR) << "ResizeBuffers : " << std::hex << hr;
+      failed_ = true;
+      return false;
+    }
+    swap_chain_size_ = viewport_pixel_size_;
+    fresh_buffers_ = 2;
+    return true;
+  }
+
+  const bool hosted = gfx::uwp::IsHosted();
+  ComPtr<IUnknown> core_window = gfx::uwp::GetCoreWindow();
+  ComPtr<IDXGIDevice> dxgi_device;
+  ComPtr<IDXGIAdapter> adapter;
+  ComPtr<IDXGIFactory2> factory;
+  HRESULT hr = (hosted || core_window) ? device_.As(&dxgi_device) : E_POINTER;
+  if (SUCCEEDED(hr))
+    hr = dxgi_device->GetAdapter(&adapter);
+  if (SUCCEEDED(hr))
+    hr = adapter->GetParent(IID_PPV_ARGS(&factory));
+  if (SUCCEEDED(hr)) {
+    DXGI_SWAP_CHAIN_DESC1 desc = {};
+    desc.Width = viewport_pixel_size_.width();
+    desc.Height = viewport_pixel_size_.height();
+    desc.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    desc.SampleDesc.Count = 1;
+    desc.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+    desc.BufferCount = 2;
+    desc.Scaling = DXGI_SCALING_STRETCH;
+    desc.SwapEffect = DXGI_SWAP_EFFECT_FLIP_SEQUENTIAL;
+    desc.AlphaMode = DXGI_ALPHA_MODE_IGNORE;
+    if (hosted) {
+      // SwapChainPanel de la coquille XAML : swap chain de composition, ramenée
+      // de pixels en DIP par sa matrice, posée par la coquille sur le thread UI.
+      hr = factory->CreateSwapChainForComposition(device_.Get(), &desc,
+                                                  nullptr, &swap_chain_);
+      ComPtr<IDXGISwapChain2> swap_chain2;
+      if (SUCCEEDED(hr) && SUCCEEDED(swap_chain_.As(&swap_chain2))) {
+        const float inverse = 1.0f / gfx::uwp::GetHostedScale();
+        const DXGI_MATRIX_3X2_F matrix = {inverse, 0, 0, inverse, 0, 0};
+        swap_chain2->SetMatrixTransform(&matrix);
+      }
+      if (SUCCEEDED(hr))
+        gfx::uwp::AttachSwapChain(swap_chain_.Get());
+    } else {
+      hr = factory->CreateSwapChainForCoreWindow(
+          device_.Get(), core_window.Get(), &desc, nullptr, &swap_chain_);
+    }
+  }
+  if (FAILED(hr)) {
+    LOG(ERROR) << "Swap chain de la CoreWindow : " << std::hex << hr;
+    failed_ = true;
+    return false;
+  }
+  swap_chain_size_ = viewport_pixel_size_;
+  fresh_buffers_ = 2;
+  LOG(INFO) << (hosted ? "Swap chain du SwapChainPanel : "
+                       : "Swap chain de la CoreWindow : ")
+            << viewport_pixel_size_.ToString();
+  return true;
+}
+
+void SoftwareOutputDeviceUwp::EndPaint() {
+  SoftwareOutputDevice::EndPaint();
+  SkPixmap pixmap;
+  if (!surface_ || !surface_->peekPixels(&pixmap) || !EnsureSwapChain())
+    return;
+
+  // Modèle flip à deux tampons : le tampon arrière contient l'image d'il y a
+  // deux présentations. On recopie la zone redessinée de cette image et de la
+  // précédente ; toute l'image tant que les deux tampons n'ont pas été remplis.
+  const gfx::Rect full(viewport_pixel_size_);
+  gfx::Rect copy = damage_rect_;
+  copy.Union(previous_damage_);
+  if (fresh_buffers_ > 0) {
+    copy = full;
+    --fresh_buffers_;
+  }
+  copy.Intersect(full);
+  previous_damage_ = damage_rect_;
+
+  ComPtr<ID3D11Texture2D> back_buffer;
+  if (FAILED(swap_chain_->GetBuffer(0, IID_PPV_ARGS(&back_buffer))))
+    return;
+  const base::TimeTicks copy_start = base::TimeTicks::Now();
+  if (!copy.IsEmpty()) {
+    const D3D11_BOX box = {static_cast<UINT>(copy.x()),
+                           static_cast<UINT>(copy.y()),
+                           0,
+                           static_cast<UINT>(copy.right()),
+                           static_cast<UINT>(copy.bottom()),
+                           1};
+    context_->UpdateSubresource(back_buffer.Get(), 0, &box,
+                                pixmap.addr32(copy.x(), copy.y()),
+                                static_cast<UINT>(pixmap.rowBytes()), 0);
+  }
+  const base::TimeDelta copy_time = base::TimeTicks::Now() - copy_start;
+  HRESULT hr = swap_chain_->Present(1, 0);
+  if (FAILED(hr)) {
+    LOG(ERROR) << "Present : " << std::hex << hr;
+    return;
+  }
+  if (++frames_ == 1)
+    LOG(INFO) << "Première image présentée";
+  MeasureCadence(copy_time);
+}
+
+void SoftwareOutputDeviceUwp::MeasureCadence(base::TimeDelta copy_time) {
+  const base::TimeTicks now = base::TimeTicks::Now();
+  // Une pause de plus de 200 ms clôt une période d'activité (défilement,
+  // animation) ; chaque seconde pleine est notée.
+  if (burst_frames_ && now - last_frame_ > base::Milliseconds(200))
+    burst_frames_ = 0;
+  last_frame_ = now;
+  if (!burst_frames_) {
+    burst_start_ = now;
+    burst_copy_time_ = base::TimeDelta();
+  }
+  ++burst_frames_;
+  burst_copy_time_ += copy_time;
+  const base::TimeDelta elapsed = now - burst_start_;
+  if (elapsed < base::Seconds(1))
+    return;
+  LOG(INFO) << "Cadence : "
+            << static_cast<int>(burst_frames_ / elapsed.InSecondsF())
+            << " images/s, copie " << (burst_copy_time_ / burst_frames_).InMillisecondsF()
+            << " ms par image, " << viewport_pixel_size_.ToString();
+  burst_frames_ = 0;
+}
+
+}  // namespace viz
