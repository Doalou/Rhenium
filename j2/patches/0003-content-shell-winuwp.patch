+
+#ifndef CONTENT_SHELL_BROWSER_SHELL_UWP_HOST_H_
+#define CONTENT_SHELL_BROWSER_SHELL_UWP_HOST_H_
+
+namespace content {
+
+// Rhénium : rappels vers la coquille XAML de l'app UWP (barre d'adresse,
+// précédent, chargement), appelés sur le thread UI par le délégué de
+// plateforme Aura de content_shell.
+struct ShellUwpHost {
+  void* context = nullptr;
+  void (*url_changed)(void* context, const wchar_t* url) = nullptr;
+  void (*loading_changed)(void* context,
+                          int loading,
+                          int can_go_back,
+                          int can_go_forward) = nullptr;
+  void (*title_changed)(void* context, const wchar_t* title) = nullptr;
+  void (*progress_changed)(void* context, double progress) = nullptr;
+};
+
+void SetShellUwpHost(const ShellUwpHost& host);
+
+}  // namespace content
+
+#endif  // CONTENT_SHELL_BROWSER_SHELL_UWP_HOST_H_
