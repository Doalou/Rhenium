@@ -0,0 +1,192 @@
+// Copyright 2026 Doalo
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "extensions/rhenium/rhenium_tabs_api.h"
+
+#include <string>
+#include <vector>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/referrer.h"
+#include "extensions/common/constants.h"
+#include "extensions/common/url_pattern.h"
+#include "extensions/common/url_pattern_set.h"
+#include "extensions/rhenium/api/tabs.h"
+#include "extensions/rhenium/rhenium_tab_model.h"
+#include "ui/base/page_transition_types.h"
+#include "url/gurl.h"
+
+namespace extensions {
+
+namespace tabs = api::tabs;
+
+namespace {
+
+constexpr char kNoTab[] = "No tab with id: *.";
+
+tabs::Tab MakeTab(content::WebContents* web_contents, int index) {
+  const int id = rhenium::GetTabId(web_contents);
+  const bool active = rhenium::IsTabActive(id);
+  tabs::Tab tab;
+  tab.id = id;
+  tab.index = index;
+  tab.window_id = rhenium::kWindowId;
+  tab.highlighted = active;
+  tab.active = active;
+  tab.pinned = false;
+  tab.incognito = false;
+  tab.discarded = false;
+  tab.auto_discardable = false;
+  tab.url = web_contents->GetLastCommittedURL().spec();
+  tab.title = base::UTF16ToUTF8(web_contents->GetTitle());
+  tab.status = web_contents->IsLoading() ? "loading" : "complete";
+  return tab;
+}
+
+}  // namespace
+
+absl::optional<base::Value::Dict> GetTabInfo(
+    content::WebContents* web_contents) {
+  for (int index = 0; index < rhenium::GetTabCount(); ++index) {
+    if (rhenium::GetTabAt(index) == web_contents)
+      return MakeTab(web_contents, index).ToValue();
+  }
+  return absl::nullopt;
+}
+
+// Une seule fenêtre, courante et dernière focalisée.
+ExtensionFunction::ResponseAction TabsQueryFunction::Run() {
+  auto params = tabs::Query::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  const auto& query = params->query_info;
+  std::vector<tabs::Tab> result;
+  const bool other_window =
+      (query.current_window && !*query.current_window) ||
+      (query.last_focused_window && !*query.last_focused_window) ||
+      (query.window_type && *query.window_type != "normal");
+  URLPatternSet url_patterns;
+  if (query.url) {
+    std::vector<std::string> patterns;
+    if (query.url->as_string)
+      patterns.push_back(*query.url->as_string);
+    else if (query.url->as_strings)
+      patterns = *query.url->as_strings;
+    std::string error;
+    if (!url_patterns.Populate(patterns, URLPattern::SCHEME_ALL,
+                               /*allow_file_access=*/true, &error)) {
+      return RespondNow(Error(error));
+    }
+  }
+  for (int index = 0; !other_window && index < rhenium::GetTabCount();
+       ++index) {
+    content::WebContents* web_contents = rhenium::GetTabAt(index);
+    const bool active = rhenium::IsTabActive(rhenium::GetTabId(web_contents));
+    if (query.active && *query.active != active)
+      continue;
+    if (query.url &&
+        !url_patterns.MatchesURL(web_contents->GetLastCommittedURL())) {
+      continue;
+    }
+    result.push_back(MakeTab(web_contents, index));
+  }
+  return RespondNow(ArgumentList(tabs::Query::Results::Create(result)));
+}
+
+// Sans identifiant : l'onglet actif.
+ExtensionFunction::ResponseAction TabsReloadFunction::Run() {
+  auto params = tabs::Reload::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  content::WebContents* web_contents =
+      params->tab_id ? rhenium::GetTabWebContents(*params->tab_id)
+                     : rhenium::GetActiveWebContents();
+  if (!web_contents) {
+    return RespondNow(
+        Error(kNoTab, base::NumberToString(params->tab_id.value_or(-1))));
+  }
+  const bool bypass_cache = params->reload_properties &&
+                            params->reload_properties->bypass_cache.value_or(
+                                false);
+  web_contents->GetController().Reload(
+      bypass_cache ? content::ReloadType::BYPASSING_CACHE
+                   : content::ReloadType::NORMAL,
+      /*check_for_repost=*/false);
+  return RespondNow(NoArguments());
+}
+
+namespace {
+
+// Onglet actif tel que le voit chrome.tabs.
+tabs::Tab ActiveTab() {
+  content::WebContents* active = rhenium::GetActiveWebContents();
+  for (int index = 0; index < rhenium::GetTabCount(); ++index) {
+    if (rhenium::GetTabAt(index) == active)
+      return MakeTab(active, index);
+  }
+  tabs::Tab tab;
+  tab.id = -1;
+  tab.index = -1;
+  tab.window_id = rhenium::kWindowId;
+  tab.highlighted = tab.active = tab.pinned = tab.incognito = false;
+  tab.discarded = tab.auto_discardable = false;
+  return tab;
+}
+
+}  // namespace
+
+// Une page d'extension s'ouvre par-dessus l'onglet, comme son popup et ses
+// options ; une page web, dans un nouvel onglet. Pas d'onglet en arrière-plan.
+ExtensionFunction::ResponseAction TabsCreateFunction::Run() {
+  auto params = tabs::Create::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  const GURL url = params->create_properties.url
+                       ? extension()->GetResourceURL(
+                             *params->create_properties.url)
+                       : GURL("about:blank");
+  if (!url.is_valid())
+    return RespondNow(Error("Invalid url."));
+  if (url.SchemeIs(kExtensionScheme)) {
+    if (!rhenium::OpenOverlay(browser_context(), url))
+      return RespondNow(Error("Rhénium : page impossible à ouvrir."));
+    tabs::Tab tab = ActiveTab();
+    tab.id = -1;
+    tab.url = url.spec();
+    return RespondNow(ArgumentList(tabs::Create::Results::Create(tab)));
+  }
+  if (!rhenium::OpenTab(url))
+    return RespondNow(Error("Rhénium : trop d'onglets ouverts."));
+  return RespondNow(ArgumentList(tabs::Create::Results::Create(ActiveTab())));
+}
+
+// Sans identifiant : l'onglet actif.
+ExtensionFunction::ResponseAction TabsUpdateFunction::Run() {
+  auto params = tabs::Update::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  const int id = params->tab_id.value_or(
+      rhenium::GetTabId(rhenium::GetActiveWebContents()));
+  content::WebContents* web_contents = rhenium::GetTabWebContents(id);
+  if (!web_contents)
+    return RespondNow(Error(kNoTab, base::NumberToString(id)));
+  const auto& properties = params->update_properties;
+  if (properties.url) {
+    const GURL url = extension()->GetResourceURL(*properties.url);
+    if (!url.is_valid())
+      return RespondNow(Error("Invalid url: \"" + *properties.url + "\"."));
+    web_contents->GetController().LoadURL(
+        url, content::Referrer(), ui::PAGE_TRANSITION_FROM_API, std::string());
+  }
+  if (properties.active.value_or(false))
+    rhenium::ActivateTab(id);
+  for (int index = 0; index < rhenium::GetTabCount(); ++index) {
+    if (rhenium::GetTabAt(index) == web_contents) {
+      return RespondNow(ArgumentList(
+          tabs::Update::Results::Create(MakeTab(web_contents, index))));
+    }
+  }
+  return RespondNow(NoArguments());
+}
+
+}  // namespace extensions
