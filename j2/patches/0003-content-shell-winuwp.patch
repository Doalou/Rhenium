+
+// Secours : une page d'extension chargée dans un cadre créé avant de
+// connaître son site (onglet existant dirigé vers chrome-extension://) n'a
+// pas été activée par RenderFrameCreated. Sans activation, le moteur de
+// rendu la traite comme une page web, sans les API de l'extension.
+void RheniumExtensionWebContentsObserver::ReadyToCommitNavigation(
+    content::NavigationHandle* navigation_handle) {
+  ExtensionWebContentsObserver::ReadyToCommitNavigation(navigation_handle);
+  const GURL& url = navigation_handle->GetURL();
+  if (!url.SchemeIs(kExtensionScheme))
+    return;
+  content::RenderFrameHost* frame = navigation_handle->GetRenderFrameHost();
+  const Extension* extension =
+      ExtensionRegistry::Get(frame->GetBrowserContext())
+          ->enabled_extensions()
+          .GetByID(url.host());
+  if (!extension)
+    return;
+  RendererStartupHelperFactory::GetForBrowserContext(
+      frame->GetBrowserContext())
+      ->ActivateExtensionInProcess(*extension, frame->GetProcess());
+}
