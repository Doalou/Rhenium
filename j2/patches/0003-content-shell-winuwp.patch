+#include "extensions/browser/extension_system.h"
+#include "extensions/browser/extensions_browser_client.h"
+#include "extensions/common/api/extension_action/action_info.h"
+#include "extensions/common/extension.h"
+#include "extensions/common/file_util.h"
+#include "extensions/common/manifest_handlers/options_page_info.h"
+#include "extensions/rhenium/rhenium_extension_system.h"
+#include "extensions/rhenium/rhenium_tab_model.h"
+#include "net/base/net_errors.h"
+#include "net/http/http_response_headers.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "third_party/zlib/google/zip.h"
+#include "url/gurl.h"
+
+namespace rhenium {
+
+namespace {
+
+namespace dnr = extensions::declarative_net_request;
+using extensions::Extension;
+
+// Les .crx du Web Store pèsent rarement plus de quelques Mo.
+constexpr int64_t kMaxCrxSize = 64 * 1024 * 1024;
+
+ExtensionObserver& Observer() {
+  static ExtensionObserver observer;
+  return observer;
+}
+
+raw_ptr<content::BrowserContext> g_context = nullptr;
+
+// Messages montrés par la coquille : en français ou en anglais, comme elle.
+const char* Tr(const char* french, const char* english) {
+  return base::StartsWith(
+             extensions::ExtensionsBrowserClient::Get()->GetApplicationLocale(),
+             "fr")
+             ? french
+             : english;
+}
+
+// Installation en cours : une à la fois.
+struct Install {
+  std::string id;
+  std::unique_ptr<network::SimpleURLLoader> loader;
+};
+std::unique_ptr<Install>& CurrentInstall() {
+  static base::NoDestructor<std::unique_ptr<Install>> install;
+  return *install;
+}
+
+extensions::RheniumExtensionSystem* System() {
+  return static_cast<extensions::RheniumExtensionSystem*>(
+      extensions::ExtensionSystem::Get(g_context));
+}
+
+void Done(bool ok, const std::string& text) {
+  CurrentInstall().reset();
+  if (ok)
+    LOG(INFO) << "Rhenium : extension " << text << " installée";
+  else
+    LOG(ERROR) << "Rhenium : installation impossible : " << text;
+  if (Observer().install_done) {
+    Observer().install_done(Observer().context, ok,
+                            base::UTF8ToWide(text).c_str());
+  }
+}
+
+struct Unpacked {
+  scoped_refptr<Extension> extension;
+  dnr::RulesetInstallPrefs ruleset_prefs;
+  std::string error;
+};
+
+// Hors du thread UI : vérification, décompression, lecture et indexation des
+// règles DNR, comme le fait CrxInstaller de //chrome.
+Unpacked Unpack(const base::FilePath& crx,
+                const base::FilePath& dir,
+                const std::string& id) {
+  Unpacked result;
+  std::string crx_id;
+  // Preuve de l'éditeur : seul le Web Store signe ces paquets.
+  const crx_file::VerifierResult verified = crx_file::Verify(
+      crx, crx_file::VerifierFormat::CRX3_WITH_PUBLISHER_PROOF, {}, {},
+      nullptr, &crx_id, nullptr);
+  int64_t size = 0;
+  if (base::GetFileSize(crx, &size) && size == 0) {
+    // Réponse vide du Web Store : extension retirée, ou qui demande une
+    // version de Chromium plus récente.
+    result.error = Tr("extension introuvable ou trop récente pour Chromium ",
+                      "extension not found or too recent for Chromium ") +
+                   std::string(version_info::GetVersionNumber());
+  } else if (verified != crx_file::VerifierResult::OK_FULL) {
+    result.error = base::StringPrintf(
+        Tr("paquet non vérifié (%d)", "package not verified (%d)"),
+        static_cast<int>(verified));
+  } else if (crx_id != id) {
+    result.error =
+        Tr("paquet d'une autre extension", "package of another extension");
+  }
+  const base::FilePath partial = dir.AddExtensionASCII("partial");
+  base::DeletePathRecursively(partial);
+  if (result.error.empty()) {
+    // L'en-tête du .crx précède l'archive zip, que le lecteur retrouve par
+    // sa fin.
+    if (!zip::Unzip(crx, partial) || !base::DeletePathRecursively(dir) ||
+        !base::Move(partial, dir)) {
+      result.error = Tr("décompression impossible", "could not unpack");
+    }
+  }
+  base::DeleteFile(crx);
+  if (!result.error.empty()) {
+    base::DeletePathRecursively(partial);
+    return result;
+  }
+
+  result.extension = extensions::file_util::LoadExtension(
+      dir, id, extensions::mojom::ManifestLocation::kInternal,
+      Extension::FROM_WEBSTORE, &result.error);
+  if (result.extension) {
+    dnr::InstallIndexHelper::Result index =
+        dnr::InstallIndexHelper::IndexStaticRulesetsUnsafe(
+            *result.extension,
+            dnr::FileBackedRulesetSource::RulesetFilter::kIncludeManifestEnabled,
+            dnr::RulesetSource::kRaiseWarningOnLargeRegexRules);
+    if (index.error) {
+      result.extension = nullptr;
+      result.error = *index.error;
+    } else {
+      result.ruleset_prefs = std::move(index.ruleset_install_prefs);
+    }
+  }
+  if (!result.extension)
+    base::DeletePathRecursively(dir);
+  return result;
+}
+
+void OnUnpacked(Unpacked unpacked) {
+  if (!g_context || !unpacked.extension) {
+    Done(false, unpacked.error);
+    return;
+  }
+  for (const auto& warning : unpacked.extension->install_warnings()) {
+    LOG(WARNING) << "Rhenium : " << unpacked.extension->name() << " : "
+                 << warning.message;
+  }
+  const std::string name = unpacked.extension->name();
+  System()->AddWebStoreExtension(std::move(unpacked.extension),
+                                 unpacked.ruleset_prefs);
+  Done(true, name);
+}
+
+void OnDownloaded(base::FilePath crx) {
+  Install* install = CurrentInstall().get();
+  if (!install)
+    return;
+  if (crx.empty()) {
+    const network::mojom::URLResponseHead* head =
+        install->loader->ResponseInfo();
+    Done(false,
+         head && head->headers
+             ? base::StringPrintf(Tr("téléchargement refusé (HTTP %d)",
+                                     "download refused (HTTP %d)"),
+                                  head->headers->response_code())
+             : base::StringPrintf(
+                   Tr("téléchargement impossible (%s)", "download failed (%s)"),
+                   net::ErrorToShortString(install->loader->NetError())
+                       .c_str()));
+    return;
+  }
+  const base::FilePath dir = System()->InstallDir().AppendASCII(install->id);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&Unpack, crx, dir, install->id),
+      base::BindOnce(&OnUnpacked));
+}
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("rhenium_webstore_install", R"(
+        semantics {
+          sender: "Rhénium"
+          description: "Télécharge une extension du Chrome Web Store."
+          trigger: "L'utilisateur choisit « Ajouter à Rhénium »."
+          data: "Identifiant de l'extension et version de Chromium."
+          destination: GOOGLE_OWNED_SERVICE
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "Aucun : l'installation est demandée par l'utilisateur."
+        })");
+
+const Extension* FindInstalled(const std::string& id) {
+  if (!g_context)
+    return nullptr;
+  return extensions::ExtensionRegistry::Get(g_context)->GetInstalledExtension(
+      id);
+}
+
+}  // namespace
+
+void InitExtensions(const ExtensionObserver& observer) {
+  Observer() = observer;
+}
+
+void SetExtensionContext(content::BrowserContext* context) {
+  g_context = context;
+}
+
+void ForEachExtension(void (*visit)(void* context,
+                                    const char* id,
+                                    const wchar_t* name,
+                                    const wchar_t* version,
+                                    int enabled,
+                                    int removable,
+                                    int has_popup,
+                                    int has_options),
+                      void* context) {
+  if (!g_context)
+    return;
+  extensions::ExtensionRegistry* registry =
+      extensions::ExtensionRegistry::Get(g_context);
+  std::vector<scoped_refptr<const Extension>> all;
+  for (const auto& set :
+       {&registry->enabled_extensions(), &registry->disabled_extensions()}) {
+    for (const auto& extension : *set)
+      all.push_back(extension);
+  }
+  std::sort(all.begin(), all.end(), [](const auto& a, const auto& b) {
+    const bool a_bundled =
+        a->location() != extensions::mojom::ManifestLocation::kInternal;
+    const bool b_bundled =
+        b->location() != extensions::mojom::ManifestLocation::kInternal;
+    if (a_bundled != b_bundled)
+      return a_bundled;
+    return base::ToLowerASCII(a->name()) < base::ToLowerASCII(b->name());
+  });
+  for (const auto& extension : all) {
+    const extensions::ActionInfo* action =
+        extensions::ActionInfo::GetExtensionActionInfo(extension.get());
+    visit(context, extension->id().c_str(),
+          base::UTF8ToWide(extension->name()).c_str(),
+          base::UTF8ToWide(extension->VersionString()).c_str(),
+          registry->enabled_extensions().Contains(extension->id()),
+          extension->location() == extensions::mojom::ManifestLocation::kInternal,
+          action && action->default_popup_url.is_valid(),
+          extensions::OptionsPageInfo::GetOptionsPage(extension.get())
+              .is_valid());
+  }
+}
+
+bool SetExtensionEnabled(const std::string& id, bool enabled) {
+  if (!FindInstalled(id))
+    return false;
+  System()->SetExtensionEnabled(id, enabled);
+  LOG(INFO) << "Rhenium : extension " << id
+            << (enabled ? " activée" : " désactivée");
+  return true;
+}
+
+bool UninstallExtension(const std::string& id) {
+  if (!FindInstalled(id) || !System()->UninstallExtension(id))
+    return false;
+  LOG(INFO) << "Rhenium : extension " << id << " supprimée";
+  return true;
+}
+
+bool OpenExtensionPopup(const std::string& id) {
+  const Extension* extension =
+      g_context ? extensions::ExtensionRegistry::Get(g_context)
+                      ->enabled_extensions()
+                      .GetByID(id)
+                : nullptr;
+  const extensions::ActionInfo* action =
+      extension ? extensions::ActionInfo::GetExtensionActionInfo(extension)
+                : nullptr;
+  return action && OpenOverlay(g_context, action->default_popup_url);
+}
+
+bool OpenExtensionOptions(const std::string& id) {
+  const Extension* extension =
+      g_context ? extensions::ExtensionRegistry::Get(g_context)
+                      ->enabled_extensions()
+                      .GetByID(id)
+                : nullptr;
+  return extension &&
+         OpenOverlay(g_context,
+                     extensions::OptionsPageInfo::GetOptionsPage(extension));
+}
+
+// chromewebstore.google.com/detail/<nom>/<id>, et l'ancienne adresse
+// chrome.google.com/webstore/detail/<nom>/<id>.
+std::string WebStoreExtensionId(const GURL& url) {
+  if (!url.SchemeIs(url::kHttpsScheme) ||
+      (url.host_piece() != "chromewebstore.google.com" &&
+       url.host_piece() != "chrome.google.com")) {
+    return std::string();
+  }
+  const std::vector<std::string> parts = base::SplitString(
+      url.path_piece(), "/", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  const auto detail = std::find(parts.begin(), parts.end(), "detail");
+  if (detail == parts.end())
+    return std::string();
+  for (auto part = detail + 1; part != parts.end(); ++part) {
+    if (crx_file::id_util::IdIsValid(*part))
+      return *part;
+  }
+  return std::string();
+}
+
+bool InstallFromWebStore(const std::string& id) {
+  if (!g_context || CurrentInstall() || !crx_file::id_util::IdIsValid(id))
+    return false;
+  if (const Extension* installed = FindInstalled(id)) {
+    if (Observer().install_done) {
+      Observer().install_done(
+          Observer().context, true,
+          base::UTF8ToWide(installed->name() +
+                           Tr(" (déjà installée)", " (already installed)"))
+              .c_str());
+    }
+    return true;
+  }
+  LOG(INFO) << "Rhenium : installation de " << id << " depuis le Web Store";
+  auto request = std::make_unique<network::ResourceRequest>();
+  // Même requête que Chrome pour une installation à la demande.
+  request->url = GURL(base::StringPrintf(
+      "https://clients2.google.com/service/update2/crx?response=redirect"
+      "&acceptformat=crx3&prodversion=%s"
+      "&x=id%%3D%s%%26installsource%%3Dondemand%%26uc",
+      std::string(version_info::GetVersionNumber()).c_str(), id.c_str()));
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  auto install = std::make_unique<Install>();
+  install->id = id;
+  install->loader =
+      network::SimpleURLLoader::Create(std::move(request), kTrafficAnnotation);
+  network::SimpleURLLoader* loader = install->loader.get();
+  CurrentInstall() = std::move(install);
+  loader->DownloadToFile(
+      g_context->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess()
+          .get(),
+      base::BindOnce(&OnDownloaded),
+      System()->InstallDir().AppendASCII(id + ".crx"), kMaxCrxSize);
+  return true;
+}
+
+}  // namespace rhenium
