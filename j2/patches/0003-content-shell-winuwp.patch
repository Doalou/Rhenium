+constexpr base::TimeDelta kEnterDedup = base::Milliseconds(300);
+constexpr base::TimeDelta kEditSettle = base::Milliseconds(500);
+
+text_core::CoreTextInputScope ToInputScope(TextInputType type) {
+  switch (type) {
+    case TEXT_INPUT_TYPE_PASSWORD:
+      return text_core::CoreTextInputScope_Password;
+    case TEXT_INPUT_TYPE_SEARCH:
+      return text_core::CoreTextInputScope_Search;
+    case TEXT_INPUT_TYPE_EMAIL:
+      return text_core::CoreTextInputScope_EmailAddress;
+    case TEXT_INPUT_TYPE_NUMBER:
+      return text_core::CoreTextInputScope_Number;
+    case TEXT_INPUT_TYPE_TELEPHONE:
+      return text_core::CoreTextInputScope_TelephoneNumber;
+    case TEXT_INPUT_TYPE_URL:
+      return text_core::CoreTextInputScope_Url;
+    default:
+      return text_core::CoreTextInputScope_Text;
+  }
+}
+
+text_core::CoreTextRange ToCoreRange(const gfx::Range& range) {
+  return {static_cast<INT32>(range.GetMin()),
+          static_cast<INT32>(range.GetMax())};
+}
+
+gfx::Range FromCoreRange(const text_core::CoreTextRange& range) {
+  return gfx::Range(static_cast<uint32_t>(range.StartCaretPosition),
+                    static_cast<uint32_t>(range.EndCaretPosition));
+}
