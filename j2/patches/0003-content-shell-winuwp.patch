+#if RHENIUM_NARROW_CODE_WRITES
+namespace {
+
+// Pages de 4 Ko de la zone d'objets qui couvrent [start, start + size).
+bool CodeWriteRegion(const MemoryChunk* chunk, Address start, size_t size,
+                     Address* region_start, size_t* region_size) {
+  size_t page_size = MemoryAllocator::GetCommitPageSize();
+  Address area_start =
+      chunk->address() + MemoryChunkLayout::ObjectPageOffsetInCodePage();
+  Address area_end = area_start + RoundUp(chunk->area_size(), page_size);
+  Address begin = std::max(RoundDown(start, page_size), area_start);
+  Address end = std::min(RoundUp(start + size, page_size), area_end);
+  if (begin >= end) return false;
+  *region_start = begin;
+  *region_size = end - begin;
+  return true;
+}
+
+}  // namespace
+#endif  // RHENIUM_NARROW_CODE_WRITES
+
+base::MutexGuard MemoryChunk::SetCodeModificationPermissions(Address start,
+                                                             size_t size) {
+#if RHENIUM_NARROW_CODE_WRITES
+  Address region_start;
+  size_t region_size;
+  if (size != 0 &&
+      CodeWriteRegion(this, start, size, &region_start, &region_size)) {
+    DCHECK(IsFlagSet(MemoryChunk::IS_EXECUTABLE));
+    DCHECK(owner_identity() == CODE_SPACE || owner_identity() == CODE_LO_SPACE);
+    base::MutexGuard guard(page_protection_change_mutex_);
+    CHECK(reservation_.SetPermissions(
+        region_start, region_size, MemoryChunk::GetCodeModificationPermission()));
+    return guard;
+  }
+#endif
+  return SetCodeModificationPermissions();
+}
+
+void MemoryChunk::SetDefaultCodePermissions(Address start, size_t size) {
+#if RHENIUM_NARROW_CODE_WRITES
+  Address region_start;
+  size_t region_size;
+  if (size != 0 &&
+      CodeWriteRegion(this, start, size, &region_start, &region_size)) {
+    page_protection_change_mutex_->AssertHeld();
+    CHECK(reservation_.SetPermissions(
+        region_start, region_size,
+        v8_flags.jitless ? PageAllocator::kRead
+                         : PageAllocator::kReadExecute));
+    return;
+  }
+#endif
+  SetDefaultCodePermissions();
+}
