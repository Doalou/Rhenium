+void RheniumExtensionWebContentsObserver::CreateForWebContents(
+    content::WebContents* web_contents) {
+  content::WebContentsUserData<
+      RheniumExtensionWebContentsObserver>::CreateForWebContents(web_contents);
+  FromWebContents(web_contents)->Initialize();
+}
