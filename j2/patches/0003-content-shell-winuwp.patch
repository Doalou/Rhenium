+
+class RheniumRuntimeAPIDelegate : public RuntimeAPIDelegate {
+ public:
+  void AddUpdateObserver(UpdateObserver* observer) override {}
+  void RemoveUpdateObserver(UpdateObserver* observer) override {}
+  void ReloadExtension(const std::string& extension_id) override {}
+  bool CheckForUpdates(const std::string& extension_id,
+                       UpdateCheckCallback callback) override {
+    return false;
+  }
+  void OpenURL(const GURL& uninstall_url) override {}
+  bool GetPlatformInfo(api::runtime::PlatformInfo* info) override {
+    info->os = api::runtime::PlatformOs::kWin;
+    info->arch = api::runtime::PlatformArch::kArm;
+    info->nacl_arch = api::runtime::PlatformNaclArch::kArm;
+    return true;
+  }
+  bool RestartDevice(std::string* error_message) override {
+    *error_message = "Restart is not supported.";
+    return false;
+  }
+  // La page d'options (tableau de bord de uBO Lite) remplace le popup
+  // par-dessus l'onglet. Seulement depuis une page d'extension déjà ouverte :
+  // uBO Lite la demande aussi à sa première exécution, ce qui couvrirait la
+  // page au premier lancement.
+  bool OpenOptionsPage(const Extension* extension,
+                       content::BrowserContext* browser_context) override {
+    const GURL url = OptionsPageInfo::GetOptionsPage(extension);
+    return url.is_valid() && rhenium::IsOverlayOpen() &&
+           rhenium::OpenOverlay(browser_context, url);
+  }
+};
