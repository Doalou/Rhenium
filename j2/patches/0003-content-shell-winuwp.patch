+void InputMethodUwp::OnTextInputTypeChanged(TextInputClient* client) {
+  InputMethodBase::OnTextInputTypeChanged(client);
+  VLOG(1) << "Saisie : type " << client->GetTextInputType() << ", client "
+            << (IsTextInputClientFocused(client) ? "focalisé" : "non focalisé");
+  if (IsTextInputClientFocused(client))
+    UpdateFocus(/*restart=*/false);
+}
