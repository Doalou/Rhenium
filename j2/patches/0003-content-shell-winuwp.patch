diff --git a/content/shell/browser/shell_uwp_host.h b/content/shell/browser/shell_uwp_host.h
new file mode 100644
index 0000000000..38feab6593
--- /dev/null
+++ b/content/shell/browser/shell_uwp_host.h
@@ -0,0 +1,49 @@
+// Copyright 2026 Doalo
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_SHELL_BROWSER_SHELL_UWP_HOST_H_
+#define CONTENT_SHELL_BROWSER_SHELL_UWP_HOST_H_
+
+class GURL;
+
+namespace content {
+
+// Rhénium : rappels vers la coquille XAML de l'app UWP (barre d'adresse,
+// précédent, chargement), appelés sur le thread UI par le délégué de
+// plateforme Aura de content_shell pour le Shell actif.
+struct ShellUwpHost {
+  void* context = nullptr;
+  void (*url_changed)(void* context, const wchar_t* url) = nullptr;
+  void (*loading_changed)(void* context,
+                          int loading,
+                          int can_go_back,
+                          int can_go_forward) = nullptr;
+  void (*title_changed)(void* context, const wchar_t* title) = nullptr;
+  void (*progress_changed)(void* context, double progress) = nullptr;
+  // Adresse montrée pour celle de la page (liseuse PDF : celle du PDF).
+  GURL (*displayed_url)(const GURL& url) = nullptr;
+};
+
+void SetShellUwpHost(const ShellUwpHost& host);
+
+class Shell;
+
+// Onglets, tenus par l'app : elle apprend la création de chaque Shell (onglet
+// ou page d'extension) et décide de la suite de window.close() (vrai si elle
+// s'en charge).
+struct ShellUwpTabs {
+  void (*created)(Shell* shell) = nullptr;
+  bool (*close_requested)(Shell* shell) = nullptr;
+};
+
+void SetShellUwpTabs(const ShellUwpTabs& tabs);
+bool RequestUwpShellClose(Shell* shell);
+
+// Shell dont la barre montre l'état (adresse, chargement, titre), qui lui est
+// aussitôt envoyé.
+void SetUwpActiveShell(Shell* shell);
+
+}  // namespace content
+
+#endif  // CONTENT_SHELL_BROWSER_SHELL_UWP_HOST_H_
