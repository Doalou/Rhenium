diff --git a/ui/gfx/win/uwp_core_window.cc b/ui/gfx/win/uwp_core_window.cc
new file mode 100644
index 0000000000..251426790f
--- /dev/null
+++ b/ui/gfx/win/uwp_core_window.cc
@@ -0,0 +1,150 @@
+// Copyright 2026 Doalo
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/gfx/win/uwp_core_window.h"
+
+#include <windows.foundation.h>
+#include <windows.graphics.display.h>
+#include <windows.ui.core.h>
+#include <wrl/wrappers/corewrappers.h>
+
+#include <cmath>
+
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+#include "base/win/core_winrt_util.h"
+
+namespace gfx::uwp {
+
+namespace {
+
+using ABI::Windows::Foundation::Rect;
+using ABI::Windows::Graphics::Display::IDisplayInformation;
+using ABI::Windows::Graphics::Display::IDisplayInformation2;
+using ABI::Windows::Graphics::Display::IDisplayInformationStatics;
+using ABI::Windows::UI::Core::ICoreWindow;
+using ABI::Windows::UI::Core::ICoreWindowStatic;
+using Microsoft::WRL::ComPtr;
+using Microsoft::WRL::Wrappers::HStringReference;
+
+struct Shared {
+  base::Lock lock;
+  ComPtr<IUnknown> window;
+  bool hosted = false;
+  gfx::Size hosted_size;
+  float hosted_scale = 1.0f;
+  SwapChainAttacher attacher = nullptr;
+  void* attacher_context = nullptr;
+};
+
+Shared& GetShared() {
+  static base::NoDestructor<Shared> shared;
+  return *shared;
+}
+
+}  // namespace
+
+bool GetCoreWindowMetrics(gfx::Size* pixel_size, float* scale) {
+  ComPtr<ICoreWindowStatic> window_statics;
+  ComPtr<ICoreWindow> window;
+  HRESULT hr = base::win::RoGetActivationFactory(
+      HStringReference(RuntimeClass_Windows_UI_Core_CoreWindow).Get(),
+      IID_PPV_ARGS(&window_statics));
+  if (SUCCEEDED(hr))
+    hr = window_statics->GetForCurrentThread(&window);
+  if (FAILED(hr) || !window)
+    return false;
+  {
+    Shared& shared = GetShared();
+    base::AutoLock auto_lock(shared.lock);
+    shared.window = window;
+    if (shared.hosted) {
+      *pixel_size = shared.hosted_size;
+      *scale = shared.hosted_scale;
+      return true;
+    }
+  }
+  Rect bounds = {};
+  if (FAILED(window->get_Bounds(&bounds)))
+    return false;
+
+  double raw_scale = 1.0;
+  ComPtr<IDisplayInformationStatics> display_statics;
+  ComPtr<IDisplayInformation> display;
+  ComPtr<IDisplayInformation2> display2;
+  hr = base::win::RoGetActivationFactory(
+      HStringReference(RuntimeClass_Windows_Graphics_Display_DisplayInformation)
+          .Get(),
+      IID_PPV_ARGS(&display_statics));
+  if (SUCCEEDED(hr))
+    hr = display_statics->GetForCurrentView(&display);
+  if (SUCCEEDED(hr))
+    hr = display.As(&display2);
+  if (SUCCEEDED(hr))
+    display2->get_RawPixelsPerViewPixel(&raw_scale);
+  if (raw_scale <= 0)
+    raw_scale = 1.0;
+
+  *scale = static_cast<float>(raw_scale);
+  *pixel_size =
+      gfx::Size(static_cast<int>(std::lround(bounds.Width * raw_scale)),
+                static_cast<int>(std::lround(bounds.Height * raw_scale)));
+
+  Shared& shared = GetShared();
+  base::AutoLock auto_lock(shared.lock);
+  shared.window = window;
+  return true;
+}
+
+void SetHostedContentArea(const gfx::Size& pixel_size,
+                          float scale,
+                          SwapChainAttacher attacher,
+                          void* context) {
+  Shared& shared = GetShared();
+  base::AutoLock auto_lock(shared.lock);
+  shared.hosted = true;
+  shared.hosted_size = pixel_size;
+  shared.hosted_scale = scale;
+  shared.attacher = attacher;
+  shared.attacher_context = context;
+}
+
+void UpdateHostedSize(const gfx::Size& pixel_size) {
+  Shared& shared = GetShared();
+  base::AutoLock auto_lock(shared.lock);
+  shared.hosted_size = pixel_size;
+}
+
+bool IsHosted() {
+  Shared& shared = GetShared();
+  base::AutoLock auto_lock(shared.lock);
+  return shared.hosted;
+}
+
+float GetHostedScale() {
+  Shared& shared = GetShared();
+  base::AutoLock auto_lock(shared.lock);
+  return shared.hosted_scale;
+}
+
+void AttachSwapChain(IUnknown* swap_chain) {
+  SwapChainAttacher attacher;
+  void* context;
+  {
+    Shared& shared = GetShared();
+    base::AutoLock auto_lock(shared.lock);
+    attacher = shared.attacher;
+    context = shared.attacher_context;
+  }
+  if (attacher)
+    attacher(context, swap_chain);
+}
+
+ComPtr<IUnknown> GetCoreWindow() {
+  Shared& shared = GetShared();
+  base::AutoLock auto_lock(shared.lock);
+  return shared.window;
+}
+
+}  // namespace gfx::uwp
