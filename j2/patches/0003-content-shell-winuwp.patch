diff --git a/extensions/rhenium/BUILD.gn b/extensions/rhenium/BUILD.gn
new file mode 100644
index 0000000000..48b5455b1a
--- /dev/null
+++ b/extensions/rhenium/BUILD.gn
@@ -0,0 +1,97 @@
+# Copyright 2026 Doalo
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+# Rhénium : système d'extensions greffé sur content_shell en un seul
+# processus, d'après app_shell (extensions/shell), réduit aux API dont
+# uBlock Origin Lite a besoin. Lié par l'app (rhenium_shell).
+
+import("//extensions/buildflags/buildflags.gni")
+import("//tools/grit/repack.gni")
+
+assert(enable_extensions)
+
+source_set("rhenium") {
+  testonly = true  # content_shell_lib
+  sources = [
+    "rhenium_downloads.cc",
+    "rhenium_downloads.h",
+    "rhenium_extension_manager.cc",
+    "rhenium_extension_manager.h",
+    "rhenium_extension_system.cc",
+    "rhenium_extension_system.h",
+    "rhenium_extensions_browser_client.cc",
+    "rhenium_extensions_browser_client.h",
+    "rhenium_extensions_client.cc",
+    "rhenium_extensions_client.h",
+    "rhenium_l10n_message_filter.cc",
+    "rhenium_l10n_message_filter.h",
+    "rhenium_pdf.cc",
+    "rhenium_pdf.h",
+    "rhenium_main_delegate.cc",
+    "rhenium_main_delegate.h",
+    "rhenium_permissions_api.cc",
+    "rhenium_permissions_api.h",
+    "rhenium_scripting_api.cc",
+    "rhenium_scripting_api.h",
+    "rhenium_tab_model.cc",
+    "rhenium_tab_model.h",
+    "rhenium_tabs_api.cc",
+    "rhenium_tabs_api.h",
+    "rhenium_ui_api.cc",
+    "rhenium_ui_api.h",
+  ]
+  deps = [
+    "//base",
+    "//components/crx_file",
+    "//components/download/public/common:public",
+    "//components/keyed_service/content",
+    "//components/pref_registry",
+    "//components/prefs",
+    "//components/sync",
+    "//components/user_prefs",
+    "//components/value_store",
+    "//components/version_info",
+    "//content/public/browser",
+    "//content/public/common",
+    "//content/public/renderer",
+    "//content/shell:content_shell_app",
+    "//content/shell:content_shell_lib",
+    "//extensions/browser",
+    "//extensions/common",
+    "//extensions/common:core_api_provider",
+    "//extensions/common/api",
+    "//extensions/renderer",
+    "//extensions/rhenium/api",
+    "//ipc",
+    "//net",
+    "//services/network/public/cpp",
+    "//services/network/public/mojom",
+    "//skia",
+    "//third_party/blink/public:blink",
+    "//third_party/blink/public/common",
+    "//third_party/zlib/google:zip",
+    "//ui/aura",
+    "//ui/base",
+    "//ui/compositor",
+    "//ui/gfx/geometry",
+    "//url",
+  ]
+  data_deps = [ ":pak" ]
+}
+
+# Ressources des extensions (liaisons JS du moteur de rendu, schémas des API,
+# chaînes), chargées à côté de content_shell.pak.
+repack("pak") {
+  sources = [
+    "$root_gen_dir/extensions/extensions_browser_resources_100_percent.pak",
+    "$root_gen_dir/extensions/extensions_renderer_resources.pak",
+    "$root_gen_dir/extensions/extensions_resources.pak",
+    "$root_gen_dir/extensions/strings/extensions_strings_en-US.pak",
+  ]
+  output = "$root_out_dir/rhenium_extensions.pak"
+  deps = [
+    "//extensions:extensions_resources",
+    "//extensions/strings",
+  ]
+}
diff --git a/extensions/rhenium/api/BUILD.gn b/extensions/rhenium/api/BUILD.gn
