+
+ExtensionUserScriptLoader* GetLoader(content::BrowserContext* context,
+                                     const ExtensionId& id) {
+  return ExtensionSystem::Get(context)
+      ->user_script_manager()
+      ->GetUserScriptLoaderForExtension(id);
+}
+
+mojom::RunLocation ToRunLocation(scripting_api::RunAt run_at) {
+  switch (run_at) {
+    case scripting_api::RUN_AT_DOCUMENT_START:
+      return mojom::RunLocation::kDocumentStart;
+    case scripting_api::RUN_AT_DOCUMENT_END:
+      return mojom::RunLocation::kDocumentEnd;
+    default:
+      return mojom::RunLocation::kDocumentIdle;
+  }
+}
+
+scripting_api::RunAt FromRunLocation(mojom::RunLocation location) {
+  switch (location) {
+    case mojom::RunLocation::kDocumentStart:
+      return scripting_api::RUN_AT_DOCUMENT_START;
+    case mojom::RunLocation::kDocumentEnd:
+      return scripting_api::RUN_AT_DOCUMENT_END;
+    default:
+      return scripting_api::RUN_AT_DOCUMENT_IDLE;
+  }
+}
+
+// Comme ConvertValueToScripts (extension_user_script_loader.cc).
+std::unique_ptr<UserScript> ToUserScript(
+    const Extension& extension,
+    const scripting_api::RegisteredContentScript& in,
+    std::u16string* error) {
+  if (!in.matches || in.matches->empty()) {
+    *error = u"Script with ID '" + base::UTF8ToUTF16(in.id) +
+             u"' must specify 'matches'.";
+    return nullptr;
+  }
+  auto script = std::make_unique<UserScript>();
+  script->set_id(in.id);
+  script->set_host_id(
+      mojom::HostID(mojom::HostID::HostType::kExtensions, extension.id()));
+  if (in.all_frames)
+    script->set_match_all_frames(*in.all_frames);
+  script->set_match_origin_as_fallback(
+      in.match_origin_as_fallback.value_or(false)
+          ? MatchOriginAsFallbackBehavior::kAlways
+          : MatchOriginAsFallbackBehavior::kNever);
+  script->set_run_location(ToRunLocation(in.run_at));
+  script->set_execution_world(in.world == scripting_api::EXECUTION_WORLD_MAIN
+                                  ? mojom::ExecutionWorld::kMain
+                                  : mojom::ExecutionWorld::kIsolated);
+  const int valid_schemes = UserScript::ValidUserScriptSchemes(
+      scripting::kScriptsCanExecuteEverywhere);
+  if (!script_parsing::ParseMatchPatterns(
+          *in.matches, base::OptionalToPtr(in.exclude_matches),
+          /*definition_index=*/0, extension.creation_flags(),
+          scripting::kScriptsCanExecuteEverywhere, valid_schemes,
+          scripting::kAllUrlsIncludesChromeUrls, script.get(), error,
+          /*wants_file_access=*/nullptr) ||
+      !script_parsing::ParseFileSources(
+          &extension, base::OptionalToPtr(in.js), base::OptionalToPtr(in.css),
+          /*definition_index=*/0, script.get(), error)) {
+    return nullptr;
+  }
+  return script;
+}
+
+scripting_api::RegisteredContentScript FromUserScript(
+    const UserScript& script) {
+  scripting_api::RegisteredContentScript out;
+  out.id = script.id();
+  out.matches.emplace();
+  for (const URLPattern& pattern : script.url_patterns())
+    out.matches->push_back(pattern.GetAsString());
+  if (!script.exclude_url_patterns().is_empty()) {
+    out.exclude_matches.emplace();
+    for (const URLPattern& pattern : script.exclude_url_patterns())
+      out.exclude_matches->push_back(pattern.GetAsString());
+  }
+  if (!script.js_scripts().empty()) {
+    out.js.emplace();
+    for (const auto& file : script.js_scripts())
+      out.js->push_back(file->relative_path().AsUTF8Unsafe());
+  }
+  if (!script.css_scripts().empty()) {
+    out.css.emplace();
+    for (const auto& file : script.css_scripts())
+      out.css->push_back(file->relative_path().AsUTF8Unsafe());
+  }
+  out.all_frames = script.match_all_frames();
+  out.match_origin_as_fallback = script.match_origin_as_fallback() ==
+                                 MatchOriginAsFallbackBehavior::kAlways;
+  out.run_at = FromRunLocation(script.run_location());
+  out.persist_across_sessions = false;
+  out.world = script.execution_world() == mojom::ExecutionWorld::kMain
+                  ? scripting_api::EXECUTION_WORLD_MAIN
+                  : scripting_api::EXECUTION_WORLD_ISOLATED;
+  return out;
+}
+
+}  // namespace
+
+// Rhénium : chrome.scripting.executeScript, d'après
+// chrome/browser/extensions/api/scripting/scripting_api.cc.
+ScriptingExecuteScriptFunction::~ScriptingExecuteScriptFunction() = default;
+
+ExtensionFunction::ResponseAction ScriptingExecuteScriptFunction::Run() {
+  auto params = scripting_api::ExecuteScript::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  scripting_api::ScriptInjection& injection = params->injection;
+  tab_id_ = injection.target.tab_id;
+  all_frames_ = injection.target.all_frames.value_or(false);
+  if (injection.target.frame_ids)
+    frame_ids_ = *injection.target.frame_ids;
+  main_world_ = injection.world == scripting_api::EXECUTION_WORLD_MAIN;
+  inject_immediately_ = injection.inject_immediately.value_or(false);
+
+  if (injection.func.has_value() == injection.files.has_value()) {
+    return RespondNow(
+        Error("Exactly one of 'func' and 'files' must be specified"));
+  }
+  if (injection.func) {
+    std::string arguments;
+    const base::Value::List no_args;
+    for (const base::Value& arg : injection.args ? *injection.args : no_args) {
+      std::string json;
+      if (!base::JSONWriter::Write(arg, &json))
+        return RespondNow(Error("Unserializable argument passed."));
+      arguments += (arguments.empty() ? "" : ",") + json;
+    }
+    std::vector<mojom::JSSourcePtr> sources;
+    sources.push_back(mojom::JSSource::New(
+        "(" + *injection.func + ")(" + arguments + ")", GURL()));
+    Execute(std::move(sources));
+    return did_respond() ? AlreadyResponded() : RespondLater();
+  }
+  if (injection.args)
+    return RespondNow(Error("'args' may only be used with 'func'."));
+
+  // Fichiers de l'extension, lus hors du thread de l'interface.
+  std::vector<std::pair<ExtensionResource, GURL>> files;
+  for (const std::string& file : *injection.files) {
+    ExtensionResource resource = extension()->GetResource(file);
+    if (resource.extension_root().empty() || resource.relative_path().empty())
+      return RespondNow(Error("Could not load file: '" + file + "'."));
+    files.emplace_back(std::move(resource), extension()->GetResourceURL(file));
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce(
+          [](std::vector<std::pair<ExtensionResource, GURL>> files) {
+            std::pair<std::vector<mojom::JSSourcePtr>, std::string> result;
+            for (const auto& [resource, url] : files) {
+              std::string code;
+              if (!base::ReadFileToString(resource.GetFilePath(), &code)) {
+                result.second = "Could not load file: '" +
+                                resource.relative_path().AsUTF8Unsafe() + "'.";
+                return result;
+              }
+              result.first.push_back(mojom::JSSource::New(std::move(code), url));
+            }
+            return result;
+          },
+          std::move(files)),
+      base::BindOnce(
+          [](scoped_refptr<ScriptingExecuteScriptFunction> function,
+             std::pair<std::vector<mojom::JSSourcePtr>, std::string> result) {
+            function->OnFilesRead(std::move(result.first),
+                                  std::move(result.second));
+          },
+          base::WrapRefCounted(this)));
+  return RespondLater();
+}
+
+void ScriptingExecuteScriptFunction::OnFilesRead(
+    std::vector<mojom::JSSourcePtr> sources,
+    std::string error) {
+  if (!error.empty()) {
+    Respond(Error(error));
+    return;
+  }
+  Execute(std::move(sources));
+}
+
+void ScriptingExecuteScriptFunction::Execute(
+    std::vector<mojom::JSSourcePtr> sources) {
+  content::WebContents* web_contents = rhenium::GetTabWebContents(tab_id_);
+  if (!web_contents) {
+    Respond(Error("No tab with id: " + base::NumberToString(tab_id_)));
+    return;
+  }
+  ScriptExecutor::FrameScope scope = ScriptExecutor::SPECIFIED_FRAMES;
+  std::set<int> frame_ids(frame_ids_.begin(), frame_ids_.end());
+  if (all_frames_) {
+    scope = ScriptExecutor::INCLUDE_SUB_FRAMES;
+    frame_ids = {ExtensionApiFrameIdMap::kTopFrameId};
+  } else if (frame_ids.empty()) {
+    frame_ids.insert(ExtensionApiFrameIdMap::kTopFrameId);
+  }
+  executor_ = std::make_unique<ScriptExecutor>(web_contents);
+  executor_->ExecuteScript(
+      mojom::HostID(mojom::HostID::HostType::kExtensions, extension()->id()),
+      mojom::CodeInjection::NewJs(mojom::JSInjection::New(
+          std::move(sources),
+          main_world_ ? mojom::ExecutionWorld::kMain
+                      : mojom::ExecutionWorld::kIsolated,
+          blink::mojom::WantResultOption::kWantResult,
+          blink::mojom::UserActivationOption::kDoNotActivate,
+          blink::mojom::PromiseResultOption::kAwait)),
+      scope, frame_ids, ScriptExecutor::MATCH_ABOUT_BLANK,
+      inject_immediately_ ? mojom::RunLocation::kDocumentStart
+                          : mojom::RunLocation::kDocumentIdle,
+      ScriptExecutor::DEFAULT_PROCESS, /*webview_src=*/GURL(),
+      base::BindOnce(&ScriptingExecuteScriptFunction::OnExecuted, this));
+}
+
+// Comme //chrome : les cadres en erreur sont omis, sauf si un seul cadre
+// était visé.
+void ScriptingExecuteScriptFunction::OnExecuted(
+    std::vector<ScriptExecutor::FrameResult> results) {
+  if (results.size() == 1 && !results[0].error.empty()) {
+    Respond(Error(results[0].error));
+    return;
+  }
+  std::vector<scripting_api::InjectionResult> out;
+  for (ScriptExecutor::FrameResult& result : results) {
+    if (!result.error.empty())
+      continue;
+    scripting_api::InjectionResult item;
+    item.frame_id = result.frame_id;
+    item.result = std::move(result.value);
+    out.push_back(std::move(item));
+  }
+  Respond(ArgumentList(scripting_api::ExecuteScript::Results::Create(out)));
+}
+
+ScriptingCSSFunction::~ScriptingCSSFunction() = default;
+
+ExtensionFunction::ResponseAction ScriptingCSSFunction::RunCSS(
+    mojom::CSSInjection::Operation operation) {
+  // insertCSS et removeCSS prennent les mêmes arguments (CSSInjection).
+  auto params = scripting_api::InsertCSS::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  const scripting_api::CSSInjection& injection = params->injection;
+  if (!injection.css)
+    return RespondNow(Error("Rhénium : seul 'css' est pris en charge."));
+  content::WebContents* web_contents =
+      rhenium::GetTabWebContents(injection.target.tab_id);
+  if (!web_contents) {
+    return RespondNow(Error("No tab with id: " +
+                            base::NumberToString(injection.target.tab_id)));
+  }
+
+  ScriptExecutor::FrameScope scope = ScriptExecutor::SPECIFIED_FRAMES;
+  std::set<int> frame_ids;
+  if (injection.target.all_frames.value_or(false)) {
+    scope = ScriptExecutor::INCLUDE_SUB_FRAMES;
+    frame_ids.insert(ExtensionApiFrameIdMap::kTopFrameId);
+  } else if (injection.target.frame_ids) {
+    frame_ids.insert(injection.target.frame_ids->begin(),
+                     injection.target.frame_ids->end());
+  } else {
+    frame_ids.insert(ExtensionApiFrameIdMap::kTopFrameId);
+  }
+
+  // Même clé à l'ajout et au retrait : removeCSS retrouve la feuille ajoutée.
+  const mojom::HostID host_id(mojom::HostID::HostType::kExtensions,
+                              extension()->id());
+  std::vector<mojom::CSSSourcePtr> sources;
+  sources.push_back(mojom::CSSSource::New(
+      *injection.css,
+      ScriptExecutor::GenerateInjectionKey(host_id, GURL(), *injection.css)));
+  executor_ = std::make_unique<ScriptExecutor>(web_contents);
+  executor_->ExecuteScript(
+      host_id,
+      mojom::CodeInjection::NewCss(mojom::CSSInjection::New(
+          std::move(sources),
+          injection.origin == scripting_api::STYLE_ORIGIN_USER
+              ? mojom::CSSOrigin::kUser
+              : mojom::CSSOrigin::kAuthor,
+          operation)),
+      scope, frame_ids, ScriptExecutor::MATCH_ABOUT_BLANK,
+      mojom::RunLocation::kDocumentStart, ScriptExecutor::DEFAULT_PROCESS,
+      /*webview_src=*/GURL(),
+      base::BindOnce(&ScriptingCSSFunction::OnDone, this));
+  return RespondLater();
+}
+
+void ScriptingCSSFunction::OnDone(
+    std::vector<ScriptExecutor::FrameResult> results) {
+  for (const auto& result : results) {
+    if (!result.error.empty()) {
+      Respond(Error(result.error));
+      return;
+    }
+  }
+  Respond(NoArguments());
+}
+
+ExtensionFunction::ResponseAction ScriptingInsertCSSFunction::Run() {
+  return RunCSS(mojom::CSSInjection::Operation::kAdd);
+}
+
+ExtensionFunction::ResponseAction ScriptingRemoveCSSFunction::Run() {
+  return RunCSS(mojom::CSSInjection::Operation::kRemove);
+}
+
+ExtensionFunction::ResponseAction
+ScriptingRegisterContentScriptsFunction::Run() {
+  auto params = scripting_api::RegisterContentScripts::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  ExtensionUserScriptLoader* loader =
+      GetLoader(browser_context(), extension()->id());
+  const std::set<std::string> existing = loader->GetDynamicScriptIDs();
+  std::set<std::string> ids;
+  auto scripts = std::make_unique<UserScriptList>();
+  for (const auto& in : params->scripts) {
+    if (in.id.empty() || in.id[0] == '_') {
+      return RespondNow(
+          Error("Script's ID '" + in.id + "' must not start with '_'"));
+    }
+    if (base::Contains(existing, in.id) || !ids.insert(in.id).second)
+      return RespondNow(Error("Duplicate script ID '" + in.id + "'"));
+    std::u16string error;
+    std::unique_ptr<UserScript> script =
+        ToUserScript(*extension(), in, &error);
+    if (!script)
+      return RespondNow(Error(base::UTF16ToUTF8(error)));
+    scripts->push_back(std::move(script));
+  }
+  loader->AddPendingDynamicScriptIDs(ids);
+  loader->AddDynamicScripts(
+      std::move(scripts), /*persistent_script_ids=*/{},
+      base::BindOnce(&ScriptingRegisterContentScriptsFunction::OnDone, this));
+  return RespondLater();
+}
+
+void ScriptingRegisterContentScriptsFunction::OnDone(
+    const absl::optional<std::string>& error) {
+  Respond(error ? Error(*error) : NoArguments());
+}
+
+ExtensionFunction::ResponseAction
+ScriptingGetRegisteredContentScriptsFunction::Run() {
+  auto params =
+      scripting_api::GetRegisteredContentScripts::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  const std::vector<std::string>* filter =
+      params->filter ? base::OptionalToPtr(params->filter->ids) : nullptr;
+  std::vector<scripting_api::RegisteredContentScript> result;
+  for (const auto& script :
+       GetLoader(browser_context(), extension()->id())
+           ->GetLoadedDynamicScripts()) {
+    if (filter && !base::Contains(*filter, script->id()))
+      continue;
+    result.push_back(FromUserScript(*script));
+  }
+  return RespondNow(ArgumentList(
+      scripting_api::GetRegisteredContentScripts::Results::Create(result)));
+}
+
+ExtensionFunction::ResponseAction
+ScriptingUnregisterContentScriptsFunction::Run() {
+  auto params = scripting_api::UnregisterContentScripts::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  ExtensionUserScriptLoader* loader =
+      GetLoader(browser_context(), extension()->id());
+  const std::set<std::string> existing = loader->GetDynamicScriptIDs();
+  std::set<std::string> ids;
+  if (params->filter && params->filter->ids) {
+    for (const std::string& id : *params->filter->ids) {
+      if (!base::Contains(existing, id))
+        return RespondNow(Error("Nonexistent script ID '" + id + "'"));
+      ids.insert(id);
+    }
+  } else {
+    ids = existing;
+  }
+  loader->RemoveDynamicScripts(
+      ids,
+      base::BindOnce(&ScriptingUnregisterContentScriptsFunction::OnDone, this));
+  return RespondLater();
+}
+
+void ScriptingUnregisterContentScriptsFunction::OnDone(
+    const absl::optional<std::string>& error) {
+  Respond(error ? Error(*error) : NoArguments());
+}
+
+}  // namespace extensions
