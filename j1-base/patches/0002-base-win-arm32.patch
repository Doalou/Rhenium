+// found in the LICENSE file.
+
+#ifndef BASE_MESSAGE_LOOP_MESSAGE_PUMP_UWP_H_
+#define BASE_MESSAGE_LOOP_MESSAGE_PUMP_UWP_H_
+
+#include <windows.h>
+
+#include <memory>
+#include <vector>
+
+#include "base/base_export.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/message_loop/message_pump.h"
+#include "base/threading/thread_checker.h"
+#include "base/time/time.h"
+
+namespace base {
+
+class RunLoop;
+
+// Rhénium : pompe du thread UI d'une app UWP, sans fenêtre HWND (Windows 10
+// Mobile n'a pas les fonctions de fenêtres de user32). Le travail est posté
+// sur le CoreDispatcher du thread (RunAsync), le travail différé passe par un
+// ThreadPoolTimer qui repasse par le CoreDispatcher.
+//
+// Comme sur Android, la boucle du thread appartient au système (XAML ou
+// CoreApplication) : à la liaison d'un SingleThreadTaskExecutor de type UI, la
+// pompe s'attache (Attach) au lieu d'être lancée par Run(). Run() reste
+// possible pour un RunLoop imbriqué : il appelle CoreDispatcher::ProcessEvents
+// jusqu'à Quit().
+//
+// Sur un thread sans CoreWindow (thread de travail de type UI, tests), elle
+// délègue tout à une MessagePumpDefault.
+class BASE_EXPORT MessagePumpForUI : public MessagePump {
+ public:
+  // Inutilisé sous UWP (pas de MSG), gardé pour CurrentUIThread.
+  class BASE_EXPORT Observer {
+   public:
+    virtual void WillDispatchMSG(const MSG& msg) = 0;
+    virtual void DidDispatchMSG(const MSG& msg) = 0;
+  };
+
+  MessagePumpForUI();
+  MessagePumpForUI(const MessagePumpForUI&) = delete;
+  MessagePumpForUI& operator=(const MessagePumpForUI&) = delete;
+  ~MessagePumpForUI() override;
+
+  // MessagePump :
+  void Run(Delegate* delegate) override;
+  void Quit() override;
+  void ScheduleWork() override;
+  void ScheduleDelayedWork(
+      const Delegate::NextWorkInfo& next_work_info) override;
+
+  // Branche la pompe sur la boucle du système sans la lancer.
+  void Attach(Delegate* delegate);
+
+  void AddObserver(Observer* observer) {}
+  void RemoveObserver(Observer* observer) {}
+
+  // Résultat du dernier CoreDispatcher::ProcessEvents (S_OK s'il n'y en a pas
+  // eu), pour le diagnostic.
+  HRESULT last_process_events_result() const {
+    return last_process_events_result_;
+  }
+
+ private:
+  class Core;
+
+  struct RunState {
+    bool should_quit = false;
+  };
+
+  // Appelés sur le thread UI, depuis le CoreDispatcher.
+  void HandleWork();
+  void HandleTimer(int timer_generation);
+
+  void CancelTimer();
+
+  THREAD_CHECKER(thread_checker_);
+  std::unique_ptr<MessagePump> fallback_;  // thread sans CoreWindow
+  scoped_refptr<Core> core_;
+  raw_ptr<Delegate> delegate_ = nullptr;
+  std::vector<RunState*> run_states_;
+  std::unique_ptr<RunLoop> attached_run_loop_;
+  bool attached_quit_ = false;
+  TimeTicks timer_run_time_;
+  int timer_generation_ = 0;
+  HRESULT last_process_events_result_ = S_OK;
+};
+
+}  // namespace base
+
+#endif  // BASE_MESSAGE_LOOP_MESSAGE_PUMP_UWP_H_
