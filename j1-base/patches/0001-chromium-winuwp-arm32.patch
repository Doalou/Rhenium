diff --git a/build/toolchain/win/setup_toolchain.py b/build/toolchain/win/setup_toolchain.py
index d2f5798ce6..97df0f8c07 100644
--- a/build/toolchain/win/setup_toolchain.py
+++ b/build/toolchain/win/setup_toolchain.py
@@ -101,6 +101,46 @@ def _LoadEnvFromBat(args):
   return variables.decode(errors='ignore')
 
 
+def _RheniumToolchainEnv(cpu):
+  """Rhénium : environnement construit sans vcvarsall.bat.
+
+  Le vcvarsall de VS 2026 ne sait plus cibler ARM32, et le SDK 22621 attendu
+  plus haut n'a pas les bibliothèques ARM32. On pointe directement sur le
+  toolset MSVC 14.44 (RHENIUM_MSVC_DIR) et le Windows SDK 10.0.19041
+  (RHENIUM_WINSDK_DIR, RHENIUM_WINSDK_VERSION)."""
+  msvc = os.environ['RHENIUM_MSVC_DIR']
+  kits = os.environ.get('RHENIUM_WINSDK_DIR',
+                        r'C:\Program Files (x86)\Windows Kits\10')
+  ver = os.environ.get('RHENIUM_WINSDK_VERSION', '10.0.19041.0')
+  inc = os.path.join(kits, 'Include', ver)
+  lib = os.path.join(kits, 'Lib', ver)
+  cpu_dir = {'x86': 'x86', 'x64': 'x64', 'arm': 'arm', 'arm64': 'arm64'}[cpu]
+  env = {
+      'INCLUDE': ';'.join([os.path.join(msvc, 'include')] +
+                          [os.path.join(inc, d) for d in
+                           ('ucrt', 'um', 'shared', 'winrt', 'cppwinrt')]),
+      'LIB': ';'.join([os.path.join(msvc, 'lib', cpu_dir),
+                       os.path.join(lib, 'ucrt', cpu_dir),
+                       os.path.join(lib, 'um', cpu_dir)]),
+      'LIBPATH': os.path.join(msvc, 'lib', cpu_dir),
+      'PATH': os.pathsep.join([os.path.join(msvc, 'bin', 'Hostx64', cpu_dir),
+                               os.path.join(msvc, 'bin', 'Hostx64', 'x64'),
+                               os.path.join(kits, 'bin', ver, 'x64'),
+                               os.environ['PATH']]),
+  }
+  # ATL (accessibilité Windows, synthèse vocale, module ATL de content), si
+  # le composant est installé pour cette architecture (RHENIUM_ATL_DIR).
+  atl = os.environ.get('RHENIUM_ATL_DIR', os.path.join(msvc, 'atlmfc'))
+  atl_lib = os.path.join(atl, 'lib', cpu_dir)
+  if os.path.isdir(atl_lib):
+    env['INCLUDE'] += ';' + os.path.join(atl, 'include')
+    env['LIB'] += ';' + atl_lib
+  for name in ('SYSTEMROOT', 'TEMP', 'TMP', 'PATHEXT', 'USERPROFILE'):
+    if name in os.environ:
+      env[name] = os.environ[name]
+  return env
+
+
 def _LoadToolchainEnv(cpu, toolchain_root, sdk_dir, target_store):
   """Returns a dictionary with environment variables that must be set while
   running binaries from the toolchain (e.g. INCLUDE and PATH for cl.exe)."""
